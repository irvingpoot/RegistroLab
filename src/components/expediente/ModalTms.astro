---
/**
 * @component ModalTms
 * @description Modal "Bitácora Técnica TMS" (`#modal-tms`): formulario de nueva sesión + historial.
 * Se abre con `data-abrir-modal="modal-tms"` (ver SeccionTms.astro).
 *
 * PROPS:
 * @prop {string} nombrePaciente - Nombre mostrado en el encabezado.
 * @prop {object[]} sesiones     - `tms_sesiones` (más reciente primero).
 * @prop {object} [ultimaConfig] - Última sesión, para prellenar el formulario.
 */
import ModalDialog from "./ModalDialog.astro";
import TmsSesionForm from "./TmsSesionForm.astro";
import TmsHistorial from "./TmsHistorial.astro";

interface Props {
    nombrePaciente: string;
    sesiones: any[];
    ultimaConfig?: Record<string, any>;
}

const { nombrePaciente, sesiones, ultimaConfig = {} } = Astro.props;
---

<ModalDialog
    id="modal-tms"
    bare
    class="m-auto bg-transparent p-0 backdrop:bg-black/80 backdrop:backdrop-blur-sm w-full max-w-5xl"
>
    <div class="bg-[#0f172a] border border-white/10 rounded-3xl shadow-2xl overflow-hidden m-4 max-h-[90vh] flex flex-col">
        <div class="p-6 border-b border-white/10 bg-slate-900/50 flex justify-between items-center sticky top-0 z-20">
            <div>
                <h3 class="text-xl font-bold text-white flex items-center gap-2">
                    <span class="w-2 h-6 bg-blue-500 rounded-full"></span>
                    Bitácora Técnica TMS
                </h3>
                <p class="text-sm text-gray-400">Paciente: <span class="text-white font-medium">{nombrePaciente}</span></p>
            </div>
            <button type="button" data-cerrar-modal class="p-2 text-gray-400 hover:text-white rounded-full bg-white/5 hover:bg-white/10 transition-colors cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>

        <div class="p-6 overflow-y-auto custom-scrollbar flex-1 space-y-8">
            <TmsSesionForm ultimaConfig={ultimaConfig} />
            <TmsHistorial sesiones={sesiones} />
        </div>
    </div>
</ModalDialog>
