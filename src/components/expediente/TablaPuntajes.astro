---
/**
 * @component TablaPuntajes
 * @description Tabla de solo lectura de puntajes Pre / Inter / Post, más los puntajes extra.
 *
 * PROPS:
 * @prop {object} paciente   - Registro con columnas `<escala>_pre|inter|post`.
 * @prop {string[]} escalas  - Claves de escala (ej. ESCALAS_SUENO).
 * @prop {object[]} [extras] - `pacientes_puntajes_extra`.
 * @prop {Record<string,string>} [etiquetas] - Nombres personalizados por escala; si falta,
 *   se muestra la clave en MAYÚSCULAS sin guiones bajos.
 */
import { columnaPuntaje, nombreEscala } from "../../data/escalas-sueno";

interface Props {
    paciente: Record<string, any>;
    escalas: readonly string[];
    extras?: any[] | null;
    etiquetas?: Record<string, string>;
}

const { paciente, escalas, extras, etiquetas } = Astro.props;
const claseEtiqueta = etiquetas ? "capitalize" : "uppercase";
---

<div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
        <thead>
            <tr class="text-gray-500 text-xs uppercase border-b border-gray-700/50">
                <th class="pb-2 font-medium">Prueba</th>
                <th class="pb-2 text-center text-blue-400">Pre</th>
                <th class="pb-2 text-center text-purple-400">Inter</th>
                <th class="pb-2 text-center text-emerald-400">Post</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-800">
            {escalas.map((escala) => (
                <tr>
                    <td class={`py-2 pr-4 font-medium text-gray-300 ${claseEtiqueta}`}>{etiquetas?.[escala] ?? nombreEscala(escala)}</td>
                    <td class="py-2 text-center font-mono text-blue-200">{paciente[columnaPuntaje(escala, "pre")] ?? "-"}</td>
                    <td class="py-2 text-center font-mono text-purple-200">{paciente[columnaPuntaje(escala, "inter")] ?? "-"}</td>
                    <td class="py-2 text-center font-mono text-emerald-200">{paciente[columnaPuntaje(escala, "post")] ?? "-"}</td>
                </tr>
            ))}
            {extras && extras.map((extra) => (
                <tr class="bg-blue-900/10">
                    <td class="py-2 pr-4 font-medium text-blue-300">{extra.nombre_prueba} <span class="text-[10px] text-gray-500 uppercase">(Extra)</span></td>
                    <td class="py-2 text-center font-mono text-blue-200">{extra.puntaje_pre ?? "-"}</td>
                    <td class="py-2 text-center font-mono text-purple-200">{extra.puntaje_inter ?? "-"}</td>
                    <td class="py-2 text-center font-mono text-emerald-200">{extra.puntaje_post ?? "-"}</td>
                </tr>
            ))}
        </tbody>
    </table>
</div>
