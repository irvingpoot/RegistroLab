---
/**
 * @component BotonExpandirTexto
 * @description Botón "Ampliar" para leer un texto largo en el modal de lectura. Colocarlo dentro
 * de un contenedor `relative`; se ubica en la esquina superior derecha. Requiere que la página
 * incluya `ModalTextoExpandido`.
 *
 * PROPS:
 * @prop {string} objetivo - id del elemento cuyo texto se va a ampliar.
 * @prop {string} titulo   - Título que mostrará el modal.
 */
interface Props {
    objetivo: string;
    titulo: string;
}

const { objetivo, titulo } = Astro.props;
---

<button
    type="button"
    data-texto-expandir={objetivo}
    data-titulo={titulo}
    title="Ampliar para leer"
    aria-label={`Ampliar: ${titulo}`}
    class="absolute top-3 right-3 p-1.5 rounded-lg text-gray-400 hover:text-white bg-gray-900/60 hover:bg-gray-700 border border-gray-700/60 transition-colors cursor-pointer"
>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
    </svg>
</button>