---
/**
 * @component SeccionPuntajes
 * @description Sección "Puntajes": tabla Pre/Inter/Post (+ extras) y botón que abre `#modal-puntajes`
 * (ModalPuntajes). Opcionalmente enlaza al análisis gráfico.
 *
 * PROPS:
 * @prop {object} paciente        - Registro del paciente.
 * @prop {string[]} escalas       - Claves de escala (data/escalas-*.ts).
 * @prop {string} [titulo]        - Título de la tarjeta (default "Puntajes").
 * @prop {string} [textoBoton]    - Texto del botón de edición (default "Gestionar Puntajes").
 * @prop {string} [graficasHref]  - Si se indica, muestra el botón "Ver Análisis Gráfico".
 * @prop {Record<string,string>} [etiquetas] - Nombres personalizados por escala.
 * @prop {string} [encabezado]    - Título de la primera columna de la tabla.
 * @prop {"compacto"|"amplio"} [espaciado] - Alto de las filas de la tabla.
 */
import InfoCard from "../InfoCard.astro";
import TablaPuntajes from "./TablaPuntajes.astro";

interface Props {
    paciente: Record<string, any>;
    escalas: readonly string[];
    titulo?: string;
    textoBoton?: string;
    graficasHref?: string;
    etiquetas?: Record<string, string>;
    encabezado?: string;
    espaciado?: "compacto" | "amplio";
}

const {
    paciente,
    escalas,
    titulo = "Puntajes",
    textoBoton = "Gestionar Puntajes",
    graficasHref,
    etiquetas,
    encabezado,
    espaciado,
} = Astro.props;
---

<section id="puntajes" class="expediente-seccion">
    <InfoCard title={titulo}>
        <div class="flex justify-between items-center mb-6">
            <p class="text-gray-400 text-sm">Resultados de las pruebas aplicadas al paciente.</p>
            <div class="flex gap-2">
                <button type="button" data-abrir-modal="modal-puntajes" class="text-xs bg-blue-600 hover:bg-blue-500 text-white px-3 py-1.5 rounded-lg transition-colors cursor-pointer flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" /></svg>
                    {textoBoton}
                </button>
                {graficasHref && (
                    <a href={graficasHref} class="text-xs bg-blue-600 hover:bg-blue-500 text-white border border-blue-500/30 px-3 py-1.5 rounded-lg transition-colors cursor-pointer flex items-center gap-2">
                        Ver Análisis Gráfico
                    </a>
                )}
            </div>
        </div>

        <TablaPuntajes
            paciente={paciente}
            escalas={escalas}
            extras={paciente.pacientes_puntajes_extra}
            etiquetas={etiquetas}
            encabezado={encabezado}
            espaciado={espaciado}
        />
    </InfoCard>
</section>
