---
/**
 * @component SeccionPuntajesSueno
 * @description Puntajes del paciente de sueño: usa la sección genérica con las escalas de sueño
 * y el acceso al análisis gráfico.
 */
import SeccionPuntajes from "../SeccionPuntajes.astro";
import { ESCALAS_SUENO } from "../../../data/escalas-sueno";

interface Props {
    paciente: Record<string, any>;
}

const { paciente } = Astro.props;
---

<SeccionPuntajes
    paciente={paciente}
    escalas={ESCALAS_SUENO}
    titulo="Puntajes"
    textoBoton="Gestionar Puntajes"
    graficasHref={`/paciente/sueno/${paciente.id}/graficas`}
/>
