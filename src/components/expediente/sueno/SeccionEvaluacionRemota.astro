---
/**
 * @component SeccionEvaluacionRemota
 * @description "Enlaces de evaluación remota": selector de fase, enlaces/respuestas de los 4
 * cuestionarios y plantilla de WhatsApp. Incluye sus modales (copiar mensaje, ver respuestas y
 * PSQI de estudio). Toda la interacción está en utils/client/evaluacion-remota.ts.
 *
 * PROPS:
 * @prop {object} paciente - { id, token_cuestionarios, respuestas_cuestionarios }. Las respuestas llegan
 *   como resumen (sin el JSON `datos`); el detalle se pide al servidor al pulsar "Ver respuestas".
 * @prop {string} autor    - Nombre de quien envía el mensaje (para la plantilla).
 */
import InfoCard from "../../InfoCard.astro";
import EvaluacionRow from "./EvaluacionRow.astro";
import ModalCopiarFormularios from "./ModalCopiarFormularios.astro";
import ModalVerRespuestas from "./ModalVerRespuestas.astro";
import ModalPsqiEstudio from "./ModalPsqiEstudio.astro";
import { CUESTIONARIOS, urlCuestionario } from "../../../data/cuestionarios";
import { BTN_FASE_ACTIVO, BTN_FASE_INACTIVO, FASES, FASES_PUNTAJE, FASE_DEFAULT } from "../../../data/fases";
import { buildMensajeWhatsApp } from "../../../utils/whatsapp";
import type { RespuestaResumen } from "../../../services/expediente-sueno.service";

interface Props {
    paciente: {
        id: number;
        token_cuestionarios: string;
        respuestas_cuestionarios?: RespuestaResumen[] | null;
    };
    autor: string;
}

const { paciente, autor } = Astro.props;

const baseUrl = Astro.url.origin;
const token = paciente.token_cuestionarios;
const respuestas = paciente.respuestas_cuestionarios ?? [];

const mensajeInicial = buildMensajeWhatsApp({ autor, baseUrl, token, fase: FASE_DEFAULT });
const yaRespondio = (cuestionario: string) =>
    respuestas.some((r) => r.cuestionario === cuestionario && r.fase === FASE_DEFAULT);

const datosJson = JSON.stringify({ baseUrl, token, autor, pacienteId: paciente.id, respuestas }).replace(/</g, "\\u003c");
---

<script is:inline type="application/json" id="evaluacion-data" set:html={datosJson} />

<section id="evaluacion" class="expediente-seccion">
    <InfoCard title="Enlaces de evaluación remota">
        <div class="flex flex-col justify-between items-start gap-6 md:flex-row">
            <div class="mb-6">
                <p class="text-sm text-gray-400 mt-1">1. Selecciona la fase del tratamiento.</p>
                <p class="text-sm text-gray-400">2. Copia el enlace del cuestionario específico que deseas enviar.</p>
            </div>

            <div class="mb-6">
                <button type="button" data-abrir-modal="modal-copy-forms" class="text-xs bg-green-600/20 text-green-400 hover:bg-green-600 hover:text-white border border-green-600/50 px-3 py-1.5 rounded-lg transition-all flex items-center gap-2 cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.305-.883-.653-1.48-1.459-1.653-1.756-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
                    Copiar mensaje para el paciente
                </button>
            </div>
        </div>

        <div class="flex gap-2 p-1 bg-gray-800 rounded-lg w-fit mb-6">
            {FASES_PUNTAJE.map((fase) => (
                <button type="button" data-eval-fase={fase} id={`btn-${fase}`} class={fase === FASE_DEFAULT ? BTN_FASE_ACTIVO : BTN_FASE_INACTIVO}>
                    {FASES[fase].label}
                </button>
            ))}
        </div>

        <div class="grid gap-3">
            {CUESTIONARIOS.map((cuestionario) => (
                <EvaluacionRow
                    cuestionario={cuestionario}
                    url={urlCuestionario(baseUrl, cuestionario, token, FASE_DEFAULT)}
                    respondido={yaRespondio(cuestionario)}
                />
            ))}
        </div>
    </InfoCard>
</section>

<ModalCopiarFormularios mensaje={mensajeInicial} />
<ModalVerRespuestas />
<ModalPsqiEstudio />

<script>
    import "../../../utils/client/evaluacion-remota";
</script>