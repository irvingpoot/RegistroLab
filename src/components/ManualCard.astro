---
import ManualTipoIcon from './icons/ManualIcons/ManualTipoIcon.astro';
import { TIPOS, estiloAcento, resolverTipo, type TipoManual } from '../lib/manual-tipos';

interface Props {
    titulo: string;
    descripcion: string;
    url: string;
    tipo?: TipoManual;
    delay?: number;
}

const { titulo, descripcion, url, tipo: tipoProp = "WEB", delay = 0 } = Astro.props;

const tipo = resolverTipo(tipoProp);
const { label } = TIPOS[tipo];

let host = "";
try {
    host = new URL(url).hostname.replace(/^www\./, "");
} catch {
    /* URL inválida: simplemente no se muestra el dominio */
}
---

<a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class="manual-card"
    style={`${estiloAcento(tipo)} --delay: ${Math.min(delay, 480)}ms;`}
>
    <span class="mc-head">
        <span class="mc-chip">
            <ManualTipoIcon tipo={tipo} class="size-6" />
        </span>
        <span class="mc-tipo">{label}</span>
    </span>

    <span class="mc-body">
        <h3 class="mc-title">{titulo}</h3>
        <p class="mc-desc">{descripcion}</p>
    </span>

    <span class="mc-foot">
        {host && <span class="mc-host">{host}</span>}
        <span class="mc-open">
            Abrir
            <svg class="mc-arrow size-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M8 7h9v9" />
            </svg>
            <span class="sr-only">(se abre en una pestaña nueva)</span>
        </span>
    </span>
</a>

<style>
    .manual-card {
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 15rem;
        padding: 1.5rem;
        border-radius: 1rem;
        border: 1px solid rgb(255 255 255 / .1);
        background: rgb(15 23 42 / .4);
        transition: border-color .2s ease, background-color .2s ease;
        animation: card-in .5s ease-out both;
        animation-delay: var(--delay, 0ms);
    }
    .manual-card:hover {
        border-color: rgb(var(--a) / .5);
        background: rgb(var(--a) / .09);
    }
    .manual-card:focus-visible {
        outline: 2px solid rgb(var(--t));
        outline-offset: 2px;
    }

    .mc-head {
        display: flex;
        align-items: center;
        gap: .875rem;
    }
    .mc-chip {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 3rem;
        height: 3rem;
        border-radius: .875rem;
        background: rgb(var(--a) / .16);
        color: rgb(var(--t));
        transition: background-color .2s ease;
    }
    .manual-card:hover .mc-chip {
        background: rgb(var(--a) / .3);
    }
    .mc-tipo {
        font-size: .875rem;
        font-weight: 600;
        color: rgb(var(--t));
    }

    .mc-body {
        display: block;
        flex: 1;
        margin-top: 1.5rem;
    }
    .mc-title {
        font-size: 1.5rem;
        line-height: 1.2;
        letter-spacing: -.01em;
        color: #fff;
        text-wrap: balance;
        transition: color .15s ease;
    }
    .manual-card:hover .mc-title {
        color: rgb(var(--t));
    }
    .mc-desc {
        margin-top: .625rem;
        font-size: .9375rem;
        line-height: 1.6;
        color: #9ca3af;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .mc-foot {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid rgb(255 255 255 / .08);
    }
    .mc-host {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: .75rem;
        color: #6b7280;
    }
    .mc-open {
        display: inline-flex;
        align-items: center;
        gap: .25rem;
        margin-left: auto;
        flex-shrink: 0;
        font-size: .875rem;
        font-weight: 600;
        color: rgb(var(--t));
    }
    .mc-arrow {
        transition: transform .2s ease;
    }
    .manual-card:hover .mc-arrow {
        transform: translate(2px, -2px);
    }

    @keyframes card-in {
        from { opacity: 0; transform: translateY(12px); }
        to   { opacity: 1; transform: none; }
    }
    @media (prefers-reduced-motion: reduce) {
        .manual-card { animation: none; }
        .mc-arrow { transition: none; }
    }
</style>