---
/**
 * @component SeccionFarmacosRegistro
 * @description Sección "Tratamiento Farmacológico" de los formularios de registro. Envía, por cada
 * fila, `farmacos_nombres`, `farmacos_dosis`, `farmacos_motivos`, `farmacos_tiempos` y
 * `farmacos_frecuencias`; en el servidor se leen con `parseFarmacos(formData)` (utils/form-data.ts).
 * Las filas se agregan/quitan con utils/client/farmacos-registro.ts.
 *
 * PROPS:
 * @prop {string} [placeholderMedicamento] - Ejemplo del campo Medicamento.
 * @prop {string} [placeholderMotivo]      - Ejemplo del campo Motivo / Diagnóstico.
 * @prop {FarmacoItem[]} [farmacos] - Filas iniciales (formulario de edición, ver `farmacosDePaciente`).
 *   Si no hay ninguna, se muestra una fila vacía.
 * @prop {"completo"|"suave"|"tenue"} [bordeTitulo] - Línea bajo el título: `border-white` (registro,
 *   default), `border-white/50` o `border-white/20`.
 * @prop {string} [mensajeVacio] - Si se indica y no hay fármacos, en lugar de una fila vacía se muestra
 *   este texto (desaparece al pulsar "Agregar Fármaco").
 * @prop {string} [class] - Clases extra del <section> (ej. "mt-8").
 */
import FarmacoRow from "./FarmacoRow.astro";
import type { FarmacoItem } from "../../utils/farmacos";

interface Props {
    placeholderMedicamento?: string;
    placeholderMotivo?: string;
    farmacos?: FarmacoItem[];
    bordeTitulo?: "completo" | "suave" | "tenue";
    mensajeVacio?: string;
    class?: string;
}

const {
    placeholderMedicamento,
    placeholderMotivo,
    farmacos,
    bordeTitulo = "completo",
    mensajeVacio,
    class: className,
} = Astro.props;

const BORDES = { completo: "border-white", suave: "border-white/50", tenue: "border-white/20" } as const;

const hayFarmacos = !!farmacos && farmacos.length > 0;
const filas: (FarmacoItem | undefined)[] = hayFarmacos ? farmacos! : mensajeVacio ? [] : [undefined];
---

<section class:list={["w-full max-w-4xl px-2 md:px-0", className]}>
    <h2 class={`text-2xl md:text-3xl pb-2 mb-6 border-b ${BORDES[bordeTitulo]} text-center text-gray-200 w-fit mx-auto px-10`}>
        Tratamiento Farmacológico
    </h2>

    <div class="p-6 border border-gray-700/50 rounded-xl bg-gray-800/20">
        <div id="lista-farmacos" class="space-y-4">
            {!hayFarmacos && mensajeVacio && (
                <p data-farmacos-vacio class="text-gray-500 italic text-sm text-center py-4">{mensajeVacio}</p>
            )}
            {filas.map((fila) => (
                <FarmacoRow
                    placeholderMedicamento={placeholderMedicamento}
                    placeholderMotivo={placeholderMotivo}
                    nombre={fila?.nombre}
                    dosis={fila?.dosis}
                    motivo={fila?.motivo}
                    tiempo={fila?.tiempo}
                    frecuencia={fila?.frecuencia}
                />
            ))}
        </div>

        <template data-farmaco-plantilla>
            <FarmacoRow placeholderMedicamento={placeholderMedicamento} placeholderMotivo={placeholderMotivo} />
        </template>

        <div class="flex justify-between mt-4">
            <p class="text-[10px] text-gray-500 text-center">
                Si no consume medicamentos, deje los campos vacíos.
            </p>
            <div class="flex justify-between items-center mb-6">
                <button type="button" id="btn-add-farmaco" data-farmaco-agregar class="text-xs bg-blue-600 hover:bg-blue-500 text-white px-3 py-1.5 rounded-lg flex items-center gap-1 transition-colors cursor-pointer shadow-lg shadow-blue-900/20">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                    Agregar Fármaco
                </button>
            </div>
        </div>
    </div>
</section>

<script>
    import "../../utils/client/farmacos-registro";
</script>