---
/**
 * @file ConfirmModal.astro
 * @description Modal de confirmación genérico. Inclúyelo una vez en la página
 * (o layout) y en cualquier script llama a `window.confirmarAccion(mensaje)`,
 * que regresa una Promise<boolean> — igual que `window.confirm`, pero con la
 * misma estética del resto de la app. No es específico de /horario: puede
 * reusarse en cualquier otra pantalla que necesite confirmar una acción.
 *
 * Comparte el lenguaje visual del dashboard y de AlertModal: panel oscuro tintado
 * con un acento (variables --a / --t, igual que `.acc-*`) y un chip de ícono.
 *
 * Uso:
 *   const ok = await window.confirmarAccion("¿Seguro que quieres continuar?");
 *   if (!ok) return;
 *
 *   // con opciones:
 *   await window.confirmarAccion("¿Eliminar este registro?", {
 *       titulo: "Eliminar registro",  // default según `peligroso`
 *       textoConfirmar: "Eliminar",
 *       textoCancelar: "Cancelar",    // default
 *       peligroso: true, // true (default) = acento rosa/rojo, false = acento azul
 *   });
 */
---

<div
    id="confirm-modal"
    role="alertdialog"
    aria-modal="true"
    aria-labelledby="confirm-modal-titulo"
    aria-describedby="confirm-modal-mensaje"
    class="modal-overlay fixed inset-0 z-[60] hidden items-center justify-center p-4 bg-[#05070d]/75 backdrop-blur-sm"
>
    <div id="confirm-modal-panel" data-tono="peligro" class="modal-panel relative w-full max-w-md p-6 sm:p-7">
        <div class="flex items-start gap-4">
            <span id="confirm-modal-icono" class="modal-chip" aria-hidden="true"></span>

            <div class="min-w-0 flex-1 pt-0.5">
                <h3 id="confirm-modal-titulo" class="text-2xl leading-tight text-white"></h3>
                <p id="confirm-modal-mensaje" class="mt-2 text-[0.9375rem] leading-relaxed text-gray-300"></p>
            </div>
        </div>

        <div class="mt-7 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
            <button
                type="button"
                id="confirm-modal-cancelar"
                class="inline-flex cursor-pointer items-center justify-center rounded-lg border border-white/10 bg-slate-900/50 px-5 py-2.5 text-sm font-medium text-gray-300 transition-colors hover:border-white/25 hover:bg-slate-800 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-400"
            >
                Cancelar
            </button>
            <button
                type="button"
                id="confirm-modal-confirmar"
                class="modal-btn inline-flex cursor-pointer items-center justify-center rounded-lg px-5 py-2.5 text-sm font-semibold transition-colors"
            >
                Confirmar
            </button>
        </div>
    </div>
</div>

<style>
    .modal-panel[data-tono="peligro"] { --a: 244 63 94; --t: 253 164 175; --b: 225 29 72; --bh: 244 63 94;  --on: 255 255 255; }
    .modal-panel[data-tono="neutral"] { --a: 59 130 246; --t: 147 197 253; --b: 37 99 235; --bh: 59 130 246; --on: 255 255 255; }

    .modal-panel {
        border: 1px solid rgb(var(--a) / .3);
        border-radius: 1.25rem;
        background:
            radial-gradient(110% 90% at 0% 0%, rgb(var(--a) / .16), transparent 60%),
            #0f172a;
        box-shadow:
            0 24px 60px -12px rgb(0 0 0 / .75),
            0 0 0 1px rgb(255 255 255 / .02) inset;
    }

    .modal-chip {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 3rem;
        height: 3rem;
        border-radius: 1rem;
        background: rgb(var(--a) / .18);
        color: rgb(var(--t));
        box-shadow: 0 0 0 1px rgb(var(--a) / .25) inset, 0 8px 24px -8px rgb(var(--a) / .55);
    }

    .modal-btn {
        background: rgb(var(--b));
        color: rgb(var(--on));
    }
    .modal-btn:hover { background: rgb(var(--bh)); }
    .modal-btn:focus-visible {
        outline: 2px solid rgb(var(--t));
        outline-offset: 2px;
    }

    @media (prefers-reduced-motion: no-preference) {
        .modal-overlay.flex { animation: modal-fade .18s ease-out; }
        .modal-overlay.flex .modal-panel { animation: modal-pop .26s cubic-bezier(.16, 1, .3, 1); }
        .modal-overlay.flex .modal-chip { animation: chip-pop .4s cubic-bezier(.34, 1.56, .64, 1) .08s backwards; }
    }
    @keyframes modal-fade { from { opacity: 0; } to { opacity: 1; } }
    @keyframes modal-pop {
        from { opacity: 0; transform: translateY(10px) scale(.96); }
        to   { opacity: 1; transform: none; }
    }
    @keyframes chip-pop {
        from { transform: scale(.6); opacity: 0; }
        to   { transform: none; opacity: 1; }
    }
</style>

<script>
    const modal = document.getElementById("confirm-modal")!;
    const panel = document.getElementById("confirm-modal-panel")!;
    const iconoEl = document.getElementById("confirm-modal-icono")!;
    const tituloEl = document.getElementById("confirm-modal-titulo")!;
    const mensajeEl = document.getElementById("confirm-modal-mensaje")!;
    const btnCancelar = document.getElementById("confirm-modal-cancelar") as HTMLButtonElement;
    const btnConfirmar = document.getElementById("confirm-modal-confirmar") as HTMLButtonElement;

    const svg = (contenido: string) =>
        `<svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${contenido}</svg>`;

    const TONOS = {
        peligro: {
            icono: svg('<path d="M10.3 4.2 2.8 17.5A2 2 0 0 0 4.5 20.5h15a2 2 0 0 0 1.7-3L13.7 4.2a2 2 0 0 0-3.4 0Z"/><path d="M12 9.5v4"/><path d="M12 17h.01"/>'),
            titulo: "Confirma antes de continuar",
        },
        neutral: {
            icono: svg('<circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.6 2.2c-.7.4-1.1.9-1.1 1.8"/><path d="M12 17h.01"/>'),
            titulo: "¿Quieres continuar?",
        },
    } as const;

    let resolverActual: ((valor: boolean) => void) | null = null;
    let elementoPrevio: HTMLElement | null = null;

    function cerrar(resultado: boolean) {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        elementoPrevio?.focus?.();
        elementoPrevio = null;
        if (resolverActual) {
            resolverActual(resultado);
            resolverActual = null;
        }
    }

    btnCancelar.addEventListener("click", () => cerrar(false));
    btnConfirmar.addEventListener("click", () => cerrar(true));
    modal.addEventListener("click", (e) => {
        if (e.target === modal) cerrar(false);
    });
    document.addEventListener("keydown", (e) => {
        if (modal.classList.contains("hidden")) return;
        if (e.key === "Escape") cerrar(false);

        if (e.key === "Tab") {
            const primero = btnCancelar;
            const ultimo = btnConfirmar;
            if (e.shiftKey && document.activeElement === primero) {
                e.preventDefault();
                ultimo.focus();
            } else if (!e.shiftKey && document.activeElement === ultimo) {
                e.preventDefault();
                primero.focus();
            }
        }
    });

    declare global {
        interface Window {
            confirmarAccion: (
                mensaje: string,
                opciones?: {
                    titulo?: string;
                    textoConfirmar?: string;
                    textoCancelar?: string;
                    peligroso?: boolean;
                },
            ) => Promise<boolean>;
        }
    }

    window.confirmarAccion = function (mensaje, opciones = {}) {
        if (resolverActual) cerrar(false);

        const peligroso = opciones.peligroso !== false;
        const tipo = peligroso ? "peligro" : "neutral";
        const tono = TONOS[tipo];

        panel.dataset.tono = tipo;
        iconoEl.innerHTML = tono.icono;
        tituloEl.textContent = opciones.titulo || tono.titulo;
        mensajeEl.textContent = mensaje;
        btnConfirmar.textContent = opciones.textoConfirmar || "Confirmar";
        btnCancelar.textContent = opciones.textoCancelar || "Cancelar";

        elementoPrevio = document.activeElement as HTMLElement | null;
        modal.classList.remove("hidden");
        modal.classList.add("flex");

        (peligroso ? btnCancelar : btnConfirmar).focus();

        return new Promise<boolean>((resolve) => {
            resolverActual = resolve;
        });
    };
</script>