---
/**
 * @file ModalMultiplesCitas.astro
 * @description Modal para elegir qué tipo de "múltiples citas" se quiere registrar.
 * Es solo la estructura: cada opción es un enlace a su propia página.
 *
 * Uso:
 *   1. <ModalMultiplesCitas />  (una vez, junto a los demás <dialog> de la página)
 *   2. Cualquier botón lo abre con:
 *        onclick="document.getElementById('modal-multiples').showModal()"
 *
 * Para cambiar los nombres, textos o rutas, edita el arreglo OPCIONES de aquí abajo.
 */

const OPCIONES = [
    {
        titulo: "Citas en serie",
        href: "/multi/citas-sesiones",
        descripcion:
            "Un paciente, un tratamiento y todas sus fechas. Captura los datos una sola vez y marca los días en el calendario.",
        etiquetas: ["Un paciente", "TMS o NFB", "Varias fechas"],
        icono: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-6" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M3 10h18M8 3v4M16 3v4M8 14h2M14 14h2M8 17.5h2M14 17.5h2"/></svg>`,
        clases: {
            tarjeta: "hover:border-blue-500/60 hover:bg-blue-500/5",
            icono: "bg-blue-500/15 text-blue-300",
            flecha: "group-hover:text-blue-300",
            etiqueta: "bg-blue-500/15 text-blue-200",
        },
    },
    {
        titulo: "Citas mixtas",
        href: "/multi/citas-mixtas",
        descripcion:
            "Cada cita con sus propios datos: paciente, servicio, fecha y hora. Agrega varias citas con un click.",
        etiquetas: ["Varios pacientes", "Varios servicios"],
        icono: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-6" aria-hidden="true"><circle cx="9" cy="8" r="3.2"/><path d="M3 19c.5-3.2 3-5 6-5s5.5 1.8 6 5"/><circle cx="17" cy="9" r="2.4"/><path d="M16.5 14.2c2.6.1 4.1 1.6 4.5 4.3"/></svg>`,
        clases: {
            tarjeta: "hover:border-violet-500/60 hover:bg-violet-500/5",
            icono: "bg-violet-500/15 text-violet-300",
            flecha: "group-hover:text-violet-300",
            etiqueta: "bg-violet-500/15 text-violet-200",
        },
    },
];
---

<dialog
    id="modal-multiples"
    aria-labelledby="modal-multiples-titulo"
    aria-describedby="modal-multiples-descripcion"
    class="m-auto bg-gray-900 border border-gray-700 rounded-3xl shadow-2xl w-full max-w-2xl text-left p-0 overflow-y-auto outline-none"
>
    <div class="bg-gray-800/30 p-6 border-b border-gray-700/50 flex items-start justify-between gap-4">
        <div class="min-w-0">
            <h3 id="modal-multiples-titulo" class="text-xl font-extrabold text-white">Múltiples citas</h3>
            <p id="modal-multiples-descripcion" class="mt-1.5 text-sm text-gray-400 leading-relaxed">
                Elige el tipo de registro. La <strong class="font-semibold text-gray-200">citas en serie</strong>
                es para crear las citas de TMS y NFB, y las
                <strong class="font-semibold text-gray-200">citas mixtas</strong> son para crear citas de varios
                servicios y varios pacientes a la vez.
            </p>
        </div>
        <button
            type="button"
            data-cerrar-modal
            aria-label="Cerrar"
            class="flex-shrink-0 text-gray-400 hover:text-white bg-white/5 hover:bg-white/10 p-2 rounded-full transition-colors cursor-pointer"
        >✕</button>
    </div>

    <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-4">
        {OPCIONES.map((o) => (
            <a
                href={o.href}
                class={`group flex flex-col gap-4 rounded-2xl border border-gray-700 bg-gray-950/60 p-5 transition-all duration-200 hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400 ${o.clases.tarjeta}`}
            >
                <div class="flex items-start justify-between gap-3">
                    <span class={`grid size-11 place-items-center rounded-xl ${o.clases.icono}`} set:html={o.icono} />
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class={`size-5 text-gray-500 transition-all duration-200 group-hover:translate-x-0.5 ${o.clases.flecha}`}
                        aria-hidden="true"
                    ><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </div>

                <div>
                    <h4 class="text-lg font-bold text-white">{o.titulo}</h4>
                    <p class="mt-1.5 text-sm text-gray-400 leading-relaxed">{o.descripcion}</p>
                </div>

                <ul class="mt-auto flex flex-wrap gap-2">
                    {o.etiquetas.map((e) => (
                        <li class={`rounded-full px-2.5 py-1 text-xs ${o.clases.etiqueta}`}>{e}</li>
                    ))}
                </ul>
            </a>
        ))}
    </div>
</dialog>

<style>
    dialog::backdrop {
        background: rgba(0, 0, 0, 0.8);
    }
    @media (min-width: 768px) and (hover: hover) {
        dialog::backdrop {
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(8px);
        }
    }
    dialog[open] {
        animation: modalFadeIn 0.2s ease-out;
    }
    @keyframes modalFadeIn {
        from { opacity: 0; transform: scale(0.95); }
        to   { opacity: 1; transform: scale(1); }
    }
    @media (prefers-reduced-motion: reduce) {
        dialog[open] { animation: none; }
    }
</style>

<script>
    const modal = document.getElementById("modal-multiples") as HTMLDialogElement | null;

    if (modal) {
        modal.querySelector("[data-cerrar-modal]")?.addEventListener("click", () => modal.close());
        modal.addEventListener("click", (e) => {
            if (e.target === modal) modal.close();
        });
    }
</script>