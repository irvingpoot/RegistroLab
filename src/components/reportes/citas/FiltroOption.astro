---
import DownloadDocument from '../../icons/reportes/DownloadDocument.astro';

interface Props {
    id: string;
    acento: string;
    titulo: string;
}

const { id, acento, titulo } = Astro.props;
---
<button id={id} type="button" class={`pm-option acc-${acento} group`}>
    <span class="pm-chip pm-chip-lg shrink-0"><slot name="icono" /></span>
    <span class="min-w-0 flex-1">
        <span class="block text-base font-semibold text-white">{titulo}</span>
        <span class="mt-0.5 block text-sm leading-snug text-gray-400"><slot /></span>
    </span>
    <span class="pm-dl"><DownloadDocument class="size-4" /></span>
</button>

<style>
    .pm-option {
        display: flex;
        align-items: center;
        gap: 1rem;
        width: 100%;
        padding: 1.1rem;
        border-radius: 1rem;
        border: 1px solid rgb(var(--a) / .25);
        background: rgb(var(--a) / .07);
        text-align: left;
        cursor: pointer;
        transition: border-color .2s ease, background-color .2s ease;
    }
    .pm-option:hover { border-color: rgb(var(--a) / .55); background: rgb(var(--a) / .12); }
    .pm-option:hover .pm-chip { background: rgb(var(--a)); color: #fff; }
    .pm-option:focus-visible { outline: 2px solid rgb(var(--t)); outline-offset: 2px; }
    .pm-option:disabled { opacity: .5; cursor: not-allowed; }
    .pm-dl {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 9999px;
        border: 1px solid rgb(255 255 255 / .12);
        color: #9ca3af;
        transition: background-color .2s ease, border-color .2s ease, color .2s ease;
    }
    .pm-option:hover .pm-dl { background: rgb(var(--a)); border-color: transparent; color: #fff; }
</style>
