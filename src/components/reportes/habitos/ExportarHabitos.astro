---
/**
 * Reporte "Cama vs Hamaca" (CSV). No tiene modal: al hacer clic en su tarjeta
 * descarga directo, así que este componente solo aporta el comportamiento.
 */
---
<script>
    const boton = document.querySelector<HTMLButtonElement>('[data-id="csv-habitos"]');

    const SPINNER = `
        <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>`;

    function descargarBlob(blob: Blob, nombre: string) {
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = nombre;
        document.body.appendChild(a); a.click();
        URL.revokeObjectURL(url); a.remove();
    }

    boton?.addEventListener('click', async () => {
        const original = boton.innerHTML;
        boton.classList.add('opacity-75', 'cursor-not-allowed');
        boton.disabled = true;
        boton.innerHTML = `
            <div class="flex items-center justify-center gap-2 h-full">
                ${SPINNER}
                <span>Generando...</span>
            </div>`;

        try {
            const response = await fetch('/api/exportar-habitos');
            if (!response.ok) throw new Error('Error en el servidor al generar CSV');

            const fecha = new Date().toISOString().split('T')[0];
            descargarBlob(await response.blob(), `reporte_habitos_${fecha}.csv`);
        } catch (error) {
            console.error(error);
            alert('Hubo un error al generar el reporte.');
        } finally {
            boton.innerHTML = original;
            boton.classList.remove('opacity-75', 'cursor-not-allowed');
            boton.disabled = false;
        }
    });
</script>
