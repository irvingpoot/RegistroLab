---
import DownloadDocument from '../../icons/reportes/DownloadDocument.astro';
import ErrorAlert from '../ErrorAlert.astro';
import RecomendacionItem from './RecomendacionItem.astro';

const fasesEstudio = [
    { value: 'pre',   label: 'Pre-Tratamiento' },
    { value: 'inter', label: 'Intermedio' },
    { value: 'post',  label: 'Post-Tratamiento' },
];

const recomendacionesPoligrafia = [
    { value: 'cpap',        titulo: 'Valoración de CPAP',                  descripcion: 'Ventilación mecánica no invasiva mediante presión positiva continua.' },
    { value: 'orl',         titulo: 'Revisión de Otorrinolaringología',    descripcion: 'Valoración de oclusiones en vía aérea superior y peso corporal saludable.' },
    { value: 'posicion',    titulo: 'Posición lateral al dormir',          descripcion: 'Evitar posición supina para reducir eventos obstructivos.' },
    { value: 'autoinforme', titulo: 'Higiene de sueño y ciclo circadiano', descripcion: 'Psicoeducación y estrategias para mejorar la calidad del sueño.' },
];
---
<div id="paso-2" class="hidden">
    <div class="space-y-6 p-6">

        <div class="pm-patient">
            <div id="paciente-inicial" class="pm-avatar">?</div>
            <div class="min-w-0">
                <p id="paciente-nombre-seleccionado" class="truncate text-base font-semibold text-white">—</p>
                <p id="paciente-edad-seleccionada" class="text-sm text-gray-400">—</p>
            </div>
            <button id="btn-cambiar-paciente" type="button" class="pm-swap">Cambiar</button>
        </div>

        <div>
            <label for="selector-fase-reporte" class="mb-2 block text-sm font-medium text-gray-300">Fase del estudio</label>
            <div class="relative">
                <select id="selector-fase-reporte" class="pm-input pm-input--chevron cursor-pointer appearance-none">
                    {fasesEstudio.map(({ value, label }) => <option value={value}>{label}</option>)}
                </select>
                <svg class="pointer-events-none absolute right-4 top-1/2 size-4 -translate-y-1/2 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" /></svg>
            </div>
        </div>

        <div>
            <div class="mb-3 flex items-baseline justify-between gap-3">
                <p class="text-sm font-medium text-gray-300">Recomendaciones a incluir</p>
                <p class="text-xs text-gray-500">Aparecerán en el reporte</p>
            </div>
            <div class="space-y-2">
                {recomendacionesPoligrafia.map((rec) => <RecomendacionItem {...rec} />)}
            </div>
        </div>

        <ErrorAlert id="error-generacion" />
    </div>

    <div class="pm-foot">
        <button
            id="btn-generar-docx"
            type="button"
            class="flex w-full cursor-pointer items-center justify-center gap-2 rounded-xl bg-indigo-600 px-4 py-3.5 text-sm font-semibold text-white shadow-[0_12px_30px_-10px_rgba(99,102,241,0.8)] transition-all hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-300 disabled:cursor-not-allowed disabled:opacity-50 disabled:shadow-none"
        >
            <DownloadDocument class="size-4" />
            <span id="btn-generar-texto">Generar Word</span>
        </button>
        <p class="mt-3 text-center text-xs text-gray-500">El archivo se descargará automáticamente al terminar.</p>
    </div>
</div>

<style>
    .pm-patient {
        display: flex;
        align-items: center;
        gap: .875rem;
        padding: .875rem;
        border-radius: 1rem;
        border: 1px solid rgb(var(--a) / .3);
        background: rgb(var(--a) / .08);
    }
    .pm-avatar {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 3rem;
        height: 3rem;
        border-radius: .875rem;
        font-size: 1.25rem;
        font-weight: 600;
        color: #fff;
        background: rgb(var(--a));
        box-shadow: 0 10px 24px -10px rgb(var(--a) / .8);
    }
    .pm-swap {
        margin-left: auto;
        padding: .4rem .8rem;
        border-radius: 9999px;
        border: 1px solid rgb(var(--a) / .35);
        font-size: .75rem;
        font-weight: 600;
        color: rgb(var(--t));
        cursor: pointer;
        transition: background-color .15s ease;
    }
    .pm-swap:hover { background: rgb(var(--a) / .15); }

    .pm-foot {
        padding: 1.25rem 1.5rem;
        border-top: 1px solid rgb(255 255 255 / .1);
        background: rgb(0 0 0 / .15);
    }
</style>
