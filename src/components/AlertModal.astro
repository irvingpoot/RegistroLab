---
/**
 * @file AlertModal.astro
 * @description Modal de aviso genérico, hermano de ConfirmModal. Inclúyelo una vez
 * en la página (o layout) y en cualquier script llama a `window.mostrarAlerta(mensaje)`,
 * que regresa una Promise<void> que se resuelve cuando la persona cierra el aviso —
 * igual que `window.alert`, pero con la estética del resto de la app.
 *
 * Comparte el lenguaje visual del dashboard: panel oscuro tintado con un acento
 * (variables --a / --t, igual que `.acc-*`) y un chip de ícono.
 *
 * Uso:
 *   await window.mostrarAlerta("Debes seleccionar al menos una fecha.");
 *
 *   // con opciones:
 *   await window.mostrarAlerta("Espera un momento: se están cargando los precios.", {
 *       titulo: "Cargando precios",   // default según el tipo
 *       tipo: "advertencia",          // "info" (default) | "exito" | "advertencia" | "error"
 *       textoBoton: "Entendido",      // default
 *   });
 */

import CheckIcon from "./icons/CheckIcon.astro";
import ErrorIcon from "./icons/ErrorIcon.astro";
import InfoIcon from "./icons/InfoIcon.astro";
import WarningIcon from "./icons/WarningIcon.astro";
---

<div
    id="alert-modal"
    role="alertdialog"
    aria-modal="true"
    aria-labelledby="alert-modal-titulo"
    aria-describedby="alert-modal-mensaje"
    class="modal-overlay fixed inset-0 z-[60] hidden items-center justify-center p-4 bg-[#05070d]/75 backdrop-blur-sm"
>
    <div id="alert-modal-panel" data-tono="info" class="modal-panel relative w-full max-w-md p-6 sm:p-7">
        <div class="flex items-start gap-4">
            <span class="modal-chip" aria-hidden="true">
                <span data-icono="info" class="contents">
                    <InfoIcon class="size-6" />
                </span>
                <span data-icono="exito" class="hidden">
                    <CheckIcon class="size-6" />
                </span>
                <span data-icono="advertencia" class="hidden">
                    <WarningIcon class="size-6" />
                </span>
                <span data-icono="error" class="hidden">
                    <ErrorIcon class="size-6" />
                </span>
            </span>

            <div class="min-w-0 flex-1 pt-0.5">
                <h3 id="alert-modal-titulo" class="text-2xl leading-tight text-white"></h3>
                <p id="alert-modal-mensaje" class="mt-2 text-[0.9375rem] leading-relaxed text-gray-300"></p>
            </div>
        </div>

        <div class="mt-7 flex justify-end">
            <button
                type="button"
                id="alert-modal-cerrar"
                class="modal-btn inline-flex cursor-pointer items-center justify-center rounded-lg px-5 py-2.5 text-sm font-semibold transition-colors"
            >
                Entendido
            </button>
        </div>
    </div>
</div>

<style>
    .modal-panel[data-tono="info"]        { --a: 59 130 246; --t: 147 197 253; --b: 37 99 235;  --bh: 59 130 246;  --on: 255 255 255; }
    .modal-panel[data-tono="exito"]       { --a: 16 185 129; --t: 110 231 183; --b: 5 150 105;  --bh: 16 185 129;  --on: 255 255 255; }
    .modal-panel[data-tono="advertencia"] { --a: 245 158 11; --t: 252 211 77;  --b: 245 158 11; --bh: 251 191 36;  --on: 28 25 23; }
    .modal-panel[data-tono="error"]       { --a: 244 63 94;  --t: 253 164 175; --b: 225 29 72;  --bh: 244 63 94;   --on: 255 255 255; }

    .modal-panel {
        border: 1px solid rgb(var(--a) / .3);
        border-radius: 1.25rem;
        background:
            radial-gradient(110% 90% at 0% 0%, rgb(var(--a) / .16), transparent 60%),
            #0f172a;
        box-shadow:
            0 24px 60px -12px rgb(0 0 0 / .75),
            0 0 0 1px rgb(255 255 255 / .02) inset;
    }

    .modal-chip {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 3rem;
        height: 3rem;
        border-radius: 1rem;
        background: rgb(var(--a) / .18);
        color: rgb(var(--t));
        box-shadow: 0 0 0 1px rgb(var(--a) / .25) inset, 0 8px 24px -8px rgb(var(--a) / .55);
    }

    .modal-btn {
        background: rgb(var(--b));
        color: rgb(var(--on));
    }
    .modal-btn:hover { background: rgb(var(--bh)); }
    .modal-btn:focus-visible {
        outline: 2px solid rgb(var(--t));
        outline-offset: 2px;
    }

    @media (prefers-reduced-motion: no-preference) {
        .modal-overlay.flex { animation: modal-fade .18s ease-out; }
        .modal-overlay.flex .modal-panel { animation: modal-pop .26s cubic-bezier(.16, 1, .3, 1); }
        .modal-overlay.flex .modal-chip { animation: chip-pop .4s cubic-bezier(.34, 1.56, .64, 1) .08s backwards; }
    }
    @keyframes modal-fade { from { opacity: 0; } to { opacity: 1; } }
    @keyframes modal-pop {
        from { opacity: 0; transform: translateY(10px) scale(.96); }
        to   { opacity: 1; transform: none; }
    }
    @keyframes chip-pop {
        from { transform: scale(.6); opacity: 0; }
        to   { transform: none; opacity: 1; }
    }
</style>

<script>
    const modal = document.getElementById("alert-modal")!;
    const panel = document.getElementById("alert-modal-panel")!;
    const ranurasIcono = modal.querySelectorAll<HTMLElement>("[data-icono]");
    const tituloEl = document.getElementById("alert-modal-titulo")!;
    const mensajeEl = document.getElementById("alert-modal-mensaje")!;
    const btnCerrar = document.getElementById("alert-modal-cerrar") as HTMLButtonElement;

    type TipoAlerta = "info" | "exito" | "advertencia" | "error";

    const TITULOS: Record<TipoAlerta, string> = {
        info: "Aviso",
        exito: "Listo",
        advertencia: "Atención",
        error: "Algo salió mal",
    };

    let resolverActual: (() => void) | null = null;
    let elementoPrevio: HTMLElement | null = null;

    function cerrar() {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        elementoPrevio?.focus?.();
        elementoPrevio = null;
        if (resolverActual) {
            resolverActual();
            resolverActual = null;
        }
    }

    btnCerrar.addEventListener("click", cerrar);
    modal.addEventListener("click", (e) => {
        if (e.target === modal) cerrar();
    });
    document.addEventListener("keydown", (e) => {
        if (modal.classList.contains("hidden")) return;
        if (e.key === "Escape") cerrar();
        if (e.key === "Tab") {
            e.preventDefault();
            btnCerrar.focus();
        }
    });

    declare global {
        interface Window {
            mostrarAlerta: (
                mensaje: string,
                opciones?: { titulo?: string; textoBoton?: string; tipo?: TipoAlerta },
            ) => Promise<void>;
        }
    }

    window.mostrarAlerta = function (mensaje, opciones = {}) {
        if (resolverActual) cerrar();

        const tipo: TipoAlerta = opciones.tipo && opciones.tipo in TITULOS ? opciones.tipo : "info";

        panel.dataset.tono = tipo;
        ranurasIcono.forEach((el) => {
            const activa = el.dataset.icono === tipo;
            el.classList.toggle("hidden", !activa);
            el.classList.toggle("contents", activa);
        });
        tituloEl.textContent = opciones.titulo || TITULOS[tipo];
        mensajeEl.textContent = mensaje;
        btnCerrar.textContent = opciones.textoBoton || "Entendido";

        elementoPrevio = document.activeElement as HTMLElement | null;
        modal.classList.remove("hidden");
        modal.classList.add("flex");
        btnCerrar.focus();

        return new Promise<void>((resolve) => {
            resolverActual = resolve;
        });
    };
</script>