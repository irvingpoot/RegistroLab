---
/**
 * @file AlertModal.astro
 * @description Modal de aviso genérico, hermano de ConfirmModal. Inclúyelo una vez
 * en la página (o layout) y en cualquier script llama a `window.mostrarAlerta(mensaje)`,
 * que regresa una Promise<void> que se resuelve cuando la persona cierra el aviso —
 * igual que `window.alert`, pero con la estética del resto de la app.
 *
 * Uso:
 *   await window.mostrarAlerta("Debes seleccionar al menos una fecha.");
 *
 *   // con opciones:
 *   await window.mostrarAlerta("Espera un momento: se están cargando los precios.", {
 *       titulo: "Cargando precios",
 *       textoBoton: "Entendido", // default
 *   });
 */
---

<div
    id="alert-modal"
    role="alertdialog"
    aria-modal="true"
    aria-labelledby="alert-modal-titulo"
    aria-describedby="alert-modal-mensaje"
    class="fixed inset-0 z-[60] hidden items-center justify-center p-4 bg-black/70 backdrop-blur-sm"
>
    <div class="relative w-full max-w-sm bg-[#0b0f19] border border-white/10 rounded-2xl p-6 shadow-2xl">
        <h3 id="alert-modal-titulo" class="hidden text-white text-xl leading-tight mb-2"></h3>
        <p id="alert-modal-mensaje" class="text-white/90 text-sm mb-6 leading-relaxed"></p>
        <div class="flex justify-end">
            <button
                type="button"
                id="alert-modal-cerrar"
                class="px-4 py-2 rounded-lg bg-cyan-500 hover:bg-cyan-400 text-black font-semibold text-sm cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"
            >
                Entendido
            </button>
        </div>
    </div>
</div>

<script>
    const modal = document.getElementById("alert-modal")!;
    const tituloEl = document.getElementById("alert-modal-titulo")!;
    const mensajeEl = document.getElementById("alert-modal-mensaje")!;
    const btnCerrar = document.getElementById("alert-modal-cerrar") as HTMLButtonElement;

    let resolverActual: (() => void) | null = null;

    function cerrar() {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        if (resolverActual) {
            resolverActual();
            resolverActual = null;
        }
    }

    btnCerrar.addEventListener("click", cerrar);
    modal.addEventListener("click", (e) => {
        if (e.target === modal) cerrar();
    });
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !modal.classList.contains("hidden")) cerrar();
    });

    declare global {
        interface Window {
            mostrarAlerta: (
                mensaje: string,
                opciones?: { titulo?: string; textoBoton?: string },
            ) => Promise<void>;
        }
    }

    window.mostrarAlerta = function (mensaje, opciones = {}) {
        if (resolverActual) cerrar();

        tituloEl.textContent = opciones.titulo ?? "";
        tituloEl.classList.toggle("hidden", !opciones.titulo);
        mensajeEl.textContent = mensaje;
        btnCerrar.textContent = opciones.textoBoton || "Entendido";

        modal.classList.remove("hidden");
        modal.classList.add("flex");
        btnCerrar.focus();

        return new Promise<void>((resolve) => {
            resolverActual = resolve;
        });
    };
</script>