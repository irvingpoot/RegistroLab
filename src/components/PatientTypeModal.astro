---
/**
 * @component PatientTypeModal.astro
 * @description Modal para elegir entre paciente de Sueño o Ánimo antes de registrar
 */

import FaceIcon from "./icons/lista/FaceIcon.astro";
import RightArrow from "./icons/RightArrow.astro";
import SleepIcon from "./icons/lista/SleepIcon.astro";
import AddPatientIcon from "./icons/dashboard/AddPatientIcon.astro";
import CrossIcon from "./icons/CrossIcon.astro";
---

<dialog
    id="modal-tipo-paciente"
    aria-labelledby="titulo-tipo-paciente"
    class="m-auto w-[calc(100%-2rem)] max-w-3xl overflow-x-hidden overflow-y-auto rounded-[1.25rem] border border-white/10 bg-[#0f172a] p-0 text-left shadow-[0_40px_80px_-20px_rgba(0,0,0,0.7)] outline-none"
>
    <div class="flex items-start justify-between gap-4 border-b border-white/10 px-6 py-5 md:px-8">
        <div class="flex items-center gap-4">
            <span class="pt-chip acc-emerald">
                <AddPatientIcon class="size-5" />
            </span>
            <div>
                <h3 id="titulo-tipo-paciente" class="text-xl font-semibold leading-tight tracking-tight text-white">Registrar nuevo paciente</h3>
                <p class="mt-0.5 text-sm text-gray-400">Seleccione el tipo de paciente que desea registrar.</p>
            </div>
        </div>

        <button
            type="button"
            aria-label="Cerrar"
            onclick="document.getElementById('modal-tipo-paciente').close()"
            class="grid size-9 shrink-0 cursor-pointer place-items-center rounded-full text-gray-500 transition-colors hover:bg-white/5 hover:text-white focus-visible:outline-2 focus-visible:outline-blue-400"
        >
            <CrossIcon class="size-5" />
        </button>
    </div>

    <div class="grid grid-cols-1 gap-4 p-6 md:grid-cols-2 md:p-8">

        <a href="/registro/sueno" class="pt-opt acc-blue group">
            <span class="pt-chip pt-chip-lg">
                <SleepIcon class="size-7" />
            </span>
            <span class="mt-6 block text-xl font-semibold tracking-tight text-white">Trastornos del Sueño</span>
            <span class="mt-2 block text-sm leading-relaxed text-gray-400">
                Polisomnografía, insomnio, apnea, titulación CPAP y trastornos del ritmo circadiano.
            </span>
            <span class="pt-cta">
                Seleccionar
                <span class="pt-go inline-flex"><RightArrow class="size-4" /></span>
            </span>
        </a>

        <a href="/registro/animo" class="pt-opt acc-purple group">
            <span class="pt-chip pt-chip-lg">
                <FaceIcon class="size-7" />
            </span>
            <span class="mt-6 block text-xl font-semibold tracking-tight text-white">Estado de Ánimo</span>
            <span class="mt-2 block text-sm leading-relaxed text-gray-400">
                Depresión, ansiedad, evaluación de funciones ejecutivas y protocolos TMS.
            </span>
            <span class="pt-cta">
                Seleccionar
                <span class="pt-go inline-flex"><RightArrow class="size-4" /></span>
            </span>
        </a>

    </div>
</dialog>

<style>
    #modal-tipo-paciente {
        position: fixed;
        inset: 0;
        margin: auto;
    }

    #modal-tipo-paciente::backdrop {
        background: rgba(0, 0, 0, 0.75);
        backdrop-filter: blur(6px);
    }

    #modal-tipo-paciente[open] {
        animation: fade-in-patient-modal 0.3s ease-out;
    }

    @keyframes fade-in-patient-modal {
        from {
            opacity: 0;
            transform: scale(0.95) translateY(10px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        #modal-tipo-paciente[open] { animation: none; }
    }

    .acc-blue    { --a: 59 130 246;  --t: 147 197 253; }
    .acc-purple  { --a: 168 85 247;  --t: 216 180 254; }
    .acc-emerald { --a: 16 185 129;  --t: 110 231 183; }

    .pt-chip {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: .75rem;
        background: rgb(var(--a) / .16);
        color: rgb(var(--t));
        transition: background-color .15s ease, color .15s ease;
    }
    .pt-chip-lg { width: 3.5rem; height: 3.5rem; border-radius: 1rem; }

    .pt-opt {
        display: flex;
        flex-direction: column;
        min-height: 15rem;
        padding: 1.5rem;
        border-radius: 1rem;
        border: 1px solid rgb(var(--a) / .25);
        background: rgb(var(--a) / .08);
        text-align: left;
        text-decoration: none;
        cursor: pointer;
        transition: border-color .2s ease, background-color .2s ease;
    }
    .pt-opt:hover {
        border-color: rgb(var(--a) / .55);
        background: rgb(var(--a) / .12);
    }
    .pt-opt:hover .pt-chip { background: rgb(var(--a)); color: #fff; }
    .pt-opt:focus-visible { outline: 2px solid rgb(var(--t)); outline-offset: 2px; }

    .pt-cta {
        display: inline-flex;
        align-items: center;
        gap: .25rem;
        margin-top: auto;
        padding-top: 1.25rem;
        font-size: .875rem;
        font-weight: 600;
        color: rgb(var(--t));
    }
    .pt-go { transition: transform .2s ease; }
    .pt-opt:hover .pt-go { transform: translateX(4px); }
</style>