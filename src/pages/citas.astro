---

/**
 * @file citas.astro
 * @description Vista de calendario mensual para la gestión de citas.
 * * FUNCIONALIDAD:
 * - Navegación: Permite moverse entre meses usando Query Params (?month=X&year=Y).
 * - Filtrado: Usa `.gte()` y `.lte()` para descargar estrictamente las citas del mes visible.
 * - Renderizado: Genera una cuadrícula de días reales + días de relleno (padding)
 * para alinear correctamente el primer día del mes (Lunes, Martes, etc.).
 * - Interactividad: Usa <dialog> nativo para ver los detalles de las citas de un día.
 *
 * La lógica de acceso a datos vive en: src/services/citas.service.ts
 */

import Layout from "../layouts/Layout.astro"
import CitaCard from "../components/CitaCard.astro"
import ReturnButton from "../components/ReturnButton.astro"
import {
    getCitasDelMes,
    getDiasInhabilesDelMes,
    completarCita,
    cancelarCita,
    reagendarCita,
    toggleDiaInhabil,
    procesarPeriodoInhabil,
    type CitaResumen,
} from "../services/citas.service"
import {
    getEventosDelMes,
    guardarEvento,
    eliminarEvento,
    COLORES_EVENTO,
    COLORES_EVENTO_LISTA,
    type ColorEvento,
} from "../services/eventos.service"
import EventIcon from "../components/icons/citas/EventIcon.astro"
import MultiIcon from "../components/icons/citas/MultiIcon.astro"
import SearchIcon from "../components/icons/SearchIcon.astro"
import UpdateIcon from "../components/icons/citas/UpdateIcon.astro"
import DotsIcon from "../components/icons/citas/DotsIcon.astro"
import LeftTriangle from "../components/icons/LeftTriangle.astro"
import DownTriangle from "../components/icons/DownTriangle.astro"
import RightTriangle from "../components/icons/RightTriangle.astro"
import AddIcon from "../components/icons/AddIcon.astro"
import CheckSimpleIcon from "../components/icons/CheckSimpleIcon.astro"
import AgendaCheckIcon from "../components/icons/citas/AgendaCheckIcon.astro"

const getMeridaDate = () => {
    const d = new Date();
    const formatter = new Intl.DateTimeFormat("en-US", {
        timeZone: "America/Merida",
        year: "numeric", month: "numeric", day: "numeric",
    });
    const parts = formatter.formatToParts(d);
    const year  = parseInt(parts.find(p => p.type === "year")?.value  || "0");
    const month = parseInt(parts.find(p => p.type === "month")?.value || "0") - 1;
    const day   = parseInt(parts.find(p => p.type === "day")?.value   || "0");
    return new Date(year, month, day);
};

const MERIDA_DAY_FORMATTER = new Intl.DateTimeFormat("en-US", {
    timeZone: "America/Merida",
    day: "numeric",
});
const getMeridaDayOfMonth = (fechaISO: string): number =>
    parseInt(MERIDA_DAY_FORMATTER.format(new Date(fechaISO)), 10);

const today        = getMeridaDate();
const paramYear    = parseInt(Astro.url.searchParams.get("year")  ?? "", 10);
const paramMonth   = parseInt(Astro.url.searchParams.get("month") ?? "", 10);
const currentYear  = Number.isInteger(paramYear)  && paramYear  >= 2000 && paramYear  <= 2100 ? paramYear  : today.getFullYear();
const currentMonth = Number.isInteger(paramMonth) && paramMonth >= 0    && paramMonth <= 11   ? paramMonth : today.getMonth();

const monthNames   = ["Enero","Febrero","Marzo","Abril","Mayo","Junio","Julio","Agosto","Septiembre","Octubre","Noviembre","Diciembre"];
const displayMonth = monthNames[currentMonth];

const firstDayOfMonth = new Date(currentYear, currentMonth, 1).getDay();
const daysInMonth     = new Date(currentYear, currentMonth + 1, 0).getDate();
const baseYear        = today.getFullYear();
const yearsRange      = [...new Set([baseYear - 1, baseYear, baseYear + 1, currentYear])].sort((a, b) => a - b);

const prevDate = new Date(currentYear, currentMonth - 1, 1);
const nextDate = new Date(currentYear, currentMonth + 1, 1);
const prevLink = `?month=${prevDate.getMonth()}&year=${prevDate.getFullYear()}`;
const nextLink = `?month=${nextDate.getMonth()}&year=${nextDate.getFullYear()}`;

const user = await Astro.locals.currentUser();
const nombreRegistrador = user
    ? `${user.firstName} ${user.lastName}`.trim() || user.username
    : "Sistema";

if (Astro.request.method === "POST") {
    try {
        const data   = await Astro.request.formData();
        const accion = data.get("accion") as string;
        const citaId = parseInt(data.get("id_cita") as string);

        if (citaId && accion === "completar") {
            await completarCita(citaId);

        } else if (citaId && accion === "cancelar") {
            await cancelarCita(citaId);

        } else if (citaId && accion === "reagendar") {
            const nuevaFecha = data.get("nueva_fecha") as string;
            await reagendarCita(citaId, nuevaFecha, nombreRegistrador as string);

        } else if (accion === "toggle_inhabil") {
            const fecha     = data.get("fecha")      as string;
            const esInhabil = data.get("es_inhabil") === "true";
            await toggleDiaInhabil(fecha, esInhabil);

        } else if (accion === "procesar_periodo") {
            const fechaInicio    = data.get("fecha_inicio")    as string;
            const fechaFin       = data.get("fecha_fin")       as string;
            const tipoOperacion  = data.get("tipo_operacion")  as "bloquear" | "habilitar";
            await procesarPeriodoInhabil(fechaInicio, fechaFin, tipoOperacion);

        } else if (accion === "guardar_evento") {
            const fecha        = data.get("fecha")        as string;
            const horaInicio   = data.get("hora_inicio")  as string;
            const titulo       = data.get("titulo")       as string;
            const descripcion  = (data.get("descripcion") as string) || null;
            const color        = data.get("color")        as ColorEvento;
            const restringeDia = data.get("restringe_dia") === "true";
            await guardarEvento({ fecha, horaInicio, titulo, descripcion, color, restringeDia });

        } else if (accion === "eliminar_evento") {
            const fecha = data.get("fecha") as string;
            await eliminarEvento(fecha);
        }

    } catch (e) {
        console.error("Error procesando acción en citas:", e);
    }

    return Astro.redirect(Astro.url.href);
}

const [citasRaw, diasInhabilesSet, eventosDelMes] = await Promise.all([
    getCitasDelMes(currentYear, currentMonth),
    getDiasInhabilesDelMes(currentYear, currentMonth),
    getEventosDelMes(currentYear, currentMonth),
]);

const citasPorDia = new Map<number, CitaResumen[]>();

citasRaw.forEach(cita => {
    const dia = getMeridaDayOfMonth(cita.fecha_hora);
    if (!citasPorDia.has(dia)) citasPorDia.set(dia, []);
    citasPorDia.get(dia)!.push(cita);
});

const pageDataJson = JSON.stringify({
    mesNombre: displayMonth,
    anio: currentYear,
    mesNumero: currentMonth,
    diasInhabiles: Array.from(diasInhabilesSet),
    eventos: Array.from(eventosDelMes.entries()),
    colores: COLORES_EVENTO,
}).replace(/</g, "\\u003c");
---

<Layout title={`Agenda - ${displayMonth} ${currentYear} | Lab-Somno`}>
	<ReturnButton href="/dashboard" text="Volver al dashboard" />
    <main class="max-w-7xl mx-auto pt-8 pb-20 px-4">
        
        <div class="flex flex-col md:flex-row justify-between items-end mb-8 gap-6 border-b border-white/10 pb-6">
            <div>
                <p class="text-blue-400 font-bold uppercase tracking-wider text-xs mb-1">Agenda Mensual</p>
                <h1 class="text-4xl font-extrabold text-white capitalize">{displayMonth} {currentYear}</h1>
            </div>
            
            <div class="flex items-center gap-4">
                <button onclick="document.getElementById('modal-periodo').showModal()" class="group hidden lg:flex bg-blue-600 hover:bg-red-900 text-white font-medium h-10 pl-[10px] pr-[10px] hover:pr-4 rounded-full items-center justify-center gap-0 hover:gap-2 cursor-pointer transition-all duration-500 flex-shrink-0 overflow-hidden">
                    <EventIcon class="w-5 h-5 flex-shrink-0" />
                    <span class="max-w-0 group-hover:max-w-xs opacity-0 group-hover:opacity-100 overflow-hidden transition-all duration-300 text-sm whitespace-nowrap">Gestionar días inhabiles</span>
                </button>
                <a href="/multiples-citas" class="group hidden lg:flex bg-blue-600 hover:bg-blue-500 text-white font-medium h-10 pl-[10px] pr-[10px] hover:pr-4 rounded-full items-center justify-center gap-0 hover:gap-2 shadow-lg shadow-blue-900/20 transition-all duration-500 flex-shrink-0 overflow-hidden">
                    <MultiIcon class="w-5 h-5 flex-shrink-0" />
                    <span class="max-w-0 group-hover:max-w-xs opacity-0 group-hover:opacity-100 overflow-hidden transition-all duration-300 text-sm whitespace-nowrap">Multiples citas</span>
                </a>
                <a href="gestor" class="group hidden lg:flex bg-blue-600 hover:bg-blue-500 text-white font-medium h-10 pl-[10px] pr-[10px] hover:pr-4 rounded-full items-center justify-center gap-0 hover:gap-2 shadow-lg shadow-blue-900/20 transition-all duration-500 flex-shrink-0 overflow-hidden">
                    <SearchIcon class="w-5 h-5 flex-shrink-0" />
                    <span class="max-w-0 group-hover:max-w-xs opacity-0 group-hover:opacity-100 overflow-hidden transition-all duration-300 text-sm whitespace-nowrap">Gestor de citas</span>
                </a>
                <a href="/citas" class="group hidden lg:flex bg-blue-600 hover:bg-blue-500 text-white font-medium h-10 pl-[10px] pr-[10px] hover:pr-4 rounded-full items-center justify-center gap-0 hover:gap-2 shadow-lg shadow-blue-900/20 transition-all duration-500 flex-shrink-0 overflow-hidden">
                    <UpdateIcon class="w-5 h-5 flex-shrink-0" />
                    <span class="max-w-0 group-hover:max-w-xs opacity-0 group-hover:opacity-100 overflow-hidden transition-all duration-300 text-sm whitespace-nowrap">Actualizar calendario</span>
                </a>

                <div class="lg:hidden relative flex-shrink-0">
                    <details class="group/menu">
                        <summary class="list-none cursor-pointer bg-gray-800/50 border border-gray-700 text-gray-300 hover:text-white hover:bg-white/10 w-10 h-10 rounded-full flex items-center justify-center transition-colors [&::-webkit-details-marker]:hidden">
                            <DotsIcon class="w-5 h-5" />
                        </summary>

                        <div class="absolute left-0 mt-2 w-64 bg-[#0f172a] border border-gray-700 rounded-xl shadow-2xl z-50 overflow-hidden">
                            <button
                                onclick="this.closest('details').open = false; document.getElementById('modal-periodo').showModal()"
                                class="w-full flex items-center gap-3 px-4 py-3 text-sm text-gray-200 hover:bg-white/5 transition-colors text-left"
                            >
                                <EventIcon class="w-5 h-5 text-blue-400 flex-shrink-0" />
                                Gestionar días inhabiles
                            </button>
                            <a href="/multiples-citas" class="flex items-center gap-3 px-4 py-3 text-sm text-gray-200 hover:bg-white/5 transition-colors border-t border-gray-800/50">
                                <MultiIcon class="w-5 h-5 text-blue-400 flex-shrink-0" />
                                Multiples citas
                            </a>
                            <a href="gestor" class="flex items-center gap-3 px-4 py-3 text-sm text-gray-200 hover:bg-white/5 transition-colors border-t border-gray-800/50">
                                <SearchIcon class="w-5 h-5 text-blue-400 flex-shrink-0" />
                                Gestor de citas
                            </a>
                            <a href="/citas" class="flex items-center gap-3 px-4 py-3 text-sm text-gray-200 hover:bg-white/5 transition-colors border-t border-gray-800/50">
                                <UpdateIcon class="w-5 h-5 text-blue-400 flex-shrink-0" />
                                Actualizar calendario
                            </a>
                        </div>
                    </details>
                </div>

                <div class="flex items-center bg-gray-800/50 border border-gray-700 rounded-full p-1 flex-shrink-0">
                    <a href={prevLink} class="w-10 h-10 flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/10 rounded-full transition-colors">
                        <LeftTriangle class="w-5 h-5" />
                    </a>
                    
                    <form action="" method="GET" class="flex items-center gap-1 px-2">
                        <div class="relative group">
                            <select name="month" onchange="this.form.submit()" class="appearance-none bg-transparent text-white font-bold text-sm uppercase tracking-wide cursor-pointer focus:outline-none hover:text-blue-400 transition-colors px-4 py-1">
                                {monthNames.map((m, i) => (
                                    <option value={i} selected={i === currentMonth} class="bg-gray-900 text-gray-300">
                                        {m.substring(0, 3)}
                                    </option>
                                ))}
                            </select>
                            <div class="absolute right-0 top-1/2 -translate-y-1/2 pointer-events-none text-gray-500 group-hover:text-blue-400">
                                <DownTriangle class="w-3 h-3" />
                            </div>
                        </div>

                        <span class="text-gray-600 mr-1">/</span>

                        <div class="relative group">
                            <select name="year" onchange="this.form.submit()" class="appearance-none bg-transparent text-white font-bold text-sm cursor-pointer focus:outline-none hover:text-blue-400 transition-colors px-4 py-1">
                                {yearsRange.map((y) => (
                                    <option value={y} selected={y === currentYear} class="bg-gray-900 text-gray-300">
                                        {y}
                                    </option>
                                ))}
                            </select>
                            <div class="absolute right-0 top-1/2 -translate-y-1/2 pointer-events-none text-gray-500 group-hover:text-blue-400">
                                <DownTriangle class="w-3 h-3" />
                            </div>
                        </div>
                    </form>

                    <a href={nextLink} class="w-10 h-10 flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/10 rounded-full transition-colors">
                        <RightTriangle class="w-5 h-5" />
                    </a>
                </div>

                <a href="/nueva-cita" class="bg-blue-600 hover:bg-blue-500 text-white font-medium w-10 h-10 md:w-auto md:px-4 rounded-full flex items-center justify-center gap-2 shadow-lg shadow-blue-900/20 transition-all hover:scale-105 flex-shrink-0">
                    <AddIcon class="w-5 h-5" />
                    <span class="hidden md:inline text-sm whitespace-nowrap">Agendar nueva cita</span>
                </a>
            </div>
        </div>

        <div class="space-y-4">
            
            <div class="grid grid-cols-7 text-center">
                {["Dom", "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb"].map((day, i) => (
                    <div class={`text-xs font-bold uppercase tracking-widest py-2 ${i === 0 || i === 6 ? 'text-blue-400/70' : 'text-gray-500'}`}>
                        {day}
                    </div>
                ))}
            </div>

            <div id="calendar-grid" class="grid grid-cols-7 gap-2 md:gap-4 auto-rows-[140px]">
                
                {Array.from({ length: firstDayOfMonth }).map(() => (
                    <div class="pointer-events-none"></div>
                ))}

                {Array.from({ length: daysInMonth }).map((_, i) => {
                    const dayNum   = i + 1;
                    const citasDia = citasPorDia.get(dayNum) || [];
                    const isToday  = dayNum === today.getDate() && currentMonth === today.getMonth() && currentYear === today.getFullYear();
                    
                    const m        = String(currentMonth + 1).padStart(2, "0");
                    const d        = String(dayNum).padStart(2, "0");
                    const fechaISO = `${currentYear}-${m}-${d}`;
                    const isInhabil = diasInhabilesSet.has(fechaISO);
                    const evento    = eventosDelMes.get(fechaISO);
                    const eventoColor = evento ? COLORES_EVENTO[evento.color] : null;
                    
                    return (
                        <div 
                            class={`group relative p-3 rounded-2xl border transition-[background-color,border-color,box-shadow,transform] duration-200 cursor-pointer flex flex-col justify-between overflow-hidden
                                ${isInhabil 
                                    ? 'bg-red-900/10 border-red-500/20 shadow-[inset_0_0_20px_rgba(220,38,38,0.05)] hover:border-red-500/40' 
                                    : evento
                                        ? `${eventoColor!.bg} ${eventoColor!.border} ${eventoColor!.hoverBgFuerte}`
                                        : isToday 
                                            ? 'bg-blue-600/20 border-blue-500 shadow-[0_0_20px_rgba(37,99,235,0.2)]' 
                                            : 'bg-white/5 border-white/5 hover:bg-white/10 hover:border-white/20 hover:scale-[1.02] hover:shadow-xl'
                                }
                            `}
                            data-day={dayNum}
                            role="button"
                            tabindex="0"
                        >
                            <div class="flex justify-between items-start z-10">
                                <span class={`text-lg font-bold leading-none ${isInhabil ? 'text-red-400' : evento ? eventoColor!.text : isToday ? 'text-blue-400' : 'text-gray-400 group-hover:text-white'}`}>
                                    {dayNum}
                                </span>

                                {isInhabil && (
                                    <span class="text-[9px] uppercase font-bold text-red-400 tracking-widest border border-red-500/30 px-1.5 rounded-sm">Inhábil</span>
                                )}

                                {evento && (
                                    <span class={`flex items-center gap-1 text-[9px] uppercase font-bold ${eventoColor!.text} tracking-widest border ${eventoColor!.border} px-1.5 rounded-sm max-w-[70%] truncate`}>
                                        <span class={`w-1.5 h-1.5 rounded-full flex-shrink-0 ${eventoColor!.dot}`}></span>
                                        <span class="truncate">{evento.titulo}</span>
                                    </span>
                                )}

                                {!isInhabil && !evento && citasDia.length > 0 && (
                                    <span class="flex items-center justify-center h-5 min-w-[20px] px-1 text-[10px] font-bold bg-white text-gray-900 rounded-full shadow-sm">
                                        {citasDia.length}
                                    </span>
                                )}
                            </div>

                            <div class="space-y-1 mt-2 z-10">
                                {citasDia.slice(0, 2).map((cita) => (
                                    <div class={`flex items-center gap-1.5 text-[10px] rounded px-1.5 py-1 border truncate 
                                        ${isInhabil ? 'bg-red-900/40 border-red-500/10 text-red-300/70' : 'bg-gray-900/40 border-white/5 text-gray-300'}`}>
                                        <div class={`w-1.5 h-1.5 rounded-full flex-shrink-0 ${
                                            cita.estado === 'completada' ? 'bg-emerald-400' : 
                                            cita.estado === 'cancelada'  ? 'bg-red-400'     : 'bg-amber-400'
                                        }`}></div>
                                        <span class="truncate opacity-90">{cita.nombre ? cita.nombre.split(' ')[0] : 'Cita'}</span>
                                    </div>
                                ))}
                                {citasDia.length > 2 && (
                                    <div class="text-[10px] text-center text-gray-500 font-medium group-hover:text-gray-300">+ {citasDia.length - 2} más</div>
                                )}
                            </div>
                            {isToday && !isInhabil && <div class="absolute bottom-0 inset-x-0 h-1 bg-blue-500"></div>}
                        </div>
                    );
                })}
            </div>
        </div>
    </main>

    <div id="citas-store" hidden>
        {Array.from(citasPorDia.entries()).map(([dia, citas]) => (
            <template data-day={dia}>
                <div class="space-y-4">
                    {citas.map((cita) => (
                        <CitaCard cita={cita} />
                    ))}
                </div>
            </template>
        ))}
    </div>

    <dialog id="modal-periodo" class="m-auto bg-gray-900 border border-gray-700 rounded-3xl shadow-2xl w-full max-w-md text-left p-0 overflow-hidden outline-none">
        <div class="relative bg-gray-800/30 p-6 border-b border-gray-700/50 flex justify-between items-center">
            <h3 class="text-xl font-extrabold text-white">Gestionar días inhabiles</h3>
            <button onclick="document.getElementById('modal-periodo').close()" type="button" class="text-gray-400 hover:text-white bg-white/5 hover:bg-white/10 p-2 rounded-full transition-colors">✕</button>
        </div>
        
        <form method="POST" class="p-6 space-y-6">
            <input type="hidden" name="accion" value="procesar_periodo" />
            
            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Acción a realizar</label>
                    
                    <div class="relative group">
                        <select name="tipo_operacion" class="appearance-none w-full bg-gray-950 border border-gray-700 rounded-xl pl-4 pr-10 py-3 text-white focus:outline-none focus:border-blue-500 transition-colors cursor-pointer">
                            <option value="bloquear">Marcar como Inhábil</option>
                            <option value="habilitar">Marcar como Hábil</option>
                        </select>
                        
                        <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-gray-500 group-hover:text-blue-400 transition-colors">
                            <DownTriangle class="w-5 h-5" />
                        </div>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Inicio</label>
                        <input type="date" name="fecha_inicio" required class="w-full bg-gray-950 border border-gray-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-blue-500 transition-colors" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Fin</label>
                        <input type="date" name="fecha_fin" required class="w-full bg-gray-950 border border-gray-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-blue-500 transition-colors" />
                    </div>
                </div>
            </div>

            <div class="flex justify-end gap-3 pt-4 border-t border-gray-800/50">
                <button type="button" onclick="document.getElementById('modal-periodo').close()" class="px-5 py-2.5 rounded-xl text-sm font-bold text-gray-400 hover:text-white hover:bg-white/5 transition-colors">
                    Cancelar
                </button>
                <button type="submit" class="px-5 py-2.5 rounded-xl text-sm font-bold bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-900/20 transition-all hover:scale-105 flex items-center gap-2">
                    <CheckSimpleIcon class="w-4 h-4" />
                    Aplicar Cambios
                </button>
            </div>
        </form>
    </dialog>

    <dialog id="modal-dia" class="m-auto bg-transparent border-0 p-0 outline-none w-full max-w-lg text-left overflow-visible">
        <div id="cartel-evento" class="hidden relative z-0 mx-4 mb-[-1.75rem] rounded-2xl border px-4 pt-3 pb-8 shadow-lg items-start justify-between gap-3">
            <div class="flex items-start gap-3 min-w-0">
                <span id="cartel-evento-dot" class="w-2.5 h-2.5 rounded-full mt-1.5 flex-shrink-0"></span>
                <div class="min-w-0">
                    <p class="flex items-center gap-2 flex-wrap">
                        <span id="cartel-evento-titulo" class="font-extrabold text-white text-sm truncate"></span>
                        <span id="cartel-evento-hora" class="text-[10px] font-bold uppercase tracking-widest opacity-80"></span>
                    </p>
                    <p id="cartel-evento-desc" class="text-xs text-gray-300/80 mt-0.5"></p>
                </div>
            </div>
            <button type="button" data-eliminar-evento class="text-gray-400 hover:text-white hover:bg-white/10 px-2 py-1 rounded-full transition-colors flex-shrink-0 cursor-pointer" title="Quitar evento">✕</button>
        </div>

        <div id="modal-dia-inner" class="relative z-10 rounded-3xl shadow-2xl overflow-hidden max-h-[88vh] flex flex-col transition-colors duration-300 border bg-gray-900 border-gray-700">
            <div id="modal-dia-header" class="relative z-10 flex-shrink-0 p-6 transition-colors duration-300 border-b bg-gray-800/30 border-gray-700/50">
                <div class="relative z-10 flex justify-between items-start">
                    <div>
                        <p class="text-xs text-blue-400 font-bold uppercase tracking-wider mb-1" id="modal-mes-anio"></p>
                        <div class="flex items-center gap-3">
                            <h3 class="text-3xl font-extrabold text-white">Día <span id="modal-dia-num" class="text-blue-400"></span></h3>
                            <span id="badge-inhabil" class="hidden bg-red-900/50 text-red-400 border border-red-500/30 text-[10px] px-2 py-0.5 rounded-full uppercase tracking-wider font-bold">Inhábil</span>
                        </div>
                    </div>
                    <button onclick="document.getElementById('modal-dia').close()" class="text-gray-400 hover:text-white bg-white/5 hover:bg-white/10 p-2 rounded-full transition-colors">✕</button>
                </div>
            </div>

            <div class="relative z-10 overflow-y-auto">
                <div id="modal-evento-centrado" class="hidden px-6 pt-8 pb-10 flex flex-col items-center text-center gap-5">
                    <div id="modal-evento-centrado-icon" class="w-16 h-16 rounded-2xl flex items-center justify-center border">
                        <AgendaCheckIcon class="w-8 h-8" />
                    </div>

                    <div>
                        <p id="modal-evento-centrado-label" class="text-white text-[10px] font-bold uppercase tracking-widest opacity-70 mb-1.5">Evento de todo el día</p>
                        <h4 id="modal-evento-centrado-titulo" class="text-2xl font-extrabold text-white leading-tight"></h4>
                    </div>

                    <span id="modal-evento-centrado-hora" class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-full border"></span>

                    <p id="modal-evento-centrado-desc" class="hidden text-sm text-gray-300 max-w-sm border-t border-white/10 pt-4 mt-1"></p>
                </div>

                <div class="p-6" id="modal-lista-citas"></div>

                <details id="modal-form-evento-wrap" class="transition-colors duration-300 border-t border-gray-800/50">
                    <summary id="btn-toggle-form-evento" class="list-none cursor-pointer px-6 py-3 text-xs font-bold text-gray-400 hover:text-white uppercase tracking-widest flex items-center gap-2 [&::-webkit-details-marker]:hidden">
                <span class="text-lg leading-none">＋</span> <span id="btn-toggle-form-evento-texto">Agregar evento a este día</span>
            </summary>
            <form method="POST" class="px-6 pb-6 space-y-4">
                <input type="hidden" name="accion" value="guardar_evento" />
                <input type="hidden" name="fecha" id="form-evento-fecha" value="" />

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[10px] font-bold text-gray-500 uppercase tracking-wider mb-1">Título</label>
                        <input type="text" name="titulo" id="form-evento-titulo" required maxlength="60" class="w-full bg-gray-950 border border-gray-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-blue-500" />
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-gray-500 uppercase tracking-wider mb-1">Hora inicio</label>
                        <input type="time" name="hora_inicio" id="form-evento-hora" required class="w-full bg-gray-950 border border-gray-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-blue-500" />
                    </div>
                </div>

                <div>
                    <label class="block text-[10px] font-bold text-gray-500 uppercase tracking-wider mb-1">Descripción</label>
                    <textarea name="descripcion" id="form-evento-descripcion" rows="2" maxlength="200" class="w-full bg-gray-950 border border-gray-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-blue-500 resize-none"></textarea>
                </div>

                <div>
                    <label class="block text-[10px] font-bold text-gray-500 uppercase tracking-wider mb-2">Color</label>
                    <div class="flex items-center gap-2">
                        {COLORES_EVENTO_LISTA.map((color, idx) => (
                            <label class="cursor-pointer">
                                <input type="radio" name="color" value={color} class="peer hidden" checked={idx === 0} />
                                <span class={`block w-7 h-7 rounded-full ${COLORES_EVENTO[color].dot} border-2 border-transparent peer-checked:border-white peer-checked:scale-110 transition-all inline-block`}></span>
                            </label>
                        ))}
                    </div>
                </div>

                <label class="flex items-center gap-2 text-xs text-gray-300 cursor-pointer">
                    <input type="checkbox" name="restringe_dia" id="form-evento-restringe" value="true" class="rounded border-gray-700 bg-gray-950 text-blue-500 focus:ring-0" />
                    Este evento ocupa/restringe todo el día
                </label>

                <div class="flex justify-between items-center gap-3">
                    <button type="button" id="btn-eliminar-evento-form" data-eliminar-evento class="hidden text-xs font-bold text-red-400/80 hover:text-red-400 uppercase tracking-widest transition-colors cursor-pointer">
                        Eliminar evento
                    </button>
                    <button type="submit" class="ml-auto px-5 py-2.5 rounded-xl text-sm font-bold cursor-pointer bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-900/20 transition-all hover:scale-105">
                        Guardar evento
                    </button>
                </div>
            </form>
                </details>
            </div>

            <div id="modal-dia-footer" class="relative z-10 flex-shrink-0 p-4 flex justify-center gap-x-3 transition-colors duration-300 border-t bg-gray-950/30 border-gray-800/50">
                <form method="POST" class="m-0">
                    <input type="hidden" name="accion" value="toggle_inhabil" />
                    <input type="hidden" name="fecha" id="modal-fecha-inhabil" value="" />
                    <input type="hidden" name="es_inhabil" id="modal-es-inhabil" value="" />
                    <button type="submit" id="btn-toggle-inhabil" class="text-xs font-bold transition-colors uppercase tracking-widest py-2 flex items-center gap-2"></button>
                </form>
                <a id="btn-agendar-modal" href="/nueva-cita" class="text-xs font-bold text-gray-400 hover:text-blue-400 flex items-center gap-2 transition-colors uppercase tracking-widest py-2">
                    <span class="text-lg leading-none">+</span> Agendar cita
                </a>
            </div>
        </div>

        <form method="POST" id="form-eliminar-evento" class="hidden">
            <input type="hidden" name="accion" value="eliminar_evento" />
            <input type="hidden" name="fecha" id="form-eliminar-evento-fecha" value="" />
        </form>
    </dialog>
</Layout>

<style>
    #modal-lista-citas::-webkit-scrollbar { width: 4px; }
    #modal-lista-citas::-webkit-scrollbar-thumb { background: #374151; border-radius: 4px; }
    
    dialog::backdrop {
        background: rgba(0, 0, 0, 0.8);
    }
    @media (min-width: 768px) and (hover: hover) {
        dialog::backdrop {
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(8px);
        }
    }
    dialog[open] {
        animation: modalFadeIn 0.2s ease-out;
    }
    @keyframes modalFadeIn {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
    }
    @media (prefers-reduced-motion: reduce) {
        dialog[open] { animation: none; }
    }
</style>

<script type="application/json" id="citas-page-data" is:inline set:html={pageDataJson} />

<script>
    interface Paleta {
        bg: string; border: string; borderSuave: string; borderFuerte: string;
        bgFuerte: string; bgBase: string; bgHeader: string; bgFooter: string;
        text: string; dot: string;
    }
    interface Evento {
        titulo: string;
        descripcion?: string | null;
        hora_inicio?: string | null;
        color: string;
        restringe_dia?: boolean | null;
    }
    interface PageData {
        mesNombre: string;
        anio: number;
        mesNumero: number;
        diasInhabiles: string[];
        eventos: [string, Evento][];
        colores: Record<string, Paleta>;
    }

    const CLASES_BASE = {
        modal:  'relative z-10 rounded-3xl shadow-2xl overflow-hidden max-h-[88vh] flex flex-col transition-colors duration-300 border',
        header: 'relative z-10 flex-shrink-0 p-6 transition-colors duration-300 border-b',
        footer: 'relative z-10 flex-shrink-0 p-4 flex justify-center gap-x-3 transition-colors duration-300 border-t',
        form:   'transition-colors duration-300 border-t',
    };

    const ICONO_HABILITAR = `
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
        Habilitar Día
    `;
    const ICONO_BLOQUEAR = `
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636" /></svg>
        Marcar como Inhábil
    `;

    function init() {
        const grid  = document.getElementById('calendar-grid');
        const modal = document.getElementById('modal-dia') as HTMLDialogElement | null;
        if (!grid || !modal || grid.dataset.ready === '1') return;
        grid.dataset.ready = '1';

        const data: PageData = JSON.parse(document.getElementById('citas-page-data')?.textContent || '{}');
        const diasInhabiles   = new Set(data.diasInhabiles);
        const eventosPorFecha = new Map(data.eventos);
        const colores         = data.colores;

        const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

        const el = {
            numDia:        $('modal-dia-num'),
            mesAnio:       $('modal-mes-anio'),
            lista:         $('modal-lista-citas'),
            btnAgendar:    $<HTMLAnchorElement>('btn-agendar-modal'),
            fechaInhabil:  $<HTMLInputElement>('modal-fecha-inhabil'),
            esInhabil:     $<HTMLInputElement>('modal-es-inhabil'),
            cartel:        $('cartel-evento'),
            cartelDot:     $('cartel-evento-dot'),
            cartelTitulo:  $('cartel-evento-titulo'),
            cartelHora:    $('cartel-evento-hora'),
            cartelDesc:    $('cartel-evento-desc'),
            centrado:      $('modal-evento-centrado'),
            centradoIcon:  $('modal-evento-centrado-icon'),
            centradoTit:   $('modal-evento-centrado-titulo'),
            centradoHora:  $('modal-evento-centrado-hora'),
            centradoDesc:  $('modal-evento-centrado-desc'),
            formWrap:      $<HTMLDetailsElement>('modal-form-evento-wrap'),
            formToggleTxt: $('btn-toggle-form-evento-texto'),
            formFecha:     $<HTMLInputElement>('form-evento-fecha'),
            formTitulo:    $<HTMLInputElement>('form-evento-titulo'),
            formHora:      $<HTMLInputElement>('form-evento-hora'),
            formDesc:      $<HTMLTextAreaElement>('form-evento-descripcion'),
            formRestringe: $<HTMLInputElement>('form-evento-restringe'),
            btnEliminar:   $('btn-eliminar-evento-form'),
            elimFecha:     $<HTMLInputElement>('form-eliminar-evento-fecha'),
            elimForm:      $<HTMLFormElement>('form-eliminar-evento'),
            inner:         $('modal-dia-inner'),
            header:        $('modal-dia-header'),
            footer:        $('modal-dia-footer'),
            badgeInhabil:  $('badge-inhabil'),
            btnToggle:     $('btn-toggle-inhabil'),
        };

        const openDayModal = (day: number) => {
            const m = String(data.mesNumero + 1).padStart(2, '0');
            const d = String(day).padStart(2, '0');
            const fechaISO  = `${data.anio}-${m}-${d}`;
            const isInhabil = diasInhabiles.has(fechaISO);
            const evento    = eventosPorFecha.get(fechaISO);

            el.numDia.textContent  = String(day);
            el.mesAnio.textContent = `${data.mesNombre} ${data.anio}`;

            if (isInhabil) {
                el.btnAgendar.classList.add('hidden');
                el.btnAgendar.classList.remove('flex');
            } else {
                el.btnAgendar.classList.remove('hidden');
                el.btnAgendar.classList.add('flex');
                el.btnAgendar.href = `/nueva-cita?fecha=${fechaISO}`;
            }

            el.fechaInhabil.value = fechaISO;
            el.esInhabil.value    = String(isInhabil);
            el.formFecha.value    = fechaISO;
            el.elimFecha.value    = fechaISO;

            if (evento) {
                const paleta    = colores[evento.color] || colores.azul;
                const horaTexto = evento.hora_inicio ? evento.hora_inicio.substring(0, 5) : '';

                el.inner.className    = `${CLASES_BASE.modal} ${paleta.bgBase} ${paleta.borderFuerte}`;
                el.header.className   = `${CLASES_BASE.header} ${paleta.bgHeader} ${paleta.borderSuave}`;
                el.footer.className   = `${CLASES_BASE.footer} ${paleta.bgFooter} ${paleta.borderSuave}`;
                el.formWrap.className = `${CLASES_BASE.form} ${paleta.borderSuave}`;

                el.cartel.className = `relative z-0 mx-4 mb-[-1.75rem] rounded-2xl border px-4 pt-3 pb-8 shadow-lg flex items-start justify-between gap-3 ${paleta.bgFuerte} ${paleta.border}`;
                el.cartelDot.className = `w-2.5 h-2.5 rounded-full mt-1.5 flex-shrink-0 ${paleta.dot}`;
                el.cartelTitulo.textContent = evento.titulo;
                el.cartelHora.textContent   = horaTexto;
                el.cartelHora.className     = `text-[10px] font-bold uppercase tracking-widest opacity-90 ${paleta.text}`;
                el.cartelDesc.textContent   = evento.descripcion || '';

                el.formTitulo.value    = evento.titulo;
                el.formHora.value      = horaTexto;
                el.formDesc.value      = evento.descripcion || '';
                el.formRestringe.checked = !!evento.restringe_dia;
                const radioColor = document.querySelector<HTMLInputElement>(`input[name="color"][value="${evento.color}"]`);
                if (radioColor) radioColor.checked = true;
                el.formToggleTxt.textContent = 'Editar evento de este día';
                el.btnEliminar.classList.remove('hidden');

                if (evento.restringe_dia) {
                    el.cartel.classList.add('hidden');

                    el.centradoIcon.className = `w-16 h-16 rounded-2xl flex items-center justify-center border ${paleta.bgFuerte} ${paleta.border} ${paleta.text}`;
                    el.centradoTit.textContent  = evento.titulo;
                    el.centradoHora.textContent = horaTexto;
                    el.centradoHora.className   = `inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-full border ${paleta.bg} ${paleta.border} ${paleta.text}`;

                    if (evento.descripcion) {
                        el.centradoDesc.textContent = evento.descripcion;
                        el.centradoDesc.classList.remove('hidden');
                    } else {
                        el.centradoDesc.textContent = '';
                        el.centradoDesc.classList.add('hidden');
                    }

                    el.centrado.classList.remove('hidden');
                    el.lista.classList.add('hidden');
                } else {
                    el.cartel.classList.remove('hidden');
                    el.centrado.classList.add('hidden');
                    el.lista.classList.remove('hidden');
                }
            } else {
                el.cartel.classList.add('hidden');
                el.centrado.classList.add('hidden');
                el.lista.classList.remove('hidden');
                el.inner.className    = `${CLASES_BASE.modal} bg-gray-900 border-gray-700`;
                el.header.className   = `${CLASES_BASE.header} bg-gray-800/30 border-gray-700/50`;
                el.footer.className   = `${CLASES_BASE.footer} bg-gray-950/30 border-gray-800/50`;
                el.formWrap.className = `${CLASES_BASE.form} border-gray-800/50`;

                el.formTitulo.value = '';
                el.formHora.value   = '';
                el.formDesc.value   = '';
                el.formRestringe.checked = false;
                const primerColor = document.querySelector<HTMLInputElement>('input[name="color"]');
                if (primerColor) primerColor.checked = true;
                el.formToggleTxt.textContent = 'Agregar evento a este día';
                el.btnEliminar.classList.add('hidden');
            }

            el.formWrap.open = false;

            if (isInhabil) {
                el.badgeInhabil.classList.remove('hidden');
                el.btnToggle.innerHTML = ICONO_HABILITAR;
                el.btnToggle.className = 'text-xs font-bold text-emerald-500 hover:text-emerald-400 transition-colors uppercase tracking-widest py-2 flex items-center gap-1.5';
            } else {
                el.badgeInhabil.classList.add('hidden');
                el.btnToggle.innerHTML = ICONO_BLOQUEAR;
                el.btnToggle.className = 'text-xs font-bold text-gray-400 hover:text-red-400 transition-colors uppercase tracking-widest py-2 flex items-center gap-1.5 cursor-pointer';
            }

            const tpl = document.querySelector<HTMLTemplateElement>(`#citas-store template[data-day="${day}"]`);
            if (tpl) {
                el.lista.replaceChildren(document.importNode(tpl.content, true));
            } else {
                el.lista.innerHTML = `
                    <div class="flex flex-col items-center justify-center py-12 text-gray-500 border-2 border-dashed border-gray-800 rounded-2xl">
                        <p class="font-medium">${isInhabil ? 'Día bloqueado' : 'Sin citas programadas'}</p>
                        <p class="text-xs mt-1 opacity-60">${isInhabil ? 'No se deberían agendar citas' : 'Tiempo libre disponible'}</p>
                    </div>
                `;
            }

            modal.showModal();
        };

        grid.addEventListener('click', (e) => {
            const cell = (e.target as Element).closest<HTMLElement>('[data-day]');
            if (cell) openDayModal(Number(cell.dataset.day));
        });
        grid.addEventListener('keydown', (e) => {
            if (e.key !== 'Enter' && e.key !== ' ') return;
            const cell = (e.target as Element).closest<HTMLElement>('[data-day]');
            if (!cell || cell !== e.target) return;
            e.preventDefault();
            openDayModal(Number(cell.dataset.day));
        });

        modal.addEventListener('close', () => el.lista.replaceChildren());

        modal.addEventListener('click', (e) => {
            if (!(e.target as Element).closest('[data-eliminar-evento]')) return;
            if (confirm('¿Quitar el evento marcado para este día?')) el.elimForm.requestSubmit();
        });

        el.formWrap.addEventListener('toggle', () => {
            if (!el.formWrap.open) return;
            setTimeout(() => {
                el.formWrap.querySelector('form')?.scrollIntoView({ behavior: 'smooth', block: 'end' });
            }, 50);
        });
    }

    init();
    document.addEventListener('astro:page-load', init);
</script>