                {Array.from({ length: daysInMonth }).map((_, i) => {
                    const dayNum   = i + 1;
                    const citasDia = citasPorDia.get(dayNum) || [];
                    const isToday  = dayNum === today.getDate() && currentMonth === today.getMonth() && currentYear === today.getFullYear();
                    
                    const m        = String(currentMonth + 1).padStart(2, "0");
                    const d        = String(dayNum).padStart(2, "0");
                    const fechaISO = `${currentYear}-${m}-${d}`;
                    const isInhabil = diasInhabilesSet.has(fechaISO);
                    const evento    = eventosDelMes.get(fechaISO);
                    const eventoColor = evento ? COLORES_EVENTO[evento.color] : null;
                    
                    return (
                        <div 
                            class={`group relative p-3 rounded-2xl border transition-all duration-300 cursor-pointer flex flex-col justify-between overflow-hidden
                                ${isInhabil 
                                    ? 'bg-red-900/10 border-red-500/20 shadow-[inset_0_0_20px_rgba(220,38,38,0.05)] hover:border-red-500/40' 
                                    : evento
                                        ? `${eventoColor!.bg} ${eventoColor!.border} hover:${eventoColor!.bgFuerte}`
                                        : isToday 
                                            ? 'bg-blue-600/20 border-blue-500 shadow-[0_0_20px_rgba(37,99,235,0.2)]' 
                                            : 'bg-white/5 border-white/5 hover:bg-white/10 hover:border-white/20 hover:scale-[1.02] hover:shadow-xl'
                                }
                            `}
                            onclick={`window.openDayModal(${dayNum})`}
                        >
                            <div class="flex justify-between items-start z-10">
                                <span class={`text-lg font-bold leading-none ${isInhabil ? 'text-red-400' : evento ? eventoColor!.text : isToday ? 'text-blue-400' : 'text-gray-400 group-hover:text-white'}`}>
                                    {dayNum}
                                </span>

                                {isInhabil && (
                                    <span class="text-[9px] uppercase font-bold text-red-400 tracking-widest border border-red-500/30 px-1.5 rounded-sm">Inhábil</span>
                                )}

                                {evento && (
                                    <span class={`flex items-center gap-1 text-[9px] uppercase font-bold ${eventoColor!.text} tracking-widest border ${eventoColor!.border} px-1.5 rounded-sm max-w-[70%] truncate`}>
                                        <span class={`w-1.5 h-1.5 rounded-full flex-shrink-0 ${eventoColor!.dot}`}></span>
                                        <span class="truncate">{evento.titulo}</span>
                                    </span>
                                )}

                                {!isInhabil && !evento && citasDia.length > 0 && (
                                    <span class="flex items-center justify-center h-5 min-w-[20px] px-1 text-[10px] font-bold bg-white text-gray-900 rounded-full shadow-sm">
                                        {citasDia.length}
                                    </span>
                                )}
                            </div>

                            <div class="space-y-1 mt-2 z-10">
                                {citasDia.slice(0, 2).map((cita) => (
                                    <div class={`flex items-center gap-1.5 text-[10px] rounded px-1.5 py-1 backdrop-blur-sm border truncate 
                                        ${isInhabil ? 'bg-red-900/40 border-red-500/10 text-red-300/70' : 'bg-gray-900/40 border-white/5 text-gray-300'}`}>
                                        <div class={`w-1.5 h-1.5 rounded-full flex-shrink-0 ${
                                            cita.estado === 'completada' ? 'bg-emerald-400' : 
                                            cita.estado === 'cancelada'  ? 'bg-red-400'     : 'bg-amber-400'
                                        }`}></div>
                                        <span class="truncate opacity-90">{cita.nombre ? cita.nombre.split(' ')[0] : 'Cita'}</span>
                                    </div>
                                ))}
                                {citasDia.length > 2 && (
                                    <div class="text-[10px] text-center text-gray-500 font-medium group-hover:text-gray-300">+ {citasDia.length - 2} más</div>
                                )}
                            </div>
                            {isToday && !isInhabil && <div class="absolute bottom-0 inset-x-0 h-1 bg-blue-500"></div>}
                        </div>
                    );
                })}
            </div>
        </div>
    </main>

    <div id="citas-store" class="hidden" style="content-visibility: auto;">
        {Array.from(citasPorDia.entries()).map(([dia, citas]) => (
            <div data-day={dia} class="space-y-4">
                {citas.map((cita) => (
                    <CitaCard cita={cita} />
                ))}
            </div>
        ))}
    </div>

    <dialog id="modal-periodo" class="m-auto bg-gray-900 border border-gray-700 rounded-3xl shadow-2xl backdrop:backdrop-blur-xl w-full max-w-md text-left p-0 overflow-hidden outline-none">
        <div class="relative bg-gray-800/30 p-6 border-b border-gray-700/50 flex justify-between items-center">
            <h3 class="text-xl font-extrabold text-white">Gestionar días inhabiles</h3>
            <button onclick="document.getElementById('modal-periodo').close()" type="button" class="text-gray-400 hover:text-white bg-white/5 hover:bg-white/10 p-2 rounded-full transition-colors">✕</button>
        </div>
        
        <form method="POST" class="p-6 space-y-6">
            <input type="hidden" name="accion" value="procesar_periodo" />
            
            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Acción a realizar</label>
                    
                    <div class="relative group">
                        <select name="tipo_operacion" class="appearance-none w-full bg-gray-950 border border-gray-700 rounded-xl pl-4 pr-10 py-3 text-white focus:outline-none focus:border-blue-500 transition-colors cursor-pointer">
                            <option value="bloquear">Marcar como Inhábil</option>
                            <option value="habilitar">Marcar como Hábil</option>
                        </select>
                        
                        <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-gray-500 group-hover:text-blue-400 transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
                                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                            </svg>
                        </div>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Inicio</label>
                        <input type="date" name="fecha_inicio" required class="w-full bg-gray-950 border border-gray-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-blue-500 transition-colors" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Fin</label>
                        <input type="date" name="fecha_fin" required class="w-full bg-gray-950 border border-gray-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-blue-500 transition-colors" />
                    </div>
                </div>
            </div>

            <div class="flex justify-end gap-3 pt-4 border-t border-gray-800/50">
                <button type="button" onclick="document.getElementById('modal-periodo').close()" class="px-5 py-2.5 rounded-xl text-sm font-bold text-gray-400 hover:text-white hover:bg-white/5 transition-colors">
                    Cancelar
                </button>
                <button type="submit" class="px-5 py-2.5 rounded-xl text-sm font-bold bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-900/20 transition-all hover:scale-105 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                    Aplicar Cambios
                </button>
            </div>
        </form>
    </dialog>

    <dialog id="modal-dia" class="m-auto bg-transparent border-0 p-0 outline-none w-full max-w-lg text-left backdrop:backdrop-blur-xl overflow-visible">
        <div id="cartel-evento" class="hidden relative z-0 mx-4 mb-[-1.75rem] rounded-2xl border px-4 pt-3 pb-8 shadow-lg items-start justify-between gap-3">
            <div class="flex items-start gap-3 min-w-0">
                <span id="cartel-evento-dot" class="w-2.5 h-2.5 rounded-full mt-1.5 flex-shrink-0"></span>
                <div class="min-w-0">
                    <p class="flex items-center gap-2 flex-wrap">
                        <span id="cartel-evento-titulo" class="font-extrabold text-white text-sm truncate"></span>
                        <span id="cartel-evento-hora" class="text-[10px] font-bold uppercase tracking-widest opacity-80"></span>
                    </p>
                    <p id="cartel-evento-desc" class="text-xs text-gray-300/80 mt-0.5"></p>
                </div>
            </div>
            <button type="button" onclick="window.eliminarEventoModal()" class="text-gray-400 hover:text-white hover:bg-white/10 px-2 py-1 rounded-full transition-colors flex-shrink-0 cursor-pointer" title="Quitar evento">✕</button>
        </div>

        <div id="modal-dia-inner" class="relative z-10 rounded-3xl shadow-2xl overflow-hidden max-h-[88vh] flex flex-col transition-colors duration-300 border bg-gray-900 border-gray-700">
            <div id="modal-dia-header" class="relative z-10 flex-shrink-0 p-6 transition-colors duration-300 border-b bg-gray-800/30 border-gray-700/50">
                <div class="relative z-10 flex justify-between items-start">
                    <div>
                        <p class="text-xs text-blue-400 font-bold uppercase tracking-wider mb-1" id="modal-mes-anio"></p>
                        <div class="flex items-center gap-3">
                            <h3 class="text-3xl font-extrabold text-white">Día <span id="modal-dia-num" class="text-blue-400"></span></h3>
                            <span id="badge-inhabil" class="hidden bg-red-900/50 text-red-400 border border-red-500/30 text-[10px] px-2 py-0.5 rounded-full uppercase tracking-wider font-bold">Inhábil</span>
                        </div>
                    </div>
                    <button onclick="document.getElementById('modal-dia').close()" class="text-gray-400 hover:text-white bg-white/5 hover:bg-white/10 p-2 rounded-full transition-colors">✕</button>
                </div>
            </div>

            <div class="relative z-10 overflow-y-auto">
                <div id="modal-evento-centrado" class="hidden px-6 pt-8 pb-10 flex flex-col items-center text-center gap-5">
                    <div id="modal-evento-centrado-icon" class="w-16 h-16 rounded-2xl flex items-center justify-center border">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-8 h-8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="m9 15 2 2 4-4" />
                        </svg>
                    </div>

                    <div>
                        <p id="modal-evento-centrado-label" class="text-white text-[10px] font-bold uppercase tracking-widest opacity-70 mb-1.5">Evento de todo el día</p>
                        <h4 id="modal-evento-centrado-titulo" class="text-2xl font-extrabold text-white leading-tight"></h4>
                    </div>

                    <span id="modal-evento-centrado-hora" class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-full border"></span>

                    <p id="modal-evento-centrado-desc" class="hidden text-sm text-gray-300 max-w-sm border-t border-white/10 pt-4 mt-1"></p>
                </div>

                <div class="p-6" id="modal-lista-citas"></div>

                <details id="modal-form-evento-wrap" class="transition-colors duration-300 border-t border-gray-800/50">
                    <summary id="btn-toggle-form-evento" class="list-none cursor-pointer px-6 py-3 text-xs font-bold text-gray-400 hover:text-white uppercase tracking-widest flex items-center gap-2 [&::-webkit-details-marker]:hidden">
                <span class="text-lg leading-none">＋</span> <span id="btn-toggle-form-evento-texto">Agregar evento a este día</span>
            </summary>
            <form method="POST" class="px-6 pb-6 space-y-4">
                <input type="hidden" name="accion" value="guardar_evento" />
                <input type="hidden" name="fecha" id="form-evento-fecha" value="" />

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[10px] font-bold text-gray-500 uppercase tracking-wider mb-1">Título</label>
                        <input type="text" name="titulo" id="form-evento-titulo" required maxlength="60" class="w-full bg-gray-950 border border-gray-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-blue-500" />
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-gray-500 uppercase tracking-wider mb-1">Hora inicio</label>
                        <input type="time" name="hora_inicio" id="form-evento-hora" required class="w-full bg-gray-950 border border-gray-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-blue-500" />
                    </div>
                </div>

                <div>
                    <label class="block text-[10px] font-bold text-gray-500 uppercase tracking-wider mb-1">Descripción</label>
                    <textarea name="descripcion" id="form-evento-descripcion" rows="2" maxlength="200" class="w-full bg-gray-950 border border-gray-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-blue-500 resize-none"></textarea>
                </div>

                <div>
                    <label class="block text-[10px] font-bold text-gray-500 uppercase tracking-wider mb-2">Color</label>
                    <div class="flex items-center gap-2">
                        {COLORES_EVENTO_LISTA.map((color, idx) => (
                            <label class="cursor-pointer">
                                <input type="radio" name="color" value={color} class="peer hidden" checked={idx === 0} />
                                <span class={`block w-7 h-7 rounded-full ${COLORES_EVENTO[color].dot} border-2 border-transparent peer-checked:border-white peer-checked:scale-110 transition-all inline-block`}></span>
                            </label>
                        ))}
                    </div>
                </div>

                <label class="flex items-center gap-2 text-xs text-gray-300 cursor-pointer">
                    <input type="checkbox" name="restringe_dia" id="form-evento-restringe" value="true" class="rounded border-gray-700 bg-gray-950 text-blue-500 focus:ring-0" />
                    Este evento ocupa/restringe todo el día
                </label>

                <div class="flex justify-between items-center gap-3">
                    <button type="button" id="btn-eliminar-evento-form" onclick="window.eliminarEventoModal()" class="hidden text-xs font-bold text-red-400/80 hover:text-red-400 uppercase tracking-widest transition-colors cursor-pointer">
                        Eliminar evento
                    </button>
                    <button type="submit" class="ml-auto px-5 py-2.5 rounded-xl text-sm font-bold cursor-pointer bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-900/20 transition-all hover:scale-105">
                        Guardar evento
                    </button>
                </div>
            </form>
                </details>
            </div>

            <div id="modal-dia-footer" class="relative z-10 flex-shrink-0 p-4 flex justify-center gap-x-3 transition-colors duration-300 border-t bg-gray-950/30 border-gray-800/50">
                <form method="POST" class="m-0">
                    <input type="hidden" name="accion" value="toggle_inhabil" />
                    <input type="hidden" name="fecha" id="modal-fecha-inhabil" value="" />
                    <input type="hidden" name="es_inhabil" id="modal-es-inhabil" value="" />
                    <button type="submit" id="btn-toggle-inhabil" class="text-xs font-bold transition-colors uppercase tracking-widest py-2 flex items-center gap-2"></button>
                </form>
                <a id="btn-agendar-modal" href="/nueva-cita" class="text-xs font-bold text-gray-400 hover:text-blue-400 flex items-center gap-2 transition-colors uppercase tracking-widest py-2">
                    <span class="text-lg leading-none">+</span> Agendar cita
                </a>
            </div>
        </div>

        <form method="POST" id="form-eliminar-evento" class="hidden">
            <input type="hidden" name="accion" value="eliminar_evento" />
            <input type="hidden" name="fecha" id="form-eliminar-evento-fecha" value="" />
        </form>
    </dialog>
</Layout>

<style>
    #modal-lista-citas::-webkit-scrollbar { width: 4px; }
    #modal-lista-citas::-webkit-scrollbar-thumb { background: #374151; border-radius: 4px; }
    
    dialog::backdrop {
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(8px);
    }
    dialog[open] {
        animation: modalFadeIn 0.2s ease-out;
    }
    @keyframes modalFadeIn {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
    }
</style>

<script define:vars={{
    displayMonth,
    currentYear,
    currentMonth,
    diasInhabilesArray: Array.from(diasInhabilesSet),
    eventosArray: Array.from(eventosDelMes.entries()),
    coloresEvento: COLORES_EVENTO,
}}>
    window.mesNombre = displayMonth;
    window.anio = currentYear;
    window.mesNumero = currentMonth;
    window.diasInhabiles = new Set(diasInhabilesArray);
    window.eventosPorFecha = new Map(eventosArray);
    window.coloresEvento = coloresEvento;

    window.openDayModal = (day) => {
        const modal = document.getElementById('modal-dia');
        const listaContainer = document.getElementById('modal-lista-citas');
        const btnAgendar = document.getElementById('btn-agendar-modal');
        
        document.getElementById('modal-dia-num').textContent = day;
        document.getElementById('modal-mes-anio').textContent = `${window.mesNombre} ${window.anio}`;
        
        const m = String(window.mesNumero + 1).padStart(2, '0');
        const d = String(day).padStart(2, '0');
        const fechaISO = `${window.anio}-${m}-${d}`;
        const isInhabil = window.diasInhabiles.has(fechaISO);

        if (btnAgendar) {
            if (isInhabil) {
                btnAgendar.classList.add('hidden');
                btnAgendar.classList.remove('flex');
            } else {
                btnAgendar.classList.remove('hidden');
                btnAgendar.classList.add('flex');
                btnAgendar.href = `/nueva-cita?fecha=${fechaISO}`;
            }
        }
        
        document.getElementById('modal-fecha-inhabil').value = fechaISO;
        document.getElementById('modal-es-inhabil').value = isInhabil;

        const evento = window.eventosPorFecha.get(fechaISO);
        const cartel = document.getElementById('cartel-evento');
        const centrado = document.getElementById('modal-evento-centrado');
        const listaCitas = document.getElementById('modal-lista-citas');
        const formEventoWrap = document.getElementById('modal-form-evento-wrap');
        const btnToggleFormTexto = document.getElementById('btn-toggle-form-evento-texto');
        const modalInner = document.getElementById('modal-dia-inner');
        const modalHeader = document.getElementById('modal-dia-header');
        const modalFooter = document.getElementById('modal-dia-footer');

        document.getElementById('form-evento-fecha').value = fechaISO;
        document.getElementById('form-eliminar-evento-fecha').value = fechaISO;

        const clasesBaseModal  = 'relative z-10 rounded-3xl shadow-2xl overflow-hidden max-h-[88vh] flex flex-col transition-colors duration-300 border';
        const clasesBaseHeader = 'relative z-10 flex-shrink-0 p-6 transition-colors duration-300 border-b';
        const clasesBaseFooter = 'relative z-10 flex-shrink-0 p-4 flex justify-center gap-x-3 transition-colors duration-300 border-t';
        const clasesBaseForm   = 'transition-colors duration-300 border-t';

        if (evento) {
            const paleta = window.coloresEvento[evento.color] || window.coloresEvento.azul;
            const horaTexto = evento.hora_inicio ? evento.hora_inicio.substring(0, 5) : '';

            modalInner.className  = `${clasesBaseModal} ${paleta.bgBase} ${paleta.borderFuerte}`;
            modalHeader.className = `${clasesBaseHeader} ${paleta.bgHeader} ${paleta.borderSuave}`;
            modalFooter.className = `${clasesBaseFooter} ${paleta.bgFooter} ${paleta.borderSuave}`;
            formEventoWrap.className = `${clasesBaseForm} ${paleta.borderSuave}`;

            cartel.className = `relative z-0 mx-4 mb-[-1.75rem] rounded-2xl border px-4 pt-3 pb-8 shadow-lg flex items-start justify-between gap-3 ${paleta.bgFuerte} ${paleta.border}`;
            document.getElementById('cartel-evento-dot').className = `w-2.5 h-2.5 rounded-full mt-1.5 flex-shrink-0 ${paleta.dot}`;
            document.getElementById('cartel-evento-titulo').textContent = evento.titulo;
            document.getElementById('cartel-evento-hora').textContent = horaTexto;
            document.getElementById('cartel-evento-hora').className = `text-[10px] font-bold uppercase tracking-widest opacity-90 ${paleta.text}`;
            document.getElementById('cartel-evento-desc').textContent = evento.descripcion || '';

            document.getElementById('form-evento-titulo').value = evento.titulo;
            document.getElementById('form-evento-hora').value = horaTexto;
            document.getElementById('form-evento-descripcion').value = evento.descripcion || '';
            document.getElementById('form-evento-restringe').checked = !!evento.restringe_dia;
            const radioColor = document.querySelector(`input[name="color"][value="${evento.color}"]`);
            if (radioColor) radioColor.checked = true;
            btnToggleFormTexto.textContent = 'Editar evento de este día';
            document.getElementById('btn-eliminar-evento-form').classList.remove('hidden');

            if (evento.restringe_dia) {
                cartel.classList.add('hidden');

                document.getElementById('modal-evento-centrado-icon').className = `w-16 h-16 rounded-2xl flex items-center justify-center border ${paleta.bgFuerte} ${paleta.border} ${paleta.text}`;
                document.getElementById('modal-evento-centrado-titulo').textContent = evento.titulo;
                document.getElementById('modal-evento-centrado-hora').textContent = horaTexto;
                document.getElementById('modal-evento-centrado-hora').className = `inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-full border ${paleta.bg} ${paleta.border} ${paleta.text}`;

                const descCentrado = document.getElementById('modal-evento-centrado-desc');
                if (evento.descripcion) {
                    descCentrado.textContent = evento.descripcion;
                    descCentrado.classList.remove('hidden');
                } else {
                    descCentrado.textContent = '';
                    descCentrado.classList.add('hidden');
                }

                centrado.classList.remove('hidden');
                listaCitas.classList.add('hidden');
            } else {
                cartel.classList.remove('hidden');
                centrado.classList.add('hidden');
                listaCitas.classList.remove('hidden');
            }
        } else {
            cartel.classList.add('hidden');
            centrado.classList.add('hidden');
            listaCitas.classList.remove('hidden');
            modalInner.className = `${clasesBaseModal} bg-gray-900 border-gray-700`;
            modalHeader.className = `${clasesBaseHeader} bg-gray-800/30 border-gray-700/50`;
            modalFooter.className = `${clasesBaseFooter} bg-gray-950/30 border-gray-800/50`;
            formEventoWrap.className = `${clasesBaseForm} border-gray-800/50`;

            document.getElementById('form-evento-titulo').value = '';
            document.getElementById('form-evento-hora').value = '';
            document.getElementById('form-evento-descripcion').value = '';
            document.getElementById('form-evento-restringe').checked = false;
            const primerColor = document.querySelector('input[name="color"]');
            if (primerColor) primerColor.checked = true;
            btnToggleFormTexto.textContent = 'Agregar evento a este día';
            document.getElementById('btn-eliminar-evento-form').classList.add('hidden');
        }

        formEventoWrap.open = false;

        const badgeInhabil = document.getElementById('badge-inhabil');
        const btnToggle = document.getElementById('btn-toggle-inhabil');
        
        if (isInhabil) {
            badgeInhabil.classList.remove('hidden');
            btnToggle.innerHTML = `
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                Habilitar Día
            `;
            btnToggle.className = 'text-xs font-bold text-emerald-500 hover:text-emerald-400 transition-colors uppercase tracking-widest py-2 flex items-center gap-1.5';
        } else {
            badgeInhabil.classList.add('hidden');
            btnToggle.innerHTML = `
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636" /></svg>
                Marcar como Inhábil
            `;
            btnToggle.className = 'text-xs font-bold text-gray-400 hover:text-red-400 transition-colors uppercase tracking-widest py-2 flex items-center gap-1.5 cursor-pointer';
        }

        const tarjetasGuardadas = document.querySelector(`#citas-store div[data-day="${day}"]`);
        
        if (tarjetasGuardadas && tarjetasGuardadas.children.length > 0) {
            listaContainer.innerHTML = tarjetasGuardadas.outerHTML;
            listaContainer.firstElementChild.classList.remove('hidden');
            listaContainer.firstElementChild.classList.add('block');
        } else {
            listaContainer.innerHTML = `
                <div class="flex flex-col items-center justify-center py-12 text-gray-500 border-2 border-dashed border-gray-800 rounded-2xl">
                    <p class="font-medium">${isInhabil ? 'Día bloqueado' : 'Sin citas programadas'}</p>
                    <p class="text-xs mt-1 opacity-60">${isInhabil ? 'No se deberían agendar citas' : 'Tiempo libre disponible'}</p>
                </div>
            `;
        }

        modal.showModal();
    }

    window.eliminarEventoModal = () => {
        if (confirm('¿Quitar el evento marcado para este día?')) {
            document.getElementById('form-eliminar-evento').requestSubmit();
        }
    }
</script>