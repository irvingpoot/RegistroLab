---
/**
 * @file nueva-cita.astro
 * @description Formulario para el registro de nuevas citas en la agenda.
 * * REGLAS DE NEGOCIO:
 * 1. Prevención de Solapamiento: Antes de crear la cita, consulta a la BD si ya existe
 * un registro activo (no cancelado) en ese mismo horario exacto.
 * 2. Manejo de Zona Horaria: Fuerza la interpretación de la fecha local del navegador
 * como UTC-6 (Mérida) al agregarle el offset manual antes de guardar en UTC.
 * 3. Auditoría Automática: Captura el nombre del usuario en sesión (`Astro.locals`)
 * para llenar el campo `registrado_por` sin intervención manual.
 * 4. Lista de espera: si llega desde /waitlist (query `nombre`, `telefono`, `sintoma`
 * y `espera`), el formulario viene prellenado y, al guardar la cita, el paciente
 * se elimina de la lista de espera (los demás turnos suben solos).
 * * UI:
 * - Implementa un modal de éxito a pantalla completa con animación SVG.
 *
 * La lógica de acceso a datos vive en: src/services/citas.service.ts
 */

import Layout from "../layouts/Layout.astro";
import ReturnButton from "../components/ReturnButton.astro";
import { clerkClient } from "@clerk/astro/server";
import { crearCita, getDiasBloqueadosDesdeHoy } from "../services/citas.service";
import DownTriangle from "../components/icons/DownTriangle.astro";
import AlertModal from "../components/AlertModal.astro";
import { eliminarDeEspera } from "../services/lista-espera.service";

const user = await Astro.locals.currentUser();
const nombreRegistrador = user
    ? `${user.firstName} ${user.lastName}`.trim() || user.username || "Usuario desconocido"
    : "Anónimo";

const fechaParam  = Astro.url.searchParams.get("fecha");
const fechaDefault = fechaParam ? `${fechaParam}T09:00` : "";

const esperaId = Astro.url.searchParams.get("espera") ?? "";
const prefill = {
    nombre:   Astro.url.searchParams.get("nombre")   ?? "",
    telefono: Astro.url.searchParams.get("telefono") ?? "",
    sintoma:  Astro.url.searchParams.get("sintoma")  ?? "",
};

let listaPsicologos: string[] = [];
try {
    const client   = clerkClient(Astro);
    const response = await client.users.getUserList({ limit: 20, orderBy: "created_at" });
    const users    = Array.isArray(response) ? response : (response.data || []);

    listaPsicologos = users
        .filter(u => u.publicMetadata?.puedeAtender === true)
        .map(u => {
            const nombre = `${u.firstName || ""} ${u.lastName || ""}`.trim();
            return nombre || u.username || u.emailAddresses[0].emailAddress;
        });
} catch (e) {
    console.error("Error cargando psicólogos:", e);
}

let mensaje         = "";
let hayError        = false;
let registroExitoso = false;

if (Astro.request.method === "POST") {
    try {
        const data = await Astro.request.formData();

        await crearCita({
            nombre:          data.get("nombre")        as string,
            telefono:        data.get("telefono")       as string || null,
            sintoma:         data.get("sintoma")        as string || null,
            referencia:      data.get("referencia")     as string,
            motivo:          data.get("motivo")         as string,
            fechaLocal:      data.get("fecha_hora")     as string,
            observaciones:   data.get("observaciones")  as string || null,
            atendidoPor:     data.get("atendido_por")   as string,
            registradoPorId: nombreRegistrador as string,
            servicioId:      data.get("servicio_id")    as string || null,
            precioId:        data.get("precio_id")      as string || null,
        });

        const esperaIdPost = (data.get("espera_id") as string) || "";
        if (esperaIdPost) {
            try {
                await eliminarDeEspera(esperaIdPost);
            } catch (err) {
                console.error("No se pudo quitar al paciente de la lista de espera:", err);
            }
        }

        registroExitoso = true;

    } catch (e) {
        console.error(e);
        hayError = true;
        mensaje  = e instanceof Error ? e.message : "Ocurrió un error desconocido";
    }
}

const listaInhabiles = await getDiasBloqueadosDesdeHoy();
---

<Layout title="Agendar Nueva Cita | Lab-Somno">
    <ReturnButton
        href={esperaId ? "/waitlist" : "/citas"}
        text={esperaId ? "Volver a la Lista de espera" : "Volver a la Agenda"}
    />

    {registroExitoso && (
        <div class="fixed inset-0 bg-black/80 flex items-center justify-center z-50 backdrop-blur-sm transition-opacity duration-300 px-4">
            <div class="bg-gray-900 border border-gray-700 p-8 rounded-2xl shadow-2xl flex flex-col items-center max-w-sm w-full transform scale-100 animate-bounce-in">
                <div class="success-checkmark">
                    <div class="check-icon">
                        <span class="icon-line line-tip"></span>
                        <span class="icon-line line-long"></span>
                        <div class="icon-circle"></div>
                        <div class="icon-fix"></div>
                    </div>
                </div>
                <h2 class="text-2xl font-bold text-white mt-4 text-center">¡Agendada!</h2>
                <p class="text-gray-400 mt-2 text-center">La cita se guardó correctamente.</p>
                <script is:inline>
                    setTimeout(() => { window.location.replace("/citas"); }, 2000);
                </script>
            </div>
        </div>
    )}

    <main class="max-w-7xl mx-auto pt-6 md:pt-10 pb-28 px-4">
        <div class="flex flex-col items-center justify-center mb-8">
            <h1 class="text-4xl md:text-6xl font-extrabold text-center leading-tight">
                Agendar <span class="bg-gradient-to-r from-blue-600 via-blue-300 to-blue-800 bg-clip-text text-transparent">Cita</span>
            </h1>
        </div>

        <form
            method="POST"
            id="form-cita"
            novalidate
            data-hay-error={hayError ? "1" : undefined}
            data-mensaje-error={hayError ? mensaje : undefined}
            data-inhabiles={JSON.stringify(listaInhabiles)}
        >
            {esperaId && <input type="hidden" name="espera_id" value={esperaId} />}
            <div class="flex flex-col items-center justify-center">
                
                <h2 class="text-2xl md:text-3xl pb-2 mb-6 border-b border-white/50 text-center text-gray-200 w-fit mx-auto px-10">Datos del Paciente</h2>
                
                <div class="flex flex-col space-y-4 w-full max-w-4xl px-2 md:px-0">
                    <div class="flex flex-col md:flex-row gap-4 md:gap-7">
                        <div class="flex grow flex-col">
                            <label for="nombre" class="text-lg font-medium text-gray-300">Nombre completo <span class="text-red-500">*</span>:</label>
                            <input type="text" id="nombre" name="nombre" required value={prefill.nombre} class="mt-1 p-3 border border-gray-700 bg-gray-900/50 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-white placeholder-gray-500 transition-all">
                        </div>
                        <div class="flex grow flex-col md:w-1/3">
                            <label for="telefono" class="text-lg font-medium text-gray-300">Teléfono:</label>
                            <input type="tel" id="telefono" name="telefono" value={prefill.telefono} class="mt-1 p-3 border border-gray-700 bg-gray-900/50 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-white placeholder-gray-500 transition-all">
                        </div>
                    </div>
                    
                    <div class="flex flex-col md:flex-row gap-4 md:gap-7">
                        <div class="flex grow flex-col gap-2">
                            <label class="text-sm font-medium text-gray-300">
                                Referencia (Referido por)
                            </label>
                            <div class="relative">
                                <select 
                                    name="referencia" 
                                    required
                                    class="w-full bg-gray-900/50 border border-gray-700 text-white p-3 rounded-xl focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none appearance-none transition-all cursor-pointer"
                                >
                                    <option value="" disabled selected>Selecciona una opción</option>
                                    <option value="Servicio Medico">Servicio Médico</option>
                                    <option value="Particular">Particular</option>
                                    <option value="Protocolo">Protocolo (Tesis/Investigación)</option>
                                </select>
                                
                                <div class="absolute inset-y-0 right-0 flex items-center px-3 pointer-events-none text-gray-400">
                                    <DownTriangle class="h-4 w-4" />
                                </div>
                            </div>
                        </div>
                        <div class="flex grow flex-col">
                            <label for="sintoma" class="text-lg font-medium text-gray-300">Motivo de consulta:</label>
                            <input type="text" id="sintoma" name="sintoma" value={prefill.sintoma} class="mt-1 p-3 border border-gray-700 bg-gray-900/50 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-white transition-all">
                        </div>
                    </div>
                </div>

                <h2 class="text-2xl md:text-3xl pb-2 mb-6 mt-10 border-b border-white/50 text-center text-gray-200 w-fit mx-auto px-10">Detalles de la Cita</h2>
                
                <div class="flex flex-col space-y-6 w-full max-w-4xl px-2 md:px-0">
                    
                    <div class="flex flex-col">
                        <label class="text-lg font-medium text-gray-300 mb-2">Cita de <span class="text-red-500">*</span>:</label>
                        <div id="grupo-motivo" class="grid grid-cols-1 md:grid-cols-3 gap-4 p-4 border border-gray-700 bg-gray-900/50 rounded-xl transition-all">
                            <label class="flex items-center gap-3 cursor-pointer hover:text-blue-400 transition p-2 rounded hover:bg-white/5">
                                <input type="radio" name="motivo" value="entrevista" required class="accent-blue-500 w-5 h-5">
                                <span class="font-medium">Entrevista Inicial</span>
                            </label>
                            <label class="flex items-center gap-3 cursor-pointer hover:text-blue-400 transition p-2 rounded hover:bg-white/5">
                                <input type="radio" name="motivo" value="seguimiento" required class="accent-blue-500 w-5 h-5">
                                <span class="font-medium">Seguimiento</span>
                            </label>
                            <label class="flex items-center gap-3 cursor-pointer hover:text-blue-400 transition p-2 rounded hover:bg-white/5">
                                <input type="radio" name="motivo" value="tratamiento" required class="accent-blue-500 w-5 h-5">
                                <span class="font-medium">Tratamiento</span>
                            </label>
                            <label class="flex items-center gap-3 cursor-pointer hover:text-blue-400 transition p-2 rounded hover:bg-white/5">
                                <input type="radio" name="motivo" value="otro" required class="accent-blue-500 w-5 h-5">
                                <span class="font-medium">Otro</span>
                            </label>
                        </div>
                    </div>

                    <div class="flex flex-col md:flex-row gap-4 md:gap-7">
                        <div class="flex grow flex-col">
                            <label for="servicio_id" class="text-lg font-medium text-gray-300">Servicio <span id="servicio-obligatorio" class="text-red-500 hidden">*</span>:</label>
                            <div class="relative">
                                <select id="servicio_id" name="servicio_id" class="w-full mt-1 p-3 border border-gray-700 bg-gray-900/50 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-white appearance-none transition-all cursor-pointer disabled:cursor-not-allowed disabled:opacity-60">
                                    <option value="" disabled selected>Cargando servicios…</option>
                                </select>
                                <div class="absolute inset-y-0 right-0 flex items-center px-3 pt-1 pointer-events-none text-gray-400">
                                    <DownTriangle class="h-4 w-4" />
                                </div>
                            </div>
                        </div>
                        <div class="flex grow flex-col md:w-1/3">
                            <label for="precio_id" class="text-lg font-medium text-gray-300">Precio:</label>
                            <div class="relative">
                                <select id="precio_id" name="precio_id" disabled class="w-full mt-1 p-3 border border-gray-700 bg-gray-900/50 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-white appearance-none transition-all cursor-pointer disabled:cursor-not-allowed disabled:opacity-60">
                                    <option value="" disabled selected>Elige primero un servicio</option>
                                </select>
                                <div class="absolute inset-y-0 right-0 flex items-center px-3 pt-1 pointer-events-none text-gray-400">
                                    <DownTriangle class="h-4 w-4" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <p id="servicio-aviso" role="status" class="hidden -mt-3 text-sm text-amber-400"></p>

                    <div class="flex flex-col md:flex-row gap-4 md:gap-7">
                        <div class="flex grow flex-col">
                            <label for="atendido_por" class="text-lg font-medium text-gray-300">¿Quién atenderá? <span class="text-red-500">*</span></label>
                            <div class="relative">
                                <select id="atendido_por" name="atendido_por" required class="w-full mt-1 p-3 border border-gray-700 bg-gray-900/50 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-white appearance-none transition-all cursor-pointer">
                                    <option value="" disabled selected>Seleccionar especialista</option>
                                    {listaPsicologos.map((nombreDoc) => (
                                        <option class="bg-gray-900" value={nombreDoc}>
                                            {nombreDoc}
                                        </option>
                                    ))}
                                    <option class="bg-gray-900 text-gray-400" value="Por asignar">-- Por definir --</option>
                                </select>
                                <div class="absolute inset-y-0 right-0 flex items-center px-3 pt-1 pointer-events-none text-gray-400">
                                    <DownTriangle class="h-4 w-4" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-col md:flex-row gap-4 md:gap-7">
                        <div class="flex grow flex-col">
                            <label for="fecha_hora" class="text-lg font-medium text-gray-300">Seleccionar fecha <span class="text-red-500">*</span>:</label>
                            <input 
                                type="datetime-local" 
                                id="fecha_hora" 
                                name="fecha_hora" 
                                required 
                                value={fechaDefault}
                                class="mt-1 p-3 border border-gray-700 bg-gray-900/50 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-white transition-all cursor-pointer"
                            >
                        </div>
                    </div>

                    <div class="flex flex-col mt-4">
                        <label for="observaciones" class="text-lg font-medium text-gray-300">Observaciones:</label>
                        <textarea id="observaciones" name="observaciones" rows="3" class="mt-1 p-3 border border-gray-700 bg-gray-900/50 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 resize-y text-white transition-all"></textarea>
                    </div>
                </div>

                <div class="pt-10 pb-10 w-full max-w-4xl flex justify-end">
                    <button type="submit" class="w-full md:w-auto bg-blue-600 text-white text-lg font-semibold px-8 py-3 rounded-xl hover:bg-blue-500 hover:scale-105 transition duration-300 cursor-pointer active:scale-95 flex items-center justify-center gap-2 disabled:opacity-60 disabled:cursor-wait disabled:hover:scale-100 disabled:active:scale-100">
                        Agendar Cita
                    </button>
                </div>
                
            </div>
        </form>
    </main>

    <AlertModal />
</Layout>

<style>
    .is-error {
        border-color: rgb(239 68 68) !important;
        box-shadow: 0 0 0 3px rgb(239 68 68 / 0.25) !important;
    }

    input[type="datetime-local"]::-webkit-calendar-picker-indicator {
        filter: invert(1);
        cursor: pointer;
    }

    .success-checkmark {
        width: 80px;
        height: 115px;
        margin: 0 auto;
        
        .check-icon {
            width: 80px;
            height: 80px;
            position: relative;
            border-radius: 50%;
            box-sizing: content-box;
            border: 4px solid #4CAF50;
            
            &::before {
                top: 3px;
                left: -2px;
                width: 30px;
                transform-origin: 100% 50%;
                border-radius: 100px 0 0 100px;
            }
            
            &::after {
                top: 0;
                left: 30px;
                width: 60px;
                transform-origin: 0 50%;
                border-radius: 0 100px 100px 0;
                animation: rotate-circle 4.25s ease-in;
            }
            
            &::before, &::after {
                content: '';
                height: 100px;
                position: absolute;
                background: #111827; 
                transform: rotate(-45deg);
            }
            
            .icon-line {
                height: 5px;
                background-color: #4CAF50;
                display: block;
                border-radius: 2px;
                position: absolute;
                z-index: 10;
                
                &.line-tip {
                    top: 46px;
                    left: 14px;
                    width: 25px;
                    transform: rotate(45deg);
                    animation: icon-line-tip 0.75s;
                }
                
                &.line-long {
                    top: 38px;
                    right: 8px;
                    width: 47px;
                    transform: rotate(-45deg);
                    animation: icon-line-long 0.75s;
                }
            }
            
            .icon-circle {
                top: -4px;
                left: -4px;
                z-index: 10;
                width: 80px;
                height: 80px;
                border-radius: 50%;
                position: absolute;
                box-sizing: content-box;
                border: 4px solid rgba(76, 175, 80, .5);
            }
            
            .icon-fix {
                top: 8px;
                width: 5px;
                left: 26px;
                z-index: 1;
                height: 85px;
                position: absolute;
                transform: rotate(-45deg);
                background-color: #111827;
            }
        }
    }

    @keyframes rotate-circle {
        0% { transform: rotate(-45deg); }
        5% { transform: rotate(-45deg); }
        12% { transform: rotate(-405deg); }
        100% { transform: rotate(-405deg); }
    }

    @keyframes icon-line-tip {
        0% { width: 0; left: 1px; top: 19px; }
        54% { width: 0; left: 1px; top: 19px; }
        70% { width: 50px; left: -8px; top: 37px; }
        84% { width: 17px; left: 21px; top: 48px; }
        100% { width: 25px; left: 14px; top: 46px; }
    }

    @keyframes icon-line-long {
        0% { width: 0; right: 46px; top: 54px; }
        65% { width: 0; right: 46px; top: 54px; }
        84% { width: 55px; right: 0px; top: 35px; }
        100% { width: 47px; right: 8px; top: 38px; }
    }
</style>

<script>
    import { iniciarSelectorServicio } from "../lib/selector-servicio";

    const win = window as any;
    const form = document.getElementById("form-cita") as HTMLFormElement;
    const botonEnviar = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const textoBoton = botonEnviar.textContent?.trim() || "Agendar Cita";
    const grupoMotivo = document.getElementById("grupo-motivo")!;
    const inhabiles = new Set<string>(JSON.parse(form.dataset.inhabiles || "[]"));

    const campo = (nombre: string) =>
        form.querySelector<HTMLInputElement | HTMLSelectElement>(`[name="${nombre}"]`)!;

    const TEXTO_DIA_BLOQUEADO =
        "Este día está marcado como inhábil o tiene un evento que abarca todo el día. Por favor, selecciona otro día para la cita.";

    let catalogoCargando = true;
    iniciarSelectorServicio({
        servicio: document.getElementById("servicio_id") as HTMLSelectElement,
        precio: document.getElementById("precio_id") as HTMLSelectElement,
        aviso: document.getElementById("servicio-aviso"),
        asterisco: document.getElementById("servicio-obligatorio"),
        obligatorio: true,
        textoVacio: "Selecciona un servicio",
        forzarRecarga: form.dataset.hayError === "1",
    }).finally(() => { catalogoCargando = false; });

    const mensajeError = form.dataset.mensajeError;
    if (mensajeError) {
        const mostrar = () => void win.mostrarAlerta(mensajeError, { titulo: "No se pudo agendar", tipo: "error" });
        if (document.readyState === "complete") mostrar();
        else window.addEventListener("DOMContentLoaded", mostrar);
    }

    campo("fecha_hora").addEventListener("change", async () => {
        const input = campo("fecha_hora");
        const dia = input.value.split("T")[0];
        if (dia && inhabiles.has(dia)) {
            input.value = "";
            await win.mostrarAlerta(TEXTO_DIA_BLOQUEADO, { titulo: "Día bloqueado", tipo: "advertencia" });
            input.focus();
        }
    });

    function revisar(): { el: HTMLElement; nombre: string }[] {
        const faltan: { el: HTMLElement; nombre: string }[] = [];

        if (!campo("nombre").value.trim()) faltan.push({ el: campo("nombre"), nombre: "nombre" });
        if (!campo("referencia").value) faltan.push({ el: campo("referencia"), nombre: "referencia" });
        if (!form.querySelector('input[name="motivo"]:checked')) faltan.push({ el: grupoMotivo, nombre: "tipo de cita" });

        const servicio = campo("servicio_id");
        const precio = campo("precio_id");
        if (!servicio.disabled && !servicio.value) faltan.push({ el: servicio, nombre: "servicio" });
        else if (servicio.value && !precio.value) faltan.push({ el: precio, nombre: "precio" });

        if (!campo("atendido_por").value) faltan.push({ el: campo("atendido_por"), nombre: "quién atenderá" });

        const fecha = campo("fecha_hora").value;
        if (!fecha) faltan.push({ el: campo("fecha_hora"), nombre: "fecha y hora" });
        else if (inhabiles.has(fecha.split("T")[0])) faltan.push({ el: campo("fecha_hora"), nombre: "una fecha que no esté bloqueada" });

        return faltan;
    }

    function irA(el: HTMLElement) {
        el.scrollIntoView({ block: "center", behavior: "smooth" });
        (el.matches("input, select, textarea") ? el : el.querySelector<HTMLElement>("input"))?.focus({ preventScroll: true });
    }

    function limpiarError(e: Event) {
        const t = e.target as HTMLElement;
        t.classList.remove("is-error");
        if (t.matches('input[name="motivo"]')) grupoMotivo.classList.remove("is-error");
        if (t.id === "servicio_id") document.getElementById("precio_id")?.classList.remove("is-error");
    }
    form.addEventListener("input", limpiarError);
    form.addEventListener("change", limpiarError);

    let enProceso = false;

    window.addEventListener("pageshow", (e) => {
        if (!e.persisted) return;
        enProceso = false;
        botonEnviar.disabled = false;
        botonEnviar.textContent = textoBoton;
    });

    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (enProceso) return;
        enProceso = true;

        let enviado = false;
        try {
            if (catalogoCargando) {
                await win.mostrarAlerta("Espera un momento: todavía se están cargando los servicios y precios.", { titulo: "Cargando catálogo" });
                return;
            }

            const faltan = revisar();
            if (faltan.length) {
                faltan.forEach((f) => f.el.classList.add("is-error"));
                await win.mostrarAlerta(
                    `Completa los campos marcados en rojo: ${faltan.map((f) => f.nombre).join(", ")}.`,
                    { titulo: "Faltan datos", tipo: "advertencia" },
                );
                irA(faltan[0].el);
                return;
            }

            botonEnviar.disabled = true;
            botonEnviar.textContent = "Agendando…";
            enviado = true;
            form.submit();
        } finally {
            if (!enviado) enProceso = false;
        }
    });
</script>