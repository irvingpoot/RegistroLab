---
/**
 * @file espera.astro
 * @description Formulario PÚBLICO (sin sesión) para que un paciente se registre solo
 * en la lista de espera. Ruta: /espera
 *
 * ⚠️ Debe estar en la lista de rutas públicas del middleware de Clerk
 *    (ver instrucciones al entregar). El resto del dashboard sigue protegido.
 *
 * PROTECCIONES (todas en el servidor):
 *  1. Validación y limpieza estricta de los 3 campos (src/lib/validar-registro-espera.ts).
 *  2. Un envío = un registro: token único por apertura del formulario + UNIQUE en la BD.
 *     Aunque falle el JavaScript, un reintento o doble clic no duplica el registro.
 *  3. Honeypot: campo oculto que solo llenan los bots; si viene lleno se descarta en silencio.
 *  4. Límite por IP (8 intentos / 10 min) y tope global (30 registros / 10 min) en la BD.
 *  5. Esta página no lee ni muestra nada de la lista: solo escribe un registro.
 *  6. Cabeceras: no indexable, no embebible en iframes, sin caché.
 *  7. Todo texto del usuario se pinta escapado (Astro) o con textContent (JS).
 *
 * La lógica de acceso a datos vive en: src/services/lista-espera.service.ts
 */

import Layout from "../layouts/Layout.astro";
import CheckIcon from "../components/icons/CheckIcon.astro";
import RightArrow from "../components/icons/RightArrow.astro";
import {
    registrarDesdeFormulario,
    contarEnviosRecientesFormulario,
} from "../services/lista-espera.service";
import { validarRegistroPublico, LIMITES, type ErroresRegistro } from "../lib/validar-registro-espera";
import { permitirEnvio } from "../lib/rate-limit";

export const prerender = false;

Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
Astro.response.headers.set("X-Frame-Options", "DENY");
Astro.response.headers.set("Content-Security-Policy", "frame-ancestors 'none'");
Astro.response.headers.set("X-Content-Type-Options", "nosniff");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("Cache-Control", "no-store");

const TOPE_GLOBAL = 30;
const VENTANA_MIN = 10;
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;

let token: string = crypto.randomUUID();
let valores = { nombre: "", telefono: "", motivo: "" };
let errores: ErroresRegistro = {};
let errorGeneral = "";
const enviado = Astro.url.searchParams.get("ok") === "1";

if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();

    const tokenRecibido = String(formData.get("token") ?? "");
    if (UUID.test(tokenRecibido)) token = tokenRecibido.toLowerCase();

    if (String(formData.get("sitio_web") ?? "").trim() !== "") {
        return Astro.redirect(`${Astro.url.pathname}?ok=1`, 303);
    }

    let ip = "desconocida";
    try { ip = Astro.clientAddress; } catch { /* el adaptador no la expone */ }

    const { datos, errores: erroresValidacion } = validarRegistroPublico({
        nombre: formData.get("nombre"),
        telefono: formData.get("telefono"),
        motivo: formData.get("motivo"),
    });
    valores = datos;
    errores = erroresValidacion;

    if (!permitirEnvio(ip)) {
        errorGeneral = "Hiciste demasiados intentos. Espera unos minutos e inténtalo de nuevo.";
    } else if (Object.keys(errores).length === 0) {
        try {
            const recientes = await contarEnviosRecientesFormulario(VENTANA_MIN);
            if (recientes >= TOPE_GLOBAL) {
                errorGeneral = "Estamos recibiendo muchos registros. Inténtalo de nuevo en unos minutos.";
            } else {
                await registrarDesdeFormulario(datos, token);
                return Astro.redirect(`${Astro.url.pathname}?ok=1`, 303);
            }
        } catch (e) {
            console.error("Error en registro público de lista de espera:", e);
            errorGeneral = "No pudimos guardar tu registro. Inténtalo de nuevo en un momento.";
        }
    }
}
---

<Layout title="Registro en lista de espera | Lab-Somno">
    <div class="cielo relative isolate overflow-hidden">
        <div class="luna" aria-hidden="true"></div>
        <div class="resplandor" aria-hidden="true"></div>

        <main class="relative mx-auto max-w-6xl px-5 py-10 sm:py-14 lg:py-24">
            {enviado ? (
                <section class="entrada mx-auto flex max-w-md flex-col items-center py-16 text-center lg:py-28" role="status">
                    <span class="aro-exito grid size-20 place-items-center rounded-full border border-emerald-400/30 bg-emerald-500/10 text-emerald-300">
                        <CheckIcon class="size-9" />
                    </span>
                    <h1 class="mt-8 text-5xl leading-none tracking-tight text-white sm:text-6xl">Ya estás en la lista</h1>
                    <p class="mt-5 text-lg leading-relaxed text-gray-400">
                        El laboratorio se comunicará contigo al número que dejaste. Ya puedes cerrar esta página.
                    </p>
                </section>
            ) : (
                <div class="grid gap-10 lg:grid-cols-[1.05fr_1fr] lg:items-center lg:justify-center lg:gap-20">

                    <section class="entrada">
                        <h1 class="bg-gradient-to-b from-white via-white to-blue-300 bg-clip-text text-5xl leading-[0.95] tracking-tight text-transparent sm:text-6xl lg:text-7xl">
                            Anótate en la lista de espera
                        </h1>
                        <p class="mt-6 max-w-md text-lg leading-relaxed text-gray-400">
                            Déjanos tus datos y te avisamos en cuanto haya un espacio disponible.
                        </p>

                        <ul class="mt-12 hidden flex-col gap-5 lg:flex">
                            <li class="flex items-center gap-4">
                                <span class="chip acc-blue"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg></span>
                                <span class="text-gray-300">Toma menos de un minuto</span>
                            </li>
                            <li class="flex items-center gap-4">
                                <span class="chip acc-cyan"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"></path></svg></span>
                                <span class="text-gray-300">Te contactamos al número que dejes</span>
                            </li>
                            <li class="flex items-center gap-4">
                                <span class="chip acc-indigo"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></span>
                                <span class="text-gray-300">Tus datos son totalmente privados</span>
                            </li>
                        </ul>
                    </section>

                    <section class="entrada entrada-2">
                        <div class="rounded-3xl bg-gradient-to-b from-blue-400/40 via-white/10 to-white/5 p-px shadow-[0_24px_60px_-12px_rgba(0,0,0,0.7)]">
                            <div class="rounded-[1.45rem] bg-[#0b1120]/90 p-6 backdrop-blur-xl sm:p-9">
                                <h2 class="text-3xl leading-none text-white">Tus datos</h2>
                                <p class="mt-2 text-sm text-gray-400">Son solo tres campos.</p>

                                {errorGeneral && (
                                    <div role="alert" class="mt-6 rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-200">
                                        {errorGeneral}
                                    </div>
                                )}

                                <form method="POST" id="form-registro" novalidate class="mt-7 space-y-6" autocomplete="on">
                                    <input type="hidden" name="token" value={token} />

                                    <div aria-hidden="true" class="absolute -left-[9999px] h-0 w-0 overflow-hidden">
                                        <label>No llenar este campo
                                            <input type="text" name="sitio_web" tabindex="-1" autocomplete="off" />
                                        </label>
                                    </div>

                                    <div>
                                        <label for="nombre" class="mb-2 block text-sm font-medium text-gray-300">Nombre completo <span class="text-red-500">*</span></label>
                                        <div class="campo acc-blue">
                                            <span class="chip"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></span>
                                            <input
                                                type="text" id="nombre" name="nombre" required
                                                placeholder="Ej. Juan Pérez"
                                                minlength="2" maxlength={LIMITES.nombre}
                                                autocomplete="name" autocapitalize="words" spellcheck="false"
                                                value={valores.nombre}
                                                aria-invalid={errores.nombre ? "true" : undefined}
                                                aria-describedby={errores.nombre ? "err-nombre" : undefined}
                                            />
                                        </div>
                                        <p id="err-nombre" class="mt-2 text-sm text-red-400 empty:hidden">{errores.nombre}</p>
                                    </div>

                                    <div>
                                        <label for="telefono" class="mb-2 block text-sm font-medium text-gray-300">Número de teléfono <span class="text-red-500">*</span></label>
                                        <div class="campo acc-cyan">
                                            <span class="chip"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"></path></svg></span>
                                            <input
                                                type="tel" id="telefono" name="telefono" required
                                                placeholder="Ej. 9997285922"
                                                maxlength={LIMITES.telefono} inputmode="tel" autocomplete="tel"
                                                value={valores.telefono}
                                                aria-invalid={errores.telefono ? "true" : undefined}
                                                aria-describedby={errores.telefono ? "err-telefono" : undefined}
                                            />
                                        </div>
                                        <p id="err-telefono" class="mt-2 text-sm text-red-400 empty:hidden">{errores.telefono}</p>
                                    </div>

                                    <div>
                                        <label for="motivo" class="mb-2 block text-sm font-medium text-gray-300">Motivo de consulta <span class="text-red-500">*</span></label>
                                        <div class="campo acc-indigo">
                                            <span class="chip"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"></path></svg></span>
                                            <input
                                                type="text" id="motivo" name="motivo" required
                                                placeholder="Ej. Problemas para dormir"
                                                minlength="3" maxlength={LIMITES.motivo}
                                                autocomplete="off"
                                                value={valores.motivo}
                                                aria-invalid={errores.motivo ? "true" : undefined}
                                                aria-describedby={errores.motivo ? "ayuda-motivo err-motivo" : "ayuda-motivo"}
                                            />
                                        </div>
                                        <p id="ayuda-motivo" class="mt-2 text-xs leading-relaxed text-gray-400">
                                            Es una descripción corta: una frase o unas 3 palabras. Por ejemplo, «Problemas para dormir».
                                        </p>
                                        <p id="err-motivo" class="mt-1 text-sm text-red-400 empty:hidden">{errores.motivo}</p>
                                    </div>

                                    <button
                                        type="submit" id="btn-revisar"
                                        class="group inline-flex h-14 w-full items-center justify-center gap-2 rounded-xl bg-blue-600 text-base font-semibold text-white shadow-lg shadow-blue-600/25 transition-colors hover:bg-blue-500 cursor-pointer disabled:cursor-not-allowed disabled:opacity-60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
                                    >
                                        <span id="btn-revisar-texto">Revisar y enviar</span>
                                        <RightArrow class="size-5 transition-transform group-hover:translate-x-0.5" />
                                    </button>

                                    <p class="flex items-center justify-center gap-2 text-xs text-gray-500 lg:hidden">
                                        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                        Solo el equipo del laboratorio ve tus datos.
                                    </p>
                                </form>
                            </div>
                        </div>
                    </section>
                </div>
            )}
        </main>
    </div>

    <dialog
        id="modal-confirmar"
        aria-labelledby="confirmar-titulo"
        class="m-auto w-[calc(100%-2rem)] max-w-md rounded-3xl border border-white/10 bg-[#0b1120] p-0 text-white shadow-[0_24px_60px_-12px_rgba(0,0,0,0.8)] outline-none backdrop:bg-black/70 backdrop:backdrop-blur-sm"
    >
        <div class="p-6 sm:p-8">
            <h2 id="confirmar-titulo" class="text-3xl leading-none text-white">¿Tus datos son correctos?</h2>
            <p class="mt-2 text-sm text-gray-400">Revísalos antes de enviar.</p>

            <dl class="mt-6 divide-y divide-white/5 overflow-hidden rounded-2xl border border-white/10 bg-slate-900/50">
                <div class="flex items-start gap-3.5 px-4 py-4">
                    <span class="chip acc-blue"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></span>
                    <div class="min-w-0">
                        <dt class="text-xs text-gray-400">Nombre completo</dt>
                        <dd id="resumen-nombre" class="mt-0.5 break-words font-semibold text-white"></dd>
                    </div>
                </div>
                <div class="flex items-start gap-3.5 px-4 py-4">
                    <span class="chip acc-cyan"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"></path></svg></span>
                    <div class="min-w-0">
                        <dt class="text-xs text-gray-400">Número de teléfono</dt>
                        <dd id="resumen-telefono" class="mt-0.5 break-words font-semibold tabular-nums text-white"></dd>
                    </div>
                </div>
                <div class="flex items-start gap-3.5 px-4 py-4">
                    <span class="chip acc-indigo"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"></path></svg></span>
                    <div class="min-w-0">
                        <dt class="text-xs text-gray-400">Motivo de consulta</dt>
                        <dd id="resumen-motivo" class="mt-0.5 break-words font-semibold text-white"></dd>
                    </div>
                </div>
            </dl>

            <div class="mt-7 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
                <button type="button" id="btn-corregir" class="rounded-xl border border-white/10 px-5 py-3 text-sm text-white/70 transition-colors hover:border-white/30 hover:text-white cursor-pointer">
                    Corregir
                </button>
                <button type="button" id="btn-confirmar" class="rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-blue-600/25 transition-colors hover:bg-blue-500 cursor-pointer disabled:cursor-not-allowed disabled:opacity-60">
                    Confirmar y enviar
                </button>
            </div>
        </div>
    </dialog>
</Layout>

<style>
    .acc-blue   { --a: 59 130 246;  --t: 147 197 253; }
    .acc-cyan   { --a: 6 182 212;   --t: 103 232 249; }
    .acc-indigo { --a: 99 102 241;  --t: 165 180 252; }

    .chip {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: .75rem;
        background: rgb(var(--a) / .16);
        color: rgb(var(--t));
        transition: background-color .15s ease, color .15s ease;
    }

    .cielo::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -10;
        background-image:
            radial-gradient(1.2px 1.2px at 8% 14%,  rgb(255 255 255 / .55) 50%, transparent 51%),
            radial-gradient(1px 1px at 22% 62%,     rgb(255 255 255 / .35) 50%, transparent 51%),
            radial-gradient(1.4px 1.4px at 31% 28%, rgb(191 219 254 / .55) 50%, transparent 51%),
            radial-gradient(1px 1px at 47% 82%,     rgb(255 255 255 / .30) 50%, transparent 51%),
            radial-gradient(1.2px 1.2px at 58% 10%, rgb(255 255 255 / .45) 50%, transparent 51%),
            radial-gradient(1px 1px at 71% 48%,     rgb(191 219 254 / .40) 50%, transparent 51%),
            radial-gradient(1.4px 1.4px at 83% 72%, rgb(255 255 255 / .40) 50%, transparent 51%),
            radial-gradient(1px 1px at 93% 22%,     rgb(255 255 255 / .35) 50%, transparent 51%),
            radial-gradient(1px 1px at 14% 90%,     rgb(255 255 255 / .30) 50%, transparent 51%);
        -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 75%);
        mask-image: linear-gradient(to bottom, #000 0%, transparent 75%);
    }
    .luna {
        position: absolute;
        z-index: -10;
        top: -8rem;
        right: -7rem;
        width: 24rem;
        height: 24rem;
        border-radius: 9999px;
        background: radial-gradient(circle at 32% 30%,
            rgb(219 234 254 / .95) 0,
            rgb(147 197 253 / .55) 22%,
            rgb(59 130 246 / .22) 48%,
            transparent 70%);
        filter: blur(3px);
        opacity: .45;
    }
    .resplandor {
        position: absolute;
        z-index: -10;
        bottom: 0rem;
        left: -10rem;
        width: 30rem;
        height: 30rem;
        border-radius: 9999px;
        overflow: visible;
        background: radial-gradient(circle, rgb(99 102 241 / .22), transparent 65%);
    }
    @media (min-width: 1024px) {
        .luna { top: -9rem; right: 6%; width: 34rem; height: 34rem; opacity: .5; }
    }

    .campo { position: relative; }
    .campo .chip {
        position: absolute;
        left: .6rem;
        top: 50%;
        width: 2.25rem;
        height: 2.25rem;
        border-radius: .6rem;
        transform: translateY(-50%);
        pointer-events: none;
    }
    .campo input {
        width: 100%;
        height: 3.5rem;
        padding: 0 1rem 0 3.5rem;
        border-radius: .85rem;
        border: 1px solid rgb(255 255 255 / .1);
        background: rgb(255 255 255 / .04);
        color: #fff;
        font-size: 1rem;
        outline: none;
        transition: border-color .15s ease, background-color .15s ease, box-shadow .15s ease;
    }
    .campo input::placeholder { color: #6b7280; }
    .campo input:hover { border-color: rgb(255 255 255 / .2); }
    .campo input:focus {
        border-color: rgb(var(--a) / .75);
        background: rgb(var(--a) / .06);
        box-shadow: 0 0 0 4px rgb(var(--a) / .16);
    }
    .campo:focus-within .chip { background: rgb(var(--a)); color: #fff; }
    .campo input[aria-invalid="true"] { border-color: rgb(248 113 113 / .7); }
    .campo input:-webkit-autofill {
        -webkit-text-fill-color: #fff;
        caret-color: #fff;
        box-shadow: 0 0 0 1000px rgb(15 23 42) inset;
        border-color: rgb(var(--a) / .5);
    }

    .aro-exito { box-shadow: 0 0 0 10px rgb(16 185 129 / .08), 0 0 70px rgb(16 185 129 / .25); }

    @keyframes subir {
        from { opacity: 0; transform: translateY(14px); }
        to   { opacity: 1; transform: none; }
    }
    .entrada   { animation: subir .7s cubic-bezier(.2, .7, .2, 1) both; }
    .entrada-2 { animation-delay: .12s; }
    dialog[open] { animation: subir .25s ease-out both; }
    @media (prefers-reduced-motion: reduce) {
        .entrada, dialog[open] { animation: none; }
    }
</style>

<script>
    const form = document.getElementById("form-registro") as HTMLFormElement | null;

    if (form) {
        const dialog = document.getElementById("modal-confirmar") as HTMLDialogElement;
        const btnRevisar = document.getElementById("btn-revisar") as HTMLButtonElement;
        const textoRevisar = document.getElementById("btn-revisar-texto")!;
        const btnConfirmar = document.getElementById("btn-confirmar") as HTMLButtonElement;
        const btnCorregir = document.getElementById("btn-corregir") as HTMLButtonElement;

        const campos = {
            nombre: form.elements.namedItem("nombre") as HTMLInputElement,
            telefono: form.elements.namedItem("telefono") as HTMLInputElement,
            motivo: form.elements.namedItem("motivo") as HTMLInputElement,
        };

        let confirmado = false;
        let enviando = false;

        const normalizar = (v: string) => v.replace(/\s+/g, " ").trim();

        function marcarInvalido(el: HTMLInputElement, msg: string) {
            el.setAttribute("aria-invalid", "true");
            const err = document.getElementById("err-" + el.name);
            if (err) err.textContent = msg;
        }

        function validarEnCliente(): boolean {
            let primero: HTMLInputElement | null = null;
            for (const el of Object.values(campos)) {
                el.removeAttribute("aria-invalid");
                const err = document.getElementById("err-" + el.name);
                if (err) err.textContent = "";
            }
            const reglas: [HTMLInputElement, boolean, string][] = [
                [campos.nombre, normalizar(campos.nombre.value).length >= 2, "Escribe tu nombre completo."],
                [campos.telefono, campos.telefono.value.replace(/\D/g, "").length >= 7, "Escribe un número válido (mínimo 7 dígitos)."],
                [campos.motivo, normalizar(campos.motivo.value).length >= 3, "Cuéntanos brevemente el motivo."],
            ];
            for (const [el, ok, msg] of reglas) {
                if (!ok) { marcarInvalido(el, msg); primero ??= el; }
            }
            primero?.focus();
            return primero === null;
        }

        form.addEventListener("submit", (e) => {
            if (enviando) { e.preventDefault(); return; }

            if (!confirmado) {
                e.preventDefault();
                if (!validarEnCliente()) return;
                document.getElementById("resumen-nombre")!.textContent = normalizar(campos.nombre.value);
                document.getElementById("resumen-telefono")!.textContent = normalizar(campos.telefono.value);
                document.getElementById("resumen-motivo")!.textContent = normalizar(campos.motivo.value);
                btnConfirmar.disabled = false;
                dialog.showModal();
                return;
            }

            enviando = true;
            btnRevisar.disabled = true;
            textoRevisar.textContent = "Enviando…";
        });

        btnConfirmar.addEventListener("click", () => {
            if (enviando || confirmado) return;
            confirmado = true;
            btnConfirmar.disabled = true;
            btnConfirmar.textContent = "Enviando…";
            dialog.close();
            form.requestSubmit();
        });

        btnCorregir.addEventListener("click", () => dialog.close());
        dialog.addEventListener("click", (e) => { if (e.target === dialog) dialog.close(); });

        window.addEventListener("pageshow", (e) => {
            if (e.persisted) {
                confirmado = false;
                enviando = false;
                btnRevisar.disabled = false;
                textoRevisar.textContent = "Revisar y enviar";
                btnConfirmar.disabled = false;
                btnConfirmar.textContent = "Confirmar y enviar";
            }
        });
    }
</script>