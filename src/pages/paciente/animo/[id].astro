---
/**
 * @file [id].astro
 * @description Expediente clínico de pacientes de ESTADO DE ÁNIMO (escalas psiquiátricas).
 *
 * Esta página solo ORQUESTA; el trabajo vive en otras capas:
 *  - Acciones del POST (`action`) → services/expediente-animo.actions.ts (+ las compartidas)
 *  - Consultas a Supabase         → services/expediente-animo.service.ts y expediente.service.ts
 *  - Secciones y modales          → components/expediente/ (compartidos con sueño) y components/expediente/animo/
 *  - JavaScript de navegador      → utils/client/ (cargado por cada componente)
 *  - Constantes y formateo        → data/ y utils/
 *
 * Seguridad: valida que el ID exista; si no hay paciente, redirige a /lista.
 */

import Layout from "../../../layouts/Layout.astro";
import ReturnButton from "../../../components/ReturnButton.astro";

import ExpedienteHeader from "../../../components/expediente/ExpedienteHeader.astro";
import ExpedienteNav from "../../../components/expediente/ExpedienteNav.astro";
import SeccionSociodemografica from "../../../components/expediente/SeccionSociodemografica.astro";
import SeccionPuntajes from "../../../components/expediente/SeccionPuntajes.astro";
import SeccionTms from "../../../components/expediente/SeccionTms.astro";
import SeccionSeguimiento from "../../../components/expediente/SeccionSeguimiento.astro";
import SeccionFarmacos from "../../../components/expediente/SeccionFarmacos.astro";
import ZonaPeligro from "../../../components/expediente/ZonaPeligro.astro";
import ModalPuntajes from "../../../components/expediente/ModalPuntajes.astro";
import ModalTms from "../../../components/expediente/ModalTms.astro";
import ModalSeguimiento from "../../../components/expediente/ModalSeguimiento.astro";
import ModalEliminarPaciente from "../../../components/expediente/ModalEliminarPaciente.astro";
import ModalTextoExpandido from "../../../components/expediente/ModalTextoExpandido.astro";

import SeccionAcompanante from "../../../components/expediente/animo/SeccionAcompanante.astro";
import SeccionEspecialista from "../../../components/expediente/animo/SeccionEspecialista.astro";
import SeccionDiagnostico from "../../../components/expediente/animo/SeccionDiagnostico.astro";
import SeccionHistoriaAnimo from "../../../components/expediente/animo/SeccionHistoriaAnimo.astro";
import SeccionSintomasAnimo from "../../../components/expediente/animo/SeccionSintomasAnimo.astro";
import SeccionTrastornos from "../../../components/expediente/animo/SeccionTrastornos.astro";

import { ESCALAS_ANIMO, ETIQUETAS_ANIMO } from "../../../data/escalas-animo";
import { getMensaje } from "../../../utils/mensajes-expediente";
import { marcarCuestionariosVistos } from "../../../services/expediente.service";
import { getExpedienteAnimo } from "../../../services/expediente-animo.service";
import { procesarAccionAnimo } from "../../../services/expediente-animo.actions";

import "../../../styles/expediente.css";

const { id } = Astro.params;

if (!id) return Astro.redirect("/lista");

const user = await Astro.locals.currentUser();
const nombreAutor = user
    ? `${user.firstName} ${user.lastName}`.trim() || user.username
    : "Sistema";

let mensaje = getMensaje(Astro.url.searchParams.get("mensaje"));

if (Astro.url.searchParams.get("marcar_leido")) {
    await marcarCuestionariosVistos(id);
}

if (Astro.request.method === "POST") {
    try {
        const formData = await Astro.request.formData();
        const resultado = await procesarAccionAnimo({
            id,
            formData,
            autor: nombreAutor ?? "Sistema",
            pathname: Astro.url.pathname,
        });

        if (resultado.redirectTo) return Astro.redirect(resultado.redirectTo);
        if (resultado.mensaje) mensaje = resultado.mensaje;
    } catch (error) {
        console.error("Error en acción:", error);
    }
}

const expediente = await getExpedienteAnimo(id);

if (!expediente) return Astro.redirect("/lista");

const { paciente, sesionesTms, ultimaConfigTms, urlConsentimientoFirmado } = expediente;

const NAV_LINKS = [
    { id: "sociodemo", label: "SocioDemográficos" },
    { id: "acompa", label: "Acompañante" },
    { id: "especialista", label: "Especialista" },
    { id: "diagnostico", label: "Diagnostico" },
    { id: "historia", label: "Historia Clínica" },
    { id: "sintomas", label: "Sintomas Latentes" },
    { id: "trastorno", label: "Trastornos" },
    { id: "farmacos", label: "Farmacos" },
    { id: "puntajes", label: "Puntajes" },
    { id: "tms", label: "TMS" },
    { id: "seguimiento", label: "Seguimiento" },
];
---

<Layout title={`Expediente Ánimo: ${paciente.nombre}`}>
    <ReturnButton href="/lista" text="Volver a la lista" />

    <main class="max-w-6xl mx-auto pt-20 pb-28 px-4">
        <ExpedienteHeader
            etiqueta="Expediente de Estado de Ánimo"
            tono="animo"
            paciente={paciente}
            editarHref={`/editar-paciente/animo/${paciente.id}`}
        />

        <div class="grid grid-cols-1 gap-8">
            <ExpedienteNav links={NAV_LINKS} rootMargin="-45% 0px -60% 0px" />

            <SeccionSociodemografica paciente={paciente} sectionId="sociodemo" />
            <SeccionAcompanante paciente={paciente} />
            <SeccionEspecialista paciente={paciente} />
            <SeccionDiagnostico paciente={paciente} />
            <SeccionHistoriaAnimo paciente={paciente} />
            <SeccionSintomasAnimo paciente={paciente} />
            <SeccionTrastornos paciente={paciente} />
            <SeccionFarmacos paciente={paciente} />
            <SeccionPuntajes
                paciente={paciente}
                escalas={ESCALAS_ANIMO}
                titulo="Puntajes y Escalas"
                textoBoton="Actualizar Puntajes"
                etiquetas={ETIQUETAS_ANIMO}
                encabezado="Escala"
                espaciado="amplio"
            />
            <SeccionTms
                habilitado={paciente.tms_habilitado}
                totalSesiones={sesionesTms.length}
                urlConsentimiento={urlConsentimientoFirmado}
            />
            <SeccionSeguimiento notas={paciente.pacientes_seguimiento} />

            <ZonaPeligro />
        </div>
    </main>

    <ModalPuntajes
        paciente={paciente}
        escalas={ESCALAS_ANIMO}
        extras={paciente.pacientes_puntajes_extra}
        etiquetas={ETIQUETAS_ANIMO}
        titulo="Actualizar Puntajes"
    />
    <ModalTms nombrePaciente={paciente.nombre} sesiones={sesionesTms} ultimaConfig={ultimaConfigTms} />
    <ModalSeguimiento />
    <ModalEliminarPaciente nombre={paciente.nombre} />
    <ModalTextoExpandido />
</Layout>

<script>
    import "../../../utils/client/restaurar-scroll";
</script>