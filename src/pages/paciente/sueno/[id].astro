---
/**
 * @file [id].astro
 * @description Expediente digital de un paciente de TRASTORNOS DEL SUEÑO.
 *
 * Esta página solo ORQUESTA; el trabajo vive en otras capas:
 *  - Acciones del POST (`action`) → services/expediente-sueno.actions.ts
 *  - Consultas a Supabase         → services/expediente*.service.ts
 *  - Secciones y modales          → components/expediente/ (genéricos) y components/expediente/sueno/
 *  - JavaScript de navegador      → utils/client/ (cargado por cada componente)
 *  - Constantes y formateo        → data/ y utils/
 *
 * Seguridad: valida que el ID exista; si no hay paciente, redirige a /lista.
 */

import Layout from "../../../layouts/Layout.astro";
import ReturnButton from "../../../components/ReturnButton.astro";

import ExpedienteHeader from "../../../components/expediente/ExpedienteHeader.astro";
import ExpedienteNav from "../../../components/expediente/ExpedienteNav.astro";
import SeccionSociodemografica from "../../../components/expediente/SeccionSociodemografica.astro";
import SeccionTms from "../../../components/expediente/SeccionTms.astro";
import SeccionSeguimiento from "../../../components/expediente/SeccionSeguimiento.astro";
import ZonaPeligro from "../../../components/expediente/ZonaPeligro.astro";
import ModalPuntajes from "../../../components/expediente/ModalPuntajes.astro";
import ModalTms from "../../../components/expediente/ModalTms.astro";
import ModalSeguimiento from "../../../components/expediente/ModalSeguimiento.astro";
import ModalEliminarPaciente from "../../../components/expediente/ModalEliminarPaciente.astro";

import SeccionHistoriaClinica from "../../../components/expediente/sueno/SeccionHistoriaClinica.astro";
import SeccionSintomas from "../../../components/expediente/sueno/SeccionSintomas.astro";
import SeccionHabitos from "../../../components/expediente/sueno/SeccionHabitos.astro";
import SeccionAlteraciones from "../../../components/expediente/sueno/SeccionAlteraciones.astro";
import SeccionPuntajesSueno from "../../../components/expediente/sueno/SeccionPuntajesSueno.astro";
import SeccionReporteResultados from "../../../components/expediente/sueno/SeccionReporteResultados.astro";
import SeccionEvaluacionRemota from "../../../components/expediente/sueno/SeccionEvaluacionRemota.astro";

import { ESCALAS_SUENO } from "../../../data/escalas-sueno";
import { calcularEdad } from "../../../utils/formatters";
import { getMensaje } from "../../../utils/mensajes-expediente";
import { marcarCuestionariosVistos } from "../../../services/expediente.service";
import { getExpedienteSueno } from "../../../services/expediente-sueno.service";
import { procesarAccionSueno } from "../../../services/expediente-sueno.actions";

import "../../../styles/expediente.css";

const { id } = Astro.params;

if (!id) return Astro.redirect("/lista");

const user = await Astro.locals.currentUser();
const nombreAutor = user
    ? `${user.firstName} ${user.lastName}`.trim() || user.username
    : "Sistema";

let mensaje = getMensaje(Astro.url.searchParams.get("mensaje"));

if (Astro.url.searchParams.get("marcar_leido")) {
    await marcarCuestionariosVistos(id);
}

if (Astro.request.method === "POST") {
    try {
        const formData = await Astro.request.formData();
        const resultado = await procesarAccionSueno({
            id,
            formData,
            autor: nombreAutor ?? "Sistema",
            pathname: Astro.url.pathname,
        });

        if (resultado.redirectTo) return Astro.redirect(resultado.redirectTo);
        if (resultado.mensaje) mensaje = resultado.mensaje;
    } catch (error) {
        console.error("Error en acción:", error);
    }
}

const expediente = await getExpedienteSueno(id);

if (!expediente) return Astro.redirect("/lista");

const { paciente, reportesNoches, sesionesTms, ultimaConfigTms, urlConsentimientoFirmado } = expediente;

const edad = calcularEdad(paciente);

const NAV_LINKS = [
    { id: "datos", label: "Sociodemograficos" },
    { id: "clinica", label: "Historia" },
    { id: "sintomas", label: "Síntomas" },
    { id: "habitos", label: "Hábitos" },
    { id: "alteraciones", label: "Alteraciones" },
    { id: "puntajes", label: "Puntajes" },
    { id: "reporte-resultados", label: "Resultados" },
    { id: "tms", label: "TMS" },
    { id: "evaluacion", label: "Evaluaciones" },
    { id: "seguimiento", label: "Seguimiento" },
];
---

<Layout title={`Expediente: ${paciente.nombre}`}>
    <ReturnButton href="/lista" text="Volver a la lista" />

    <main class="max-w-6xl mx-auto pt-20 pb-28 px-4">
        <ExpedienteHeader
            etiqueta="Expediente Transtorno de sueño"
            paciente={paciente}
            editarHref={`/editar-paciente/sueno/${paciente.id}`}
        />

        <div class="grid grid-cols-1 gap-8">
            <ExpedienteNav links={NAV_LINKS} />

            <SeccionSociodemografica paciente={paciente} />
            <SeccionHistoriaClinica paciente={paciente} />
            <SeccionSintomas sintomas={paciente.pacientes_sintomas} />
            <SeccionHabitos paciente={paciente} />
            <SeccionAlteraciones alteraciones={paciente.alteracion_sueno} />
            <SeccionPuntajesSueno paciente={paciente} />
            <SeccionReporteResultados paciente={paciente} edad={edad} noches={reportesNoches} />
            <SeccionTms
                habilitado={paciente.tms_habilitado}
                totalSesiones={sesionesTms.length}
                urlConsentimiento={urlConsentimientoFirmado}
            />
            <SeccionEvaluacionRemota paciente={paciente} autor={nombreAutor ?? "Sistema"} />
            <SeccionSeguimiento notas={paciente.pacientes_seguimiento} />

            <ZonaPeligro />
        </div>
    </main>

    <ModalPuntajes
        paciente={paciente}
        escalas={ESCALAS_SUENO}
        extras={paciente.pacientes_puntajes_extra}
    />
    <ModalTms nombrePaciente={paciente.nombre} sesiones={sesionesTms} ultimaConfig={ultimaConfigTms} />
    <ModalSeguimiento />
    <ModalEliminarPaciente nombre={paciente.nombre} />
</Layout>

<script>
    import "../../../utils/client/restaurar-scroll";
</script>
