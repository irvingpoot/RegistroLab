---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ReturnButton from '../components/ReturnButton.astro';
import ReportCard from '../components/reportes/ReportCard.astro';
import PoligrafiaModal from '../components/reportes/poligrafia/PoligrafiaModal.astro';
import CitasModal from '../components/reportes/citas/CitasModal.astro';
import ExportarHabitos from '../components/reportes/habitos/ExportarHabitos.astro';

const reportesDisponibles = [
    {
        id: "reporte-poligrafia",
        titulo: "Reporte de Poligrafía",
        descripcion: "Genera el reporte clínico en Word a partir de los datos de poligrafía nocturna del paciente, con resultados, cuestionarios y recomendaciones.",
        icono: "moon",
        color: "indigo",
        tag: "Clínico",
        formato: ".docx",
    },
    {
        id: "excel-citas-pendientes",
        titulo: "Exportar Citas",
        descripcion: "Exporta citas a Excel (.xlsx): filtra solo las pendientes o descarga el historial completo con estado, síntoma, teléfono, fecha y observaciones.",
        icono: "calendar",
        color: "emerald",
        tag: "Agenda",
        formato: ".xlsx",
    },
    {
        id: "csv-habitos",
        titulo: "Cama vs Hamaca",
        descripcion: "Exportación en CSV para investigación. Cruce de variables: Lugar de sueño vs Escalas (Epworth, PSQI, Berlin).",
        icono: "chart",
        color: "rose",
        tag: "Investigación",
        formato: ".csv",
    },
] as const;
---

<Layout title="Generador de Reportes | Lab-Somno">
    <Icon />
    <ReturnButton href="/dashboard" text="Volver al dashboard" />

    <div class="min-h-screen p-4 md:p-8">
        <div class="max-w-7xl mx-auto mb-10 relative">
            <div class="absolute -top-10 -left-10 w-64 h-64 bg-purple-600/10 rounded-full blur-3xl pointer-events-none"></div>
            <h1 class="max-md:max-w-xs max-md:pt-10 max-lg:max-w-xl text-4xl md:text-6xl font-extrabold text-balance text-center">Catalogo de <span class="bg-gradient-to-r from-blue-500 via-blue-300 to-blue-600 bg-clip-text text-transparent drop-shadow-[0_0_15px_rgba(59,130,246,0.5)]">reportes</span></h1>
            <p class="pt-5 text-lg text-gray-400 text-center">
                Seleccione el tipo de documento que desea generar. Puede ajustar los parámetros de salida en el panel lateral.
            </p>
        </div>

        <div class="max-w-7xl mx-auto">
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                {reportesDisponibles.map((reporte) => <ReportCard {...reporte} />)}
            </div>
        </div>
    </div>

    <PoligrafiaModal />
    <CitasModal />
    <ExportarHabitos />
</Layout>

<style is:global>
    .acc-blue    { --a: 59 130 246;  --t: 147 197 253; }
    .acc-emerald { --a: 16 185 129;  --t: 110 231 183; }
    .acc-purple  { --a: 168 85 247;  --t: 216 180 254; }
    .acc-amber   { --a: 245 158 11;  --t: 252 211 77; }
    .acc-indigo  { --a: 99 102 241;  --t: 165 180 252; }
    .acc-rose    { --a: 244 63 94;   --t: 253 164 175; }
    .acc-gray    { --a: 156 163 175; --t: 209 213 219; }
</style>