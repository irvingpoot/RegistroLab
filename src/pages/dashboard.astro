---
/**
 * @file dashboard.astro
 * @description Panel de control principal del usuario.
 *
 * La lógica de acceso a datos vive en: src/services/dashboard.service.ts
 */

import Layout from "../layouts/Layout.astro"
import { UserButton } from "@clerk/astro/components";
import SystemUpdates from "../components/SystemUpdate.astro";
import PatientTypeModal from "../components/PatientTypeModal.astro";
import {
    getCitasHoy,
    getNotificaciones,
    getUsuariosRecientes,
    marcarTodasLeidas,
} from "../services/dashboard.service";
import {
    getTareasDeUsuario,
    completarTarea,
} from "../services/lista-pendientes.service";
import RightArrow from "../components/icons/RightArrow.astro";
import { tieneAccesoRuta, puedeGestionarUsuarios } from "../lib/permisos";
import NotificationIcon from "../components/icons/dashboard/NotificationIcon.astro";
import CalendarIcon from "../components/icons/CalendarIcon.astro";
import CheckIcon from "../components/icons/CheckIcon.astro";
import LockIcon from "../components/icons/dashboard/LockIcon.astro";
import PacientesIcon from "../components/icons/dashboard/PacientesIcon.astro";
import AddPatientIcon from "../components/icons/dashboard/AddPatientIcon.astro";
import AgendaIcon from "../components/icons/dashboard/AgendaIcon.astro";
import RightTriangle from "../components/icons/RightTriangle.astro";
import ClockIcon from "../components/icons/ClockIcon.astro";
import TaskIcon from "../components/icons/dashboard/TaskIcon.astro";
import ManualIcon from "../components/icons/dashboard/ManualIcon.astro";
import ReportIcon from "../components/icons/dashboard/ReportIcon.astro";
import UserIcon from "../components/icons/dashboard/UserIcon.astro";
import FeedbackIcon from "../components/icons/dashboard/FeedbackIcon.astro";

const esAdmin = puedeGestionarUsuarios(Astro.locals.userRole);

const userRole = Astro.locals.userRole;
const restringida = (ruta: string) => !tieneAccesoRuta(userRole, ruta);

const user          = await Astro.locals.currentUser();
const nombreUsuario = user?.firstName || user?.username || "Usuario";
const nombreCompleto = user
    ? `${user.firstName || ""} ${user.lastName || ""}`.trim() || user.username || ""
    : "";
    
const horarioVisible = user?.publicMetadata?.horarioVisible === true;


if (Astro.request.method === "POST") {
    try {
        const formData = await Astro.request.formData();
        const action   = formData.get("action");

        if (action === "mark_all_read") {
            await marcarTodasLeidas();
        }

        if (action === "completar_tarea_sidebar") {
            const idTarea = formData.get("id_tarea") as string;
            await completarTarea(idTarea, nombreCompleto as string);
        }
    } catch (e) {
        console.error("Error marcando notificaciones:", e);
    }
    return Astro.redirect(Astro.url.href);
}

const [agenda, notificaciones, usuariosRecientes, tareasUsuario] = await Promise.all([
    getCitasHoy(),
    getNotificaciones(),
    getUsuariosRecientes(Astro),
    getTareasDeUsuario(nombreCompleto as string),
]);

const { totalCitasHoy, cantidadPendientes, estadoAgenda, proximaHora, proximaNombre } = agenda;
const hayNotificaciones = notificaciones.length > 0;

const fechaHoyTexto = new Date().toLocaleDateString("es-MX", {
    timeZone: "America/Merida",
    weekday: "long", year: "numeric", month: "long", day: "numeric",
});
---

<Layout title="Dashboard | Lab-Somno">
    <main class="max-w-6xl mx-auto pt-8 pb-24 px-6">

        <header class="flex flex-col md:flex-row md:items-start justify-between gap-8 pb-5 border-b border-white/10">
            <div class="min-w-0">
                <h1 class="text-5xl md:text-7xl text-white tracking-tight leading-none flex flex-wrap items-center gap-x-5 gap-y-3">
                    <span>Hola, {nombreUsuario}</span>
                </h1>
                <p class="mt-4 text-lg text-gray-400 max-w-md">Qué bueno tenerte de vuelta. ¿Qué quieres hacer hoy?</p>
            </div>

            <div class="hidden md:flex flex-col items-end gap-3 shrink-0">
                <div class="flex items-center gap-3">
                    {usuariosRecientes.length > 0 && (
                        <div class="relative w-56 h-11 rounded-full border border-white/10 bg-slate-900/50 overflow-hidden">
                            <div class="absolute inset-y-0 left-0 w-8 bg-gradient-to-r from-[#0f0f11]/90 to-transparent z-10 pointer-events-none"></div>
                            <div class="absolute inset-y-0 right-0 w-8 bg-gradient-to-l from-[#0f0f11]/90 to-transparent z-10 pointer-events-none"></div>
                            <div class="flex items-center gap-4 h-full pr-4 animate-infinite-scroll w-max hover:[animation-play-state:paused]">
                                {usuariosRecientes.map((u) => (
                                    <div class="flex items-center gap-2 shrink-0 select-none">
                                        <div class="relative">
                                            <img src={u.imageUrl} class="size-7 rounded-full border border-white/15 bg-gray-800 object-cover" alt={u.firstName} />
                                            <span class="absolute -bottom-0.5 -right-0.5 grid place-items-center size-2.5 rounded-full bg-[#0f0f11]"><span class="size-1.5 rounded-full bg-emerald-500"></span></span>
                                        </div>
                                        <span class="text-xs font-medium text-gray-400 whitespace-nowrap">{u.firstName}</span>
                                    </div>
                                ))}
                                {usuariosRecientes.map((u) => (
                                    <div class="flex items-center gap-2 shrink-0 select-none" aria-hidden="true">
                                        <div class="relative">
                                            <img src={u.imageUrl} class="size-7 rounded-full border border-white/15 bg-gray-800 object-cover" alt={u.firstName} />
                                            <span class="absolute -bottom-0.5 -right-0.5 grid place-items-center size-2.5 rounded-full bg-[#0f0f11]"><span class="size-1.5 rounded-full bg-emerald-500"></span></span>
                                        </div>
                                        <span class="text-xs font-medium text-gray-400 whitespace-nowrap">{u.firstName}</span>
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}

                    {userRole !=="recepcion" &&(
                        <div class="relative group z-50">
                            <button
                                type="button"
                                aria-label="Actividad reciente"
                                class="relative grid place-items-center size-11 rounded-full border border-white/10 bg-slate-900/50 text-gray-400 hover:text-white hover:bg-slate-800 transition-colors focus-visible:outline-2 focus-visible:outline-blue-400"
                            >
                                <NotificationIcon class="size-5" />
                                {hayNotificaciones && (
                                    <span class="absolute top-2.5 right-3 flex size-2.5">
                                        <span class="motion-safe:animate-ping absolute inline-flex size-full rounded-full bg-red-400 opacity-75"></span>
                                        <span class="relative inline-flex size-2.5 rounded-full bg-red-500"></span>
                                    </span>
                                )}
                            </button>

                            <div class="absolute right-0 top-full pt-2 w-80 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 z-50">
                                <div class="bg-[#0f172a] border border-gray-700 rounded-xl shadow-2xl overflow-hidden">
                                    <div class="px-4 py-3 border-b border-gray-700/50 flex justify-between items-center">
                                        <div class="flex items-center gap-2">
                                            <h4 class="text-sm font-semibold text-white">Actividad</h4>
                                            {hayNotificaciones && <span class="text-[10px] bg-blue-600 text-white px-2 py-0.5 rounded-full">{notificaciones.length}</span>}
                                        </div>

                                        {hayNotificaciones && (
                                            <form method="POST">
                                                <input type="hidden" name="action" value="mark_all_read" />
                                                <button type="submit" class="text-xs font-semibold text-blue-400 hover:text-white transition-colors cursor-pointer">
                                                    Marcar todo como visto
                                                </button>
                                            </form>
                                        )}
                                    </div>
                                    <div class="max-h-64 overflow-y-auto custom-scrollbar text-left">
                                        {hayNotificaciones ? (
                                            notificaciones.map((notif) => (
                                                <a
                                                    href={`/paciente/${notif.pacientes?.tipo_paciente || 'sueno'}/${notif.pacientes?.id}?marcar_leido=${notif.id}#evaluacion`}
                                                    class="block px-4 py-3 hover:bg-white/5 border-b border-gray-800/50 last:border-0 transition-colors"
                                                >
                                                    <div class="flex justify-between items-start mb-1">
                                                        <span class="text-sm font-bold text-blue-300 capitalize">{notif.pacientes?.nombre || 'Paciente'}</span>
                                                        <span class="text-[10px] text-gray-500">{new Date(notif.updated_at).toLocaleDateString('es-MX', {day: '2-digit', month:'short'})}</span>
                                                    </div>
                                                    <p class="text-xs text-gray-300">
                                                        Respondió: <span class="font-mono text-purple-300 uppercase">{notif.cuestionario}</span>
                                                    </p>
                                                </a>
                                            ))
                                        ) : (
                                            <div class="px-4 py-6 text-center text-gray-500 text-xs italic">
                                                No hay nuevas respuestas.
                                            </div>
                                        )}
                                    </div>
                                </div>
                            </div>
                        </div>
                    )}
                </div>

                <p class="flex items-center gap-2 text-sm text-gray-400">
                    <CalendarIcon class="size-4" />
                    <span class="inline-block first-letter:uppercase">{fechaHoyTexto}</span>
                </p>

                <span class="inline-flex"><UserButton /></span>
            </div>
        </header>

        <section class="mt-8 animate-fade-in-up" aria-label="Agenda de hoy">
            {totalCitasHoy > 0 ? (
                <div class={`agenda ${estadoAgenda === 'completado' ? 'acc-emerald' : 'acc-blue'} grid gap-4 px-5 py-4 md:px-6 md:grid-cols-[1fr_auto_auto] md:items-center md:gap-8`}>

                    <div class="min-w-0">
                        <p class="flex items-center gap-2 text-sm font-semibold" style="color: rgb(var(--t))">
                            {estadoAgenda === 'pendiente' && (
                                <span class="relative flex size-2">
                                    <span class="motion-safe:animate-ping absolute inline-flex size-full rounded-full bg-red-400 opacity-75"></span>
                                    <span class="relative inline-flex size-2 rounded-full bg-red-500"></span>
                                </span>
                            )}
                            Agenda de hoy
                        </p>

                        <p class="mt-1 text-2xl md:text-[1.75rem] leading-tight text-white">
                            {estadoAgenda === 'completado'
                                ? `¡Excelente trabajo! Has atendido a tus ${totalCitasHoy} pacientes.`
                                : cantidadPendientes === 1
                                    ? `Te queda 1 paciente esperando atención.`
                                    : `Te quedan ${cantidadPendientes} pacientes por atender hoy.`
                            }
                        </p>

                        {(() => {
                            const n = Math.min(totalCitasHoy, 40);
                            const atendidas = Math.max(0, totalCitasHoy - cantidadPendientes);
                            const hechas = Math.round((atendidas / totalCitasHoy) * n);
                            return (
                                <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1.5">
                                    <div class="flex flex-wrap items-center gap-1" role="img" aria-label={`${atendidas} de ${totalCitasHoy} citas atendidas`}>
                                        {Array.from({ length: n }, (_, i) => (
                                            <span class={`tick ${i < hechas ? 'is-done' : i === hechas ? 'is-next' : ''}`}></span>
                                        ))}
                                    </div>
                                    <p class="text-xs text-gray-400 whitespace-nowrap">{atendidas} de {totalCitasHoy} atendidos</p>
                                </div>
                            );
                        })()}
                    </div>

                    <div class="md:border-l md:border-white/10 md:pl-8">
                        {estadoAgenda === 'completado' ? (
                            <p class="flex items-center gap-2 font-semibold text-emerald-300 whitespace-nowrap">
                                <CheckIcon class="size-5" />
                                Agenda completada
                            </p>
                        ) : (
                            <div>
                                <p class="text-xs text-gray-400">Siguiente cita</p>
                                <p class="text-3xl leading-none text-white whitespace-nowrap">
                                    {(() => {
                                        const texto = String(proximaHora ?? '');
                                        const m = texto.match(/^(\d{1,2}):(\d{2})/);
                                        if (!m || /[ap]\.?\s?m/i.test(texto)) return texto;
                                        const h = Number(m[1]);
                                        return `${h % 12 || 12}:${m[2]}\u00A0${h < 12 ? 'a. m.' : 'p. m.'}`;
                                    })()}
                                </p>
                                <p class="mt-1 max-w-56 truncate text-sm text-gray-300">{proximaNombre}</p>
                            </div>
                        )}
                    </div>

                    <a href="/citas" class={`group inline-flex items-center justify-center gap-1.5 rounded-lg px-4 py-2.5 text-sm font-semibold text-white transition-colors ${
                        estadoAgenda === 'completado'
                            ? 'bg-emerald-600 hover:bg-emerald-500'
                            : 'bg-blue-600 hover:bg-blue-500'
                    }`}>
                        Ver agenda
                        <RightArrow class="size-4 group-hover:translate-x-0.5 transition-transform" />
                    </a>
                </div>
            ) : (
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 rounded-2xl border border-white/10 bg-slate-900/40 px-5 py-4 md:px-6">
                    <div class="flex items-center gap-3">
                        <span class="grid place-items-center size-10 shrink-0 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400">
                            <CheckIcon class="size-5" />
                        </span>
                        <div>
                            <h2 class="text-2xl text-white leading-tight">Todo al día</h2>
                            <p class="text-sm text-gray-400">No hay citas programadas para hoy, {fechaHoyTexto}.</p>
                        </div>
                    </div>

                    <a href="/nueva-cita" class="rounded-lg border border-gray-600 bg-gray-700 px-4 py-2.5 text-center text-sm font-medium text-gray-200 hover:bg-gray-600 transition-colors">
                        Agendar Cita
                    </a>
                </div>
            )}
        </section>

        <div class="mt-6 grid gap-6 lg:grid-cols-5">

            <a
                href={restringida("/lista") ? undefined : "/lista"}
                aria-disabled={restringida("/lista") ? "true" : undefined}
                tabindex={restringida("/lista") ? -1 : undefined}
                class={`mod-feature acc-blue lg:col-span-2 ${restringida("/lista") ? "is-locked" : ""}`}
            >
                {restringida("/lista") && (<span class="mod-lock"><LockIcon class="size-3" /> Acceso restringido</span>)}
                <span class="mod-chip mod-chip-lg"><PacientesIcon class="size-6" /></span>
                <span class="mt-auto block pt-12">
                    <span class="block text-4xl leading-none text-white mb-3">Pacientes</span>
                    <span class="block max-w-xs text-gray-400 leading-relaxed mb-5">
                        Acceso directo a la base de datos completa de pacientes y expedientes clínicos.
                    </span>
                    <span class="inline-flex items-center gap-1 text-sm font-semibold" style="color: rgb(var(--t))">
                        Ver lista <span class="mod-go inline-flex"><RightArrow class="size-5" /></span>
                    </span>
                </span>
            </a>

            <section aria-labelledby="g-citas" class="panel lg:col-span-3">
                <h2 id="g-citas" class="panel-title">Pacientes y citas</h2>
                <div class="divide-y divide-white/5">
                    <button
                        type="button"
                        onclick={restringida("/lista") ? undefined : "document.getElementById('modal-tipo-paciente').showModal()"}
                        disabled={restringida("/lista")}
                        class={`mod-row acc-emerald cursor-pointer ${restringida("/lista") ? "is-locked" : ""}`}
                    >
                        <span class="mod-chip"><AddPatientIcon class="size-5" /></span>
                        <span class="min-w-0 flex-1">
                            <span class="mod-title block font-semibold text-white transition-colors">Nuevo Paciente</span>
                            <span class="block text-sm text-gray-400 leading-snug">Registrar ingreso</span>
                        </span>
                        {restringida("/lista") ? (<span class="mod-lock"><LockIcon class="size-3" /> Acceso restringido</span>) : (<RightTriangle class="mod-go size-4" />)}
                    </button>
                    <a href="/citas" class="mod-row acc-purple">
                        <span class="mod-chip"><AgendaIcon class="size-5" /></span>
                        <span class="min-w-0 flex-1">
                            <span class="mod-title block font-semibold text-white transition-colors">Agenda</span>
                            <span class="block text-sm text-gray-400 leading-snug">Visualizar calendario y citas pendientes</span>
                        </span>
                        <RightTriangle class="mod-go size-4" />
                    </a>
                    <a href="/nueva-cita" class="mod-row acc-pink">
                        <span class="mod-chip"><ClockIcon class="size-5" /></span>
                        <span class="min-w-0 flex-1">
                            <span class="mod-title block font-semibold text-white transition-colors">Agendar Cita</span>
                            <span class="block text-sm text-gray-400 leading-snug">Crear nueva cita</span>
                        </span>
                        <RightTriangle class="mod-go size-4" />
                    </a>
                </div>
            </section>
        </div>

        <div class="mt-6 grid gap-6 md:grid-cols-2 items-start">

            <section aria-labelledby="g-lab" class="panel">
                <h2 id="g-lab" class="panel-title">Laboratorio</h2>
                <div class="divide-y divide-white/5">
                    <a
                        href={restringida("/pendientes/lista-pendientes") ? undefined : "/pendientes/lista-pendientes"}
                        aria-disabled={restringida("/pendientes/lista-pendientes") ? "true" : undefined}
                        tabindex={restringida("/pendientes/lista-pendientes") ? -1 : undefined}
                        class={`mod-row acc-lime ${restringida("/pendientes/lista-pendientes") ? "is-locked" : ""}`}
                    >
                        <span class="mod-chip"><TaskIcon class="size-5" /></span>
                        <span class="min-w-0 flex-1">
                            <span class="mod-title block font-semibold text-white transition-colors">Tareas pendientes</span>
                            <span class="block text-sm text-gray-400 leading-snug">Gestionar las tareas pendientes por hacer</span>
                        </span>
                        {restringida("/pendientes/lista-pendientes") ? (<span class="mod-lock"><LockIcon class="size-3" /> Acceso restringido</span>) : (<RightTriangle class="mod-go size-4" />)}
                    </a>
                    <a
                        href={restringida("/manuales") ? undefined : "/manuales"}
                        aria-disabled={restringida("/manuales") ? "true" : undefined}
                        tabindex={restringida("/manuales") ? -1 : undefined}
                        class={`mod-row acc-cyan ${restringida("/manuales") ? "is-locked" : ""}`}
                    >
                        <span class="mod-chip"><ManualIcon class="size-5" /></span>
                        <span class="min-w-0 flex-1">
                            <span class="mod-title block font-semibold text-white transition-colors">Manuales</span>
                            <span class="block text-sm text-gray-400 leading-snug">Todos los manuales necesarios para el funcionamiento del laboratorio.</span>
                        </span>
                        {restringida("/manuales") ? (<span class="mod-lock"><LockIcon class="size-3" /> Acceso restringido</span>) : (<RightTriangle class="mod-go size-4" />)}
                    </a>
                    <a
                        href={restringida("/reportes") ? undefined : "/reportes"}
                        aria-disabled={restringida("/reportes") ? "true" : undefined}
                        tabindex={restringida("/reportes") ? -1 : undefined}
                        class={`mod-row acc-rose ${restringida("/reportes") ? "is-locked" : ""}`}
                    >
                        <span class="mod-chip"><ReportIcon class="size-5" /></span>
                        <span class="min-w-0 flex-1">
                            <span class="mod-title block font-semibold text-white transition-colors">Reportes</span>
                            <span class="block text-sm text-gray-400 leading-snug">Generación de reportes del laboratorio</span>
                        </span>
                        {restringida("/reportes") ? (<span class="mod-lock"><LockIcon class="size-3" /> Acceso restringido</span>) : (<RightTriangle class="mod-go size-4" />)}
                    </a>
                </div>
            </section>

            <section aria-labelledby="g-equipo" class="panel">
                <h2 id="g-equipo" class="panel-title">Equipo y soporte</h2>
                <div class="divide-y divide-white/5">
                    {horarioVisible && (
                        <a href="/horario" class="mod-row acc-cyan">
                            <span class="mod-chip"><ClockIcon class="size-5" /></span>
                            <span class="min-w-0 flex-1">
                                <span class="mod-title block font-semibold text-white transition-colors">Horarios</span>
                                <span class="block text-sm text-gray-400 leading-snug">Disponibilidad de todos en el laboratorio</span>
                            </span>
                            <RightTriangle class="mod-go size-4" />
                        </a>
                    )}

                    {esAdmin && (
                        <a href="/usuarios" class="mod-row acc-indigo">
                            <span class="mod-chip"><UserIcon class="size-5" /></span>
                            <span class="min-w-0 flex-1">
                                <span class="mod-title block font-semibold text-white transition-colors">Usuarios</span>
                                <span class="block text-sm text-gray-400 leading-snug">Gestionar cuentas y roles</span>
                            </span>
                            <RightTriangle class="mod-go size-4" />
                        </a>
                    )}

                    <a
                        href={restringida("/feedback") ? undefined : "/feedback"}
                        aria-disabled={restringida("/feedback") ? "true" : undefined}
                        tabindex={restringida("/feedback") ? -1 : undefined}
                        class={`mod-row acc-amber ${restringida("/feedback") ? "is-locked" : ""}`}
                    >
                        <span class="mod-chip"><FeedbackIcon class="size-5"/></span>
                        <span class="min-w-0 flex-1">
                            <span class="mod-title block font-semibold text-white transition-colors">Feedback</span>
                            <span class="block text-sm text-gray-400 leading-snug">Reporta errores, sugiere cambios o pide nuevas funciones.</span>
                        </span>
                        {restringida("/feedback") ? (<span class="mod-lock"><LockIcon class="size-3" /> Acceso restringido</span>) : (<RightTriangle class="mod-go size-4" />)}
                    </a>
                </div>
            </section>
        </div>

    </main>

    <aside id="aside-tareas" class="fixed top-1/2 -translate-y-1/2 right-0 z-50 w-7">
        <div
            id="panel-tareas"
            class="absolute top-1/2 -translate-y-1/2 right-7 w-64
                bg-gray-900/90 border border-white/10 backdrop-blur-md
                shadow-2xl shadow-black/50 rounded-2xl overflow-hidden
                translate-x-full transition-transform duration-300 ease-in-out"
        >
            <div class="flex items-center justify-between px-4 py-3 border-b border-white/5">
                <div class="flex items-center gap-2">
                    <div class="w-1.5 h-1.5 rounded-full bg-amber-400 shadow-[0_0_6px_rgba(251,191,36,0.8)]"></div>
                    <span class="text-[11px] font-bold text-gray-300 uppercase tracking-widest">Mis tareas</span>
                    {tareasUsuario.length > 0 && (
                        <span class="text-[10px] font-bold bg-amber-500/15 text-amber-400 border border-amber-500/20 px-1.5 py-0.5 rounded-full">
                            {tareasUsuario.length}
                        </span>
                    )}
                </div>
                <a href="/pendientes/lista-pendientes" class="text-[10px] font-bold text-gray-500 hover:text-blue-400 transition-colors uppercase tracking-wider">
                    Ver todas
                </a>
            </div>

            {tareasUsuario.length > 0 ? (
                <div class="flex flex-col divide-y divide-white/5 max-h-80 overflow-y-auto">
                    {tareasUsuario.map((tarea) => (
                        <div class="group flex items-center gap-3 px-4 py-3 hover:bg-white/4 transition-colors duration-150">
                            <form method="POST" class="m-0 shrink-0">
                                <input type="hidden" name="action" value="completar_tarea_sidebar" />
                                <input type="hidden" name="id_tarea" value={tarea.id} />
                                <button
                                    type="submit"
                                    title="Marcar como completada"
                                    class="w-4 h-4 rounded-full border border-gray-600 group-hover:border-emerald-500 hover:bg-emerald-500/15 flex items-center justify-center transition-all duration-150 cursor-pointer shrink-0"
                                >
                                    <CheckIcon class="w-2.5 h-2.5 text-transparent group-hover:text-emerald-400 transition-colors" />
                                </button>
                            </form>
                            <p class="text-xs text-gray-400 group-hover:text-gray-200 transition-colors leading-snug line-clamp-2 flex-1 min-w-0">
                                {tarea.titulo}
                            </p>
                        </div>
                    ))}
                </div>
            ) : (
                <div class="flex flex-col items-center justify-center gap-2 py-8 px-4 text-center">
                    <div class="w-8 h-8 rounded-full bg-emerald-500/10 border border-emerald-500/15 flex items-center justify-center">
                        <CheckIcon class="w-4 h-4 text-emerald-400" />
                    </div>
                    <p class="text-xs font-medium text-gray-500">¡Sin pendientes!</p>
                </div>
            )}

            <div class="px-4 py-3 border-t border-white/5">
                <a
                    href="/pendientes/lista-pendientes"
                    class="flex items-center justify-center gap-1.5 w-full py-2 rounded-lg bg-white/4 hover:bg-white/8 border border-white/6 hover:border-white/10 text-[11px] font-semibold text-gray-500 hover:text-gray-300 transition-all duration-150"
                >
                    Ver todas las tareas
                </a>
            </div>
        </div>
    </aside>

    <SystemUpdates />
    <PatientTypeModal />
</Layout>

