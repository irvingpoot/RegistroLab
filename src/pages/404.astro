---
/**
 * @file 404.astro
 * @description Página de error para rutas no encontradas.
 *
 * PROPÓSITO:
 * - Informar que la URL solicitada no existe.
 * - Ofrecer un retorno seguro al dashboard para que nadie quede atrapado.
 *
 * DISEÑO:
 * - Mismo lenguaje que el dashboard: tipografía grande en peso normal,
 *   azul como acento y botón primario sólido.
 * - Elemento distintivo: un trazo de señal (como en una poligrafía) que se
 *   apaga hasta quedar plano. Se dibuja una sola vez al cargar.
 */

import Layout from "../layouts/Layout.astro";
---

<Layout title="404 - Página no encontrada">
    <main class="flex min-h-screen items-center">
        <div class="mx-auto w-full max-w-3xl px-6 py-16">

            <p class="text-8xl md:text-[11rem] leading-none tracking-tight text-white" aria-hidden="true">404</p>

            <svg
                class="mt-6 block w-full h-auto"
                viewBox="0 0 800 64"
                preserveAspectRatio="xMinYMid meet"
                fill="none"
                aria-hidden="true"
            >
                <defs>
                    <linearGradient id="senal" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="800" y2="0">
                        <stop offset="0" stop-color="#60a5fa" />
                        <stop offset="0.16" stop-color="#60a5fa" />
                        <stop offset="1" stop-color="#60a5fa" stop-opacity="0.2" />
                    </linearGradient>
                </defs>
                <path
                    class="trazo"
                    pathLength="1"
                    stroke="url(#senal)"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M0 32 H24 l8 -6 l8 12 l8 -22 l8 34 l8 -30 l8 22 l8 -17 l8 12 l8 -8 l8 5 l8 -3 l8 1 H800"
                />
            </svg>

            <h1 class="mt-8 text-3xl md:text-5xl text-white tracking-tight text-balance">
                No encontramos esta página
            </h1>

            <p class="mt-4 max-w-md text-lg leading-relaxed text-gray-400">
                La dirección no existe en Lab-Somno. Puede que el enlace esté mal escrito o que la página ya no esté disponible.
            </p>

            <a
                href="/dashboard"
                class="group mt-8 inline-flex items-center justify-center gap-2 rounded-lg bg-blue-600 px-5 py-3 font-semibold text-white transition-colors hover:bg-blue-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
            >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="size-5 transition-transform group-hover:-translate-x-0.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
                </svg>
                Volver al dashboard
            </a>
        </div>
    </main>
</Layout>

<style>
    .trazo {
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        animation: dibujar 2.2s ease-out .2s forwards;
    }
    @keyframes dibujar {
        to { stroke-dashoffset: 0; }
    }
    @media (prefers-reduced-motion: reduce) {
        .trazo {
            animation: none;
            stroke-dashoffset: 0;
        }
    }
</style>