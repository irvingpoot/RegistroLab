<script define:vars={{ listaInhabiles }}>
    const $ = (id) => document.getElementById(id);

    const pagina = $("pagina");
    let servicioActual = "TMS";
    const fechasSeleccionadas = new Set();

    const hoy = new Date();
    let currentMonth = hoy.getMonth();
    let currentYear = hoy.getFullYear();
    const pad = (n) => String(n).padStart(2, "0");
    const hoyStr = `${hoy.getFullYear()}-${pad(hoy.getMonth() + 1)}-${pad(hoy.getDate())}`;

    const fmtCorto = new Intl.DateTimeFormat("es-MX", { weekday: "short", day: "numeric", month: "short" });
    const fechaDe = (iso) => {
        const [y, m, d] = iso.split("-").map(Number);
        return new Date(y, m - 1, d);
    };

    const ERROR_INPUT = ["is-error"];

    document.querySelectorAll("input, select").forEach(el => {
        el.addEventListener("input", () => el.classList.remove(...ERROR_INPUT));
        el.addEventListener("change", () => el.classList.remove(...ERROR_INPUT));
    });

    document.querySelectorAll("[data-servicio]").forEach(btn => {
        btn.addEventListener("click", () => {
            servicioActual = btn.dataset.servicio;
            document.querySelectorAll("[data-servicio]").forEach(b =>
                b.setAttribute("aria-pressed", String(b === btn))
            );
            pagina.classList.toggle("acc-blue", servicioActual === "TMS");
            pagina.classList.toggle("acc-purple", servicioActual === "NFB");
            $("resumen-servicio").textContent = servicioActual;
        });
    });

    const formatoHora = (v) =>
        new Date(`1970-01-01T${v}`).toLocaleTimeString("es-MX", { hour: "numeric", minute: "2-digit" });

    function actualizarHora() {
        const v = $("campo-hora").value;
        $("resumen-hora").textContent = v ? formatoHora(v) : "Sin definir";
    }

    function actualizarSesiones() {
        const inicio = parseInt($("campo-sesion-inicial").value);
        const n = fechasSeleccionadas.size;
        $("resumen-sesiones").textContent =
            !inicio || inicio < 1 || n === 0 ? "—" : n === 1 ? `#${inicio}` : `#${inicio} a #${inicio + n - 1}`;
    }

    function actualizarContador() {
        const n = fechasSeleccionadas.size;
        const etiqueta = n === 1 ? "cita en el lote" : "citas en el lote";

        $("contador-num").textContent = n;
        $("contador-label").textContent = etiqueta;
        $("contador-mobile").textContent = `${n} ${etiqueta}`;

        const textoFechas = n === 0 ? "Ninguna fecha seleccionada" : n === 1 ? "1 fecha seleccionada" : `${n} fechas seleccionadas`;
        $("modal-contador").textContent = textoFechas;
        $("texto-fechas-seleccionadas").textContent = n === 0 ? "Seleccionar fechas…" : textoFechas;

        const lista = $("lista-fechas");
        lista.replaceChildren();
        Array.from(fechasSeleccionadas).sort().forEach(f => {
            const chip = document.createElement("span");
            chip.className = "chip";
            chip.append(fmtCorto.format(fechaDe(f)).replace(/\./g, "").replace(",", ""));

            const quitar = document.createElement("button");
            quitar.type = "button";
            quitar.textContent = "×";
            quitar.setAttribute("aria-label", `Quitar ${f}`);
            quitar.addEventListener("click", () => {
                fechasSeleccionadas.delete(f);
                renderCalendar();
                actualizarContador();
            });
            chip.append(quitar);
            lista.append(chip);
        });
        $("fechas-vacio").classList.toggle("hidden", n > 0);

        $("btn-abrir-calendario").classList.remove(...ERROR_INPUT);
        actualizarSesiones();
    }

    function renderCalendar() {
        const grid = $("calendario-grid");
        grid.innerHTML = "";

        const firstDay = new Date(currentYear, currentMonth, 1).getDay();
        const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();

        for (let i = 0; i < firstDay; i++) {
            grid.appendChild(document.createElement("div"));
        }

        for (let i = 1; i <= daysInMonth; i++) {
            const dateStr = `${currentYear}-${pad(currentMonth + 1)}-${pad(i)}`;
            const isInhabil = listaInhabiles.includes(dateStr);
            const isSelected = fechasSeleccionadas.has(dateStr);

            const btn = document.createElement("button");
            btn.type = "button";
            btn.textContent = i;

            let clases = "dia";
            if (isInhabil) {
                clases += " dia-bloq";
                btn.disabled = true;
                btn.title = "Día bloqueado (Inhábil o Evento)";
            } else if (isSelected) {
                clases += " dia-sel";
                btn.setAttribute("aria-pressed", "true");
            } else if (dateStr === hoyStr) {
                clases += " dia-hoy";
                btn.title = "Hoy";
            }
            btn.className = clases;

            if (!isInhabil) {
                btn.onclick = () => {
                    if (fechasSeleccionadas.has(dateStr)) fechasSeleccionadas.delete(dateStr);
                    else fechasSeleccionadas.add(dateStr);
                    renderCalendar();
                    actualizarContador();
                };
            }
            grid.appendChild(btn);
        }

        const formatter = new Intl.DateTimeFormat("es-MX", { month: "long", year: "numeric" });
        $("mes-anio-label").textContent = formatter.format(new Date(currentYear, currentMonth));
    }

    $("btn-prev-month").addEventListener("click", () => {
        currentMonth--;
        if (currentMonth < 0) { currentMonth = 11; currentYear--; }
        renderCalendar();
    });

    $("btn-next-month").addEventListener("click", () => {
        currentMonth++;
        if (currentMonth > 11) { currentMonth = 0; currentYear++; }
        renderCalendar();
    });

    $("btn-abrir-calendario").addEventListener("click", () => {
        renderCalendar();
        $("modal-calendario").showModal();
    });

    $("campo-hora").addEventListener("input", actualizarHora);
    $("campo-sesion-inicial").addEventListener("input", actualizarSesiones);

    /* ── Validación: devuelve el lote listo o null (tras avisar qué falta) ── */
    async function validarYArmarLote() {
        if (fechasSeleccionadas.size === 0) {
            $("btn-abrir-calendario").classList.add(...ERROR_INPUT);
            await window.mostrarAlerta("Debes seleccionar al menos una fecha en el calendario.", { titulo: "Faltan fechas", tipo: "advertencia" });
            $("btn-abrir-calendario").focus();
            return null;
        }

        const horaSeleccionada = $("campo-hora").value;
        if (!horaSeleccionada) {
            $("campo-hora").classList.add(...ERROR_INPUT);
            await window.mostrarAlerta("Debes seleccionar una hora para las citas.", { titulo: "Falta la hora", tipo: "advertencia" });
            $("campo-hora").focus();
            return null;
        }

        let primerInvalido = null;
        ["nombre", "referencia", "motivo", "atendido_por"].forEach(idCampo => {
            const el = $(`campo-${idCampo}`);
            if (el && !el.value.trim()) {
                el.classList.add(...ERROR_INPUT);
                primerInvalido ??= el;
            }
        });

        const precioSel = $("campo-precio");
        if (precioSel.dataset.estado === "cargando") {
            await window.mostrarAlerta("Espera un momento: todavía se están cargando los precios.", { titulo: "Cargando precios" });
            return null;
        }
        if (!precioSel.disabled && !precioSel.value) {
            precioSel.classList.add(...ERROR_INPUT);
            primerInvalido ??= precioSel;
        }

        if (primerInvalido) {
            primerInvalido.scrollIntoView({ block: "center", behavior: "smooth" });
            primerInvalido.focus({ preventScroll: true });
            return null;
        }

        const getVal = (id) => $(`campo-${id}`).value.trim();
        const lote = [];

        const numInicialStr = $("campo-sesion-inicial").value;
        let numContador = numInicialStr ? parseInt(numInicialStr) : null;

        const seleccionServicio = window.seleccionServicioLote
            ? window.seleccionServicioLote()
            : { servicioId: null, precioId: null };

        Array.from(fechasSeleccionadas).sort().forEach(fecha => {
            let obsFinal = getVal("observaciones");

            if (numContador !== null) {
                const textoSesion = `Sesión #${numContador}`;
                obsFinal = obsFinal ? `${textoSesion} | ${obsFinal}` : textoSesion;
                numContador++;
            }

            lote.push({
                nombre:        getVal("nombre"),
                telefono:      getVal("telefono") || null,
                sintoma:       getVal("sintoma")  || null,
                referencia:    getVal("referencia"),
                motivo:        getVal("motivo"),
                fechaLocal:    `${fecha}T${horaSeleccionada}`,
                observaciones: obsFinal || null,
                atendidoPor:   getVal("atendido_por"),
                servicio:      servicioActual,
                servicioId:    seleccionServicio.servicioId,
                precioId:      seleccionServicio.precioId,
            });
        });

        return lote;
    }

    const formulario = $("form-masivo");
    const botonesEnviar = document.querySelectorAll('button[type="submit"]');
    let enProceso = false;

    function bloquearEnvio() {
        botonesEnviar.forEach(b => { b.disabled = true; b.textContent = "Registrando…"; });
        formulario.setAttribute("aria-busy", "true");
    }

    function liberarEnvio() {
        enProceso = false;
        botonesEnviar.forEach(b => { b.disabled = false; b.textContent = "Registrar lote"; });
        formulario.removeAttribute("aria-busy");
    }

    window.addEventListener("pageshow", e => { if (e.persisted) liberarEnvio(); });

    formulario.addEventListener("submit", async e => {
        e.preventDefault();
        if (enProceso) return;
        enProceso = true;

        let enviado = false;
        try {
            const lote = await validarYArmarLote();
            if (!lote) return;

            const n = lote.length;
            const confirmado = await window.confirmarAccion(
                `¿Registrar ${n} ${n === 1 ? "cita" : "citas"} de ${servicioActual} para ${lote[0].nombre} a las ${formatoHora($("campo-hora").value)}?`,
                { titulo: "Registrar citas", textoConfirmar: "Registrar", peligroso: false },
            );
            if (!confirmado) return;

            bloquearEnvio();
            $("lote_json").value = JSON.stringify(lote);
            enviado = true;
            formulario.submit();
        } finally {
            if (!enviado) enProceso = false;
        }
    });

</script>

<script>
    import { obtenerCatalogo, type ServicioCatalogo } from "../../lib/catalogo-servicios";

    type Codigo = "TMS" | "NFB";
    const PREFIJOS: Record<Codigo, string> = { TMS: "tms", NFB: "nfb" };

    const selectPrecio = document.getElementById("campo-precio") as HTMLSelectElement;
    const aviso = document.getElementById("precio-aviso");
    const asterisco = document.getElementById("precio-obligatorio");
    const form = document.getElementById("form-masivo");
    const moneda = new Intl.NumberFormat("es-MX", { style: "currency", currency: "MXN" });
    const normalizar = (t: string) => t.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();

    let catalogo: ServicioCatalogo[] = [];
    let catalogoCargado = false;
    let codigoActual: Codigo = "TMS";

    function servicioDe(codigo: Codigo): ServicioCatalogo | undefined {
        return catalogo.find((s) => {
            const nombre = normalizar(s.nombre);
            return nombre.startsWith(PREFIJOS[codigo]) && nombre.includes("sesion");
        });
    }

    function opcion(valor: string, texto: string, disabled = false, selected = false) {
        const op = document.createElement("option");
        op.value = valor;
        op.textContent = texto;
        op.className = "bg-gray-900";
        op.disabled = disabled;
        op.selected = selected;
        return op;
    }

    function sinPrecio(texto: string, mensaje: string) {
        selectPrecio.replaceChildren(opcion("", texto, true, true));
        selectPrecio.disabled = true;
        selectPrecio.dataset.estado = "sin-precio";
        asterisco?.classList.add("hidden");
        if (aviso) {
            aviso.textContent = mensaje;
            aviso.classList.remove("hidden");
        }
    }

    function pintarPrecios() {
        selectPrecio.classList.remove("is-error");

        if (!catalogoCargado) {
            return sinPrecio("Catálogo no disponible", "No se pudo cargar el catálogo de servicios. Recarga la página; si continúas, las citas se guardarán sin precio.");
        }

        const servicio = servicioDe(codigoActual);
        if (!servicio) {
            return sinPrecio("Sin precio en el catálogo", `No hay un servicio "${codigoActual} (Sesión)" en el catálogo. Las citas se guardarán sin precio.`);
        }

        aviso?.classList.add("hidden");
        asterisco?.classList.remove("hidden");
        selectPrecio.disabled = false;
        selectPrecio.dataset.estado = "listo";

        selectPrecio.replaceChildren();
        if (servicio.precios.length === 1) {
            const p = servicio.precios[0];
            selectPrecio.append(opcion(p.id, `${p.etiqueta} · ${p.monto === 0 ? "Sin costo" : moneda.format(p.monto)}`, false, true));
        } else {
            selectPrecio.append(opcion("", "Selecciona el precio", true, true));
            servicio.precios.forEach((p) =>
                selectPrecio.append(opcion(p.id, `${p.etiqueta} · ${p.monto === 0 ? "Sin costo" : moneda.format(p.monto)}`)),
            );
        }
    }

    (window as any).seleccionServicioLote = () => {
        const servicio = servicioDe(codigoActual);
        if (!servicio || selectPrecio.disabled || !selectPrecio.value) {
            return { servicioId: null, precioId: null };
        }
        return { servicioId: servicio.id, precioId: selectPrecio.value };
    };

    document.querySelectorAll<HTMLElement>("[data-servicio]").forEach((btn) => {
        btn.addEventListener("click", () => {
            codigoActual = btn.dataset.servicio as Codigo;
            if (catalogoCargado) pintarPrecios();
        });
    });

    (async () => {
        try {
            catalogo = await obtenerCatalogo({ forzar: (form as HTMLElement | null)?.dataset.hayError === "1" });
            catalogoCargado = true;
        } catch {
            catalogoCargado = false;
        }
        pintarPrecios();
    })();
</script>