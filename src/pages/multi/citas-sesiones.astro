---
/**
 * @file citas-masivas.astro
 * @description Registro de múltiples citas en un solo envío mediante calendario múltiple. v5
 *
 * Rediseño visual: mismo lenguaje que dashboard.astro (paneles, acentos --a/--t, títulos grandes).
 * La lógica de datos/envío no cambió: mismos IDs, mismo payload `lote_json`.
 */

import Layout from "../../layouts/Layout.astro";
import ReturnButton from "../../components/ReturnButton.astro";
import { clerkClient } from "@clerk/astro/server";
import {
    crearCitasEnLote,
    getDiasBloqueadosDesdeHoy,
    type CitaLote,
    type ResultadoLote,
} from "../../services/citas.service";
import DownTriangle from "../../components/icons/DownTriangle.astro";
import CalendarIcon from "../../components/icons/CalendarIcon.astro";
import LeftTriangle from "../../components/icons/LeftTriangle.astro";
import RightTriangle from "../../components/icons/RightTriangle.astro";
import ClockIcon from "../../components/icons/ClockIcon.astro";
import CheckIcon from "../../components/icons/CheckIcon.astro";
import PacientesIcon from "../../components/icons/dashboard/PacientesIcon.astro";
import AgendaIcon from "../../components/icons/dashboard/AgendaIcon.astro";
import ServiciosIcon from "../../components/icons/dashboard/ServiciosIcon.astro";
import ConfirmModal from "../../components/ConfirmModal.astro";
import AlertModal from "../../components/AlertModal.astro";


const user = await Astro.locals.currentUser();
const nombreRegistrador = user
    ? `${user.firstName} ${user.lastName}`.trim() || user.username || "Desconocido"
    : "Anónimo";


let listaPsicologos: string[] = [];
try {
    const client   = clerkClient(Astro);
    const response = await client.users.getUserList({ limit: 20, orderBy: "created_at" });
    const users    = Array.isArray(response) ? response : (response.data || []);
    listaPsicologos = users
        .filter(u => u.publicMetadata?.puedeAtender === true)
        .map(u => {
            const nombre = `${u.firstName || ""} ${u.lastName || ""}`.trim();
            return nombre || u.username || u.emailAddresses[0].emailAddress;
        });
} catch (e) {
    console.error("Error cargando psicólogos:", e);
}

const listaInhabiles = await getDiasBloqueadosDesdeHoy();
let resultados: ResultadoLote[] = [];
let hayRespuesta = false;
let totalExito   = 0;
let totalError   = 0;

if (Astro.request.method === "POST") {
    const data    = await Astro.request.formData();
    const payload = data.get("lote_json") as string;
    try {
        const lote: CitaLote[] = JSON.parse(payload);
        resultados   = await crearCitasEnLote(lote, nombreRegistrador);
        hayRespuesta = true;
        totalExito   = resultados.filter(r => r.exito).length;
        totalError   = resultados.filter(r => !r.exito).length;
    } catch (e) {
        hayRespuesta = true;
        resultados   = [{ index: 0, nombre: "—", exito: false, error: e instanceof Error ? e.message : "Error al procesar el lote" }];
        totalError   = 1;
    }
}

const opcionesMotivo = [
    { value: "entrevista",  label: "Entrevista Inicial" },
    { value: "seguimiento", label: "Seguimiento"        },
    { value: "tratamiento", label: "Tratamiento"        },
    { value: "otro",        label: "Otro"               },
];
const opcionesReferencia = [
    { value: "Servicio Medico", label: "Servicio Médico" },
    { value: "Particular",      label: "Particular"      },
    { value: "Protocolo",       label: "Protocolo (Tesis/Investigación)" },
];

const fechaHoyTexto = new Date().toLocaleDateString("es-MX", {
    timeZone: "America/Merida",
    weekday: "long", year: "numeric", month: "long", day: "numeric",
});
---

<Layout title="Multiples citas | Lab-Somno">
    <ReturnButton href="/citas" text="Volver a la Agenda" />

    {hayRespuesta && totalError === 0 && (
        <div class="fixed inset-0 bg-black/80 flex items-center justify-center z-50 backdrop-blur-sm px-4">
            <div class="bg-gray-900 border border-white/10 p-8 rounded-2xl shadow-2xl flex flex-col items-center max-w-sm w-full">
                <div class="success-checkmark">
                    <div class="check-icon">
                        <span class="icon-line line-tip"></span>
                        <span class="icon-line line-long"></span>
                        <div class="icon-circle"></div>
                        <div class="icon-fix"></div>
                    </div>
                </div>
                <h2 class="text-3xl text-white mt-4 text-center leading-tight">
                    ¡{totalExito} {totalExito === 1 ? "cita agendada" : "citas agendadas"}!
                </h2>
                <p class="text-gray-400 mt-2 text-center">Todas se guardaron correctamente.</p>
                <script is:inline>setTimeout(() => { window.location.replace("/citas"); }, 2500);</script>
            </div>
        </div>
    )}

    {hayRespuesta && totalError > 0 && (
        <div class="fixed inset-0 bg-black/85 flex items-center justify-center z-50 backdrop-blur-sm px-4 py-8 overflow-y-auto">
            <div class="bg-gray-900 border border-white/10 rounded-2xl shadow-2xl w-full max-w-lg p-6 my-auto">
                <h2 class="text-3xl text-white mb-1 text-center leading-tight">Resultado del lote</h2>
                <p class="text-gray-400 text-sm text-center mb-5">
                    <span class="text-emerald-400 font-semibold">{totalExito} exitosas</span>
                    &nbsp;·&nbsp;
                    <span class="text-red-400 font-semibold">{totalError} con error</span>
                </p>
                <ul class="space-y-2 max-h-72 overflow-y-auto pr-1">
                    {resultados.map(r => (
                        <li class={`flex items-start gap-3 p-3 rounded-xl border text-sm ${r.exito ? "border-emerald-500/30 bg-emerald-500/10" : "border-red-500/30 bg-red-500/10"}`}>
                            <span class={`mt-0.5 shrink-0 w-5 h-5 rounded-full flex items-center justify-center text-xs font-bold ${r.exito ? "bg-emerald-600 text-white" : "bg-red-600 text-white"}`}>
                                {r.exito ? "✓" : "✗"}
                            </span>
                            <div>
                                <p class="text-white font-medium">{r.nombre}</p>
                                {!r.exito && <p class="text-red-300 mt-0.5">{r.error}</p>}
                            </div>
                        </li>
                    ))}
                </ul>
                <div class="mt-6 flex gap-3">
                    <a href="/citas" class="flex-1 text-center bg-white/5 hover:bg-white/10 text-white font-semibold py-3 rounded-xl border border-white/10 transition-colors text-sm">Ir a la Agenda</a>
                    <button onclick="window.location.assign(window.location.pathname)" class="flex-1 bg-blue-600 hover:bg-blue-500 text-white font-semibold py-3 rounded-xl transition-colors text-sm cursor-pointer">Registrar más</button>
                </div>
            </div>
        </div>
    )}

    <main id="pagina" class="acc-blue max-w-6xl mx-auto pt-6 md:pt-10 pb-32 lg:pb-16 px-6">

        <header class="max-w-7xl mx-auto mb-5">
            <div class="absolute -top-10 -left-10 w-64 h-64 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>
            <h1 class="max-md:max-w-xs max-md:pt-10 max-lg:max-w-xl text-4xl md:text-6xl font-extrabold text-balance text-center">Agendar <span class="bg-gradient-to-r from-blue-500 via-blue-300 to-blue-600 bg-clip-text text-transparent drop-shadow-[0_0_15px_rgba(59,130,246,0.5)]">varias</span> citas</h1>
            <p class=" pt-5 text-lg text-gray-400 text-center">
                Desde aquí puedes agendar todas las citas que necesitas para un paciente
            </p>
        </header>

        <form id="form-masivo" method="POST" data-hay-error={totalError > 0 ? "1" : undefined}
            class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start animate-fade-in-up">
            <input type="hidden" name="lote_json" id="lote_json" />

            <div class="space-y-6 min-w-0">

                <section class="panel" aria-labelledby="t-servicio">
                    <div class="panel-head">
                        <span class="mod-chip"><ServiciosIcon class="size-5" /></span>
                        <div class="min-w-0">
                            <h2 id="t-servicio" class="text-xl text-white leading-tight">Servicio</h2>
                            <p class="text-sm text-gray-400">Define el tipo de sesión de todo el lote</p>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 p-5" id="selector-servicio" role="group" aria-label="Servicio de las citas">
                        <button type="button" data-servicio="TMS" id="btn-tms" aria-pressed="true" class="svc acc-blue">
                            <span class="svc-name">TMS</span>
                            <span class="svc-desc">Estimulación magnética transcraneal</span>
                        </button>
                        <button type="button" data-servicio="NFB" id="btn-nfb" aria-pressed="false" class="svc acc-purple">
                            <span class="svc-name">NFB</span>
                            <span class="svc-desc">Neurofeedback</span>
                        </button>
                    </div>
                </section>

                <section class="panel" aria-labelledby="t-paciente">
                    <div class="panel-head">
                        <span class="mod-chip"><PacientesIcon class="size-5" /></span>
                        <div class="min-w-0">
                            <h2 id="t-paciente" class="text-xl text-white leading-tight">Paciente</h2>
                            <p class="text-sm text-gray-400">Quién recibirá las sesiones</p>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 p-5">
                        <div class="md:col-span-2">
                            <label for="campo-nombre" class="lbl">Nombre completo <span class="text-red-400">*</span></label>
                            <input type="text" id="campo-nombre" placeholder="Ej. María González López" class="field" />
                        </div>

                        <div>
                            <label for="campo-telefono" class="lbl">Teléfono</label>
                            <input type="tel" id="campo-telefono" placeholder="10 dígitos" class="field" />
                        </div>

                        <div>
                            <label for="campo-referencia" class="lbl">Referencia <span class="text-red-400">*</span></label>
                            <div class="relative">
                                <select id="campo-referencia" class="field">
                                    <option value="" disabled selected>Seleccionar…</option>
                                    {opcionesReferencia.map(o => <option value={o.value}>{o.label}</option>)}
                                </select>
                                <div class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-gray-400">
                                    <DownTriangle class="h-4 w-4" />
                                </div>
                            </div>
                        </div>

                        <div class="md:col-span-2">
                            <label for="campo-sintoma" class="lbl">Motivo de consulta</label>
                            <input type="text" id="campo-sintoma" placeholder="Ej. Ansiedad, insomnio…" class="field" />
                        </div>
                    </div>
                </section>

                <section class="panel" aria-labelledby="t-detalles">
                    <div class="panel-head">
                        <span class="mod-chip"><AgendaIcon class="size-5" /></span>
                        <div class="min-w-0">
                            <h2 id="t-detalles" class="text-xl text-white leading-tight">Detalles de las citas</h2>
                            <p class="text-sm text-gray-400">Se aplican igual a cada fecha del lote</p>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 p-5">
                        <div>
                            <label for="campo-motivo" class="lbl">Tipo de cita <span class="text-red-400">*</span></label>
                            <div class="relative">
                                <select id="campo-motivo" class="field">
                                    <option value="" disabled selected>Seleccionar…</option>
                                    {opcionesMotivo.map(o => <option value={o.value}>{o.label}</option>)}
                                </select>
                                <div class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-gray-400">
                                    <DownTriangle class="h-4 w-4" />
                                </div>
                            </div>
                        </div>

                        <div>
                            <label for="campo-atendido_por" class="lbl">¿Quién atenderá? <span class="text-red-400">*</span></label>
                            <div class="relative">
                                <select id="campo-atendido_por" class="field">
                                    <option value="" disabled selected>¿Quién atenderá?</option>
                                    {listaPsicologos.map(n => <option value={n}>{n}</option>)}
                                    <option value="Por asignar">— Por definir —</option>
                                </select>
                                <div class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-gray-400">
                                    <DownTriangle class="h-4 w-4" />
                                </div>
                            </div>
                        </div>

                        <div>
                            <label for="campo-sesion-inicial" class="lbl">Número de sesión inicial</label>
                            <input type="number" id="campo-sesion-inicial" min="1" placeholder="Ej. 1, 4 (opcional)" class="field" />
                        </div>

                        <div>
                            <label for="campo-precio" class="lbl">Precio de la sesión <span id="precio-obligatorio" class="text-red-400 hidden">*</span></label>
                            <div class="relative">
                                <select id="campo-precio" data-estado="cargando" disabled class="field">
                                    <option value="" disabled selected>Cargando precios…</option>
                                </select>
                                <div class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-gray-400">
                                    <DownTriangle class="h-4 w-4" />
                                </div>
                            </div>
                            <p id="precio-aviso" role="status" class="hidden mt-1.5 text-xs text-amber-400"></p>
                        </div>

                        <div class="md:col-span-2">
                            <label for="campo-observaciones" class="lbl">Observaciones</label>
                            <input type="text" id="campo-observaciones" placeholder="Opcional" class="field" />
                        </div>
                    </div>
                </section>

                <section class="panel" aria-labelledby="t-fechas">
                    <div class="panel-head">
                        <span class="mod-chip"><ClockIcon class="size-5" /></span>
                        <div class="min-w-0">
                            <h2 id="t-fechas" class="text-xl text-white leading-tight">Fechas y hora</h2>
                            <p class="text-sm text-gray-400">Elige los días; la hora es la misma para todas</p>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-[1.5fr_1fr] gap-5 p-5 md:items-end">
                        <div>
                            <label class="lbl">Fechas <span class="text-red-400">*</span></label>
                            <button type="button" id="btn-abrir-calendario" class="pick">
                                <span class="mod-chip"><CalendarIcon class="size-5" /></span>
                                <span class="min-w-0 flex-1 text-left">
                                    <span id="texto-fechas-seleccionadas" class="block font-semibold text-white leading-tight">Seleccionar fechas…</span>
                                    <span class="block text-xs text-gray-400 mt-0.5">Abre el calendario y marca los días</span>
                                </span>
                                <RightTriangle class="mod-go size-4" />
                            </button>
                        </div>

                        <div>
                            <label for="campo-hora" class="lbl">Hora <span class="text-red-400">*</span></label>
                            <input type="time" id="campo-hora" class="field h-14 cursor-pointer" />
                        </div>
                    </div>
                </section>
            </div>

            <aside class="lg:sticky lg:top-6" aria-label="Resumen del lote">
                <div class="panel">
                    <div class="panel-head">
                        <span class="mod-chip"><CheckIcon class="size-5" /></span>
                        <div class="min-w-0">
                            <h2 class="text-xl text-white leading-tight">Resumen del lote</h2>
                            <p class="text-sm text-gray-400">Así quedará tu registro</p>
                        </div>
                    </div>

                    <div class="p-5">
                        <div class="flex items-end gap-3">
                            <span id="contador-num" class="text-7xl leading-none text-white tabular-nums">0</span>
                            <span id="contador-label" class="pb-1.5 text-gray-400">citas en el lote</span>
                        </div>

                        <dl class="mt-5 text-sm divide-y divide-white/10 border-y border-white/10">
                            <div class="flex items-center justify-between gap-4 py-2.5">
                                <dt class="text-gray-400">Servicio</dt>
                                <dd id="resumen-servicio" class="font-semibold" style="color: rgb(var(--t))">TMS</dd>
                            </div>
                            <div class="flex items-center justify-between gap-4 py-2.5">
                                <dt class="text-gray-400">Hora</dt>
                                <dd id="resumen-hora" class="text-white">Sin definir</dd>
                            </div>
                            <div class="flex items-center justify-between gap-4 py-2.5">
                                <dt class="text-gray-400">Sesiones</dt>
                                <dd id="resumen-sesiones" class="text-white">—</dd>
                            </div>
                        </dl>

                        <div id="lista-fechas" class="mt-4 flex flex-wrap gap-2"></div>
                        <p id="fechas-vacio" class="mt-4 text-sm text-gray-500">Aún no hay fechas. Ábrelas desde el calendario.</p>

                        <div class="hidden lg:block mt-6">
                            <button type="submit" class="btn-primary">Registrar lote</button>
                        </div>
                    </div>
                </div>
            </aside>
        </form>

        <dialog id="modal-calendario" class="cal">
            <div class="p-5">
                <div class="flex justify-between items-center mb-4">
                    <button type="button" id="btn-prev-month" aria-label="Mes anterior" class="nav-btn">
                        <LeftTriangle class="w-5 h-5" />
                    </button>
                    <h3 id="mes-anio-label" class="text-2xl text-white capitalize leading-none">Mes Año</h3>
                    <button type="button" id="btn-next-month" aria-label="Mes siguiente" class="nav-btn">
                        <RightTriangle class="w-5 h-5" />
                    </button>
                </div>

                <div class="grid grid-cols-7 gap-1 text-center mb-2">
                    <span class="text-xs font-semibold text-gray-500">Do</span>
                    <span class="text-xs font-semibold text-gray-500">Lu</span>
                    <span class="text-xs font-semibold text-gray-500">Ma</span>
                    <span class="text-xs font-semibold text-gray-500">Mi</span>
                    <span class="text-xs font-semibold text-gray-500">Ju</span>
                    <span class="text-xs font-semibold text-gray-500">Vi</span>
                    <span class="text-xs font-semibold text-gray-500">Sá</span>
                </div>

                <div id="calendario-grid" class="grid grid-cols-7 gap-1"></div>

                <div class="mt-4 flex items-center gap-4 text-xs text-gray-400">
                    <span class="flex items-center gap-1.5"><span class="leyenda leyenda-sel"></span>Seleccionado</span>
                    <span class="flex items-center gap-1.5"><span class="leyenda leyenda-bloq"></span>Bloqueado</span>
                </div>

                <div class="mt-5 pt-4 border-t border-white/10 flex items-center justify-between gap-4">
                    <p id="modal-contador" class="text-sm text-gray-400">Ninguna fecha seleccionada</p>
                    <button type="button" onclick="document.getElementById('modal-calendario').close()" class="btn-primary compact">
                        Listo
                    </button>
                </div>
            </div>
        </dialog>
        <div class="fixed inset-x-0 bottom-0 z-40 flex lg:hidden items-center justify-between gap-4 border-t border-white/10 bg-[#0f0f11]/85 backdrop-blur-md px-6 pt-3 pb-[max(.75rem,env(safe-area-inset-bottom))]">
            <p id="contador-mobile" class="text-sm text-gray-300">0 citas en el lote</p>
            <button type="submit" form="form-masivo" class="btn-primary compact">Registrar lote</button>
        </div>
    </main>


    <ConfirmModal />
    <AlertModal />
</Layout>

<style>
    .acc-blue   { --a: 59 130 246;  --t: 147 197 253; }
    .acc-purple { --a: 168 85 247;  --t: 216 180 254; }

    .panel {
        border: 1px solid rgb(255 255 255 / .1);
        background: rgb(15 23 42 / .4);
        border-radius: 1rem;
        overflow: hidden;
    }
    .panel-head {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid rgb(255 255 255 / .1);
    }
    .mod-chip {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: .75rem;
        background: rgb(var(--a) / .16);
        color: rgb(var(--t));
        transition: background-color .2s ease, color .2s ease;
    }
    .mod-go {
        flex-shrink: 0;
        color: #6b7280;
        transition: transform .2s ease, color .15s ease;
    }

    .lbl {
        display: block;
        margin-bottom: .4rem;
        font-size: .875rem;
        font-weight: 500;
        color: #d1d5db;
    }
    .field {
        display: block;
        width: 100%;
        padding: .75rem .9rem;
        font-size: .9375rem;
        color: #fff;
        background: rgb(2 6 23 / .45);
        border: 1px solid rgb(255 255 255 / .1);
        border-radius: .75rem;
        transition: border-color .15s ease, box-shadow .15s ease, background-color .15s ease;
    }
    .field::placeholder { color: #6b7280; }
    .field:hover:not(:disabled) { border-color: rgb(255 255 255 / .22); }
    .field:focus {
        outline: none;
        border-color: rgb(var(--a) / .75);
        background: rgb(2 6 23 / .65);
        box-shadow: 0 0 0 3px rgb(var(--a) / .2);
    }
    .field:disabled { opacity: .6; cursor: not-allowed; }
    select.field { appearance: none; padding-right: 2.5rem; cursor: pointer; }
    .field option { background: #0f172a; color: #fff; }
    .field.is-error,
    .pick.is-error {
        border-color: rgb(239 68 68);
        box-shadow: 0 0 0 3px rgb(239 68 68 / .25);
    }
    input[type="time"]::-webkit-calendar-picker-indicator {
        filter: invert(.6);
        cursor: pointer;
    }

    .svc {
        position: relative;
        text-align: left;
        padding: 1.1rem 1.25rem 1.2rem;
        border-radius: 1rem;
        border: 1px solid rgb(255 255 255 / .1);
        background: rgb(255 255 255 / .02);
        cursor: pointer;
        transition: border-color .2s ease, background-color .2s ease;
    }
    .svc::after {
        content: "";
        position: absolute;
        top: 1.1rem;
        right: 1.1rem;
        width: 1.1rem;
        height: 1.1rem;
        border-radius: 9999px;
        border: 1.5px solid rgb(255 255 255 / .25);
        transition: border-color .2s ease, background .2s ease;
    }
    .svc-name {
        display: block;
        font-size: 2.25rem;
        line-height: 1;
        letter-spacing: -.01em;
        color: #9ca3af;
        transition: color .2s ease;
    }
    .svc-desc {
        display: block;
        margin-top: .6rem;
        font-size: .875rem;
        line-height: 1.35;
        color: #6b7280;
    }
    .svc:hover { border-color: rgb(var(--a) / .4); }
    .svc[aria-pressed="true"] {
        border-color: rgb(var(--a) / .6);
        background: rgb(var(--a) / .1);
    }
    .svc[aria-pressed="true"]::after {
        border-color: rgb(var(--t));
        background: radial-gradient(circle, rgb(var(--t)) 0 38%, transparent 42%);
    }
    .svc[aria-pressed="true"] .svc-name { color: #fff; }
    .svc[aria-pressed="true"] .svc-desc { color: rgb(var(--t)); }

    .pick {
        display: flex;
        align-items: center;
        gap: .9rem;
        width: 100%;
        min-height: 3.5rem;
        padding: .5rem 1rem .5rem .5rem;
        border-radius: .75rem;
