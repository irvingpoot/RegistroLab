---

/**
 * @file index.astro
 * @description Página de aterrizaje (Landing Page) y Login.
 * * AUTENTICACIÓN (Clerk):
 * - Actúa como el "Gatekeeper" de la aplicación.
 * - Utiliza componentes de `@clerk/astro` para gestionar el estado de sesión.
 * * ESTADOS:
 * 1. No Autenticado (`<SignIn />`): Muestra el formulario de inicio de sesión de Clerk.
 * 2. Autenticado (`<SignedIn />`): Muestra un mensaje de transición ("Redirigiendo...").
 */

import Layout from '../layouts/Layout.astro';
import {
	SignedIn,
	SignIn
} from '@clerk/astro/components';
---

<Layout title="Lab-Somno">
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />

	<div class="relative isolate min-h-screen overflow-hidden">

		<div class="bg-glow pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

		<div class="bg-trace pointer-events-none absolute inset-x-0 bottom-14 -z-10 h-40 lg:bottom-[12vh] lg:h-[36%]" aria-hidden="true">
			<ul class="absolute inset-y-0 left-8 w-14 text-[11px] text-gray-600 md:left-12">
				<li style="top: 10%">Vigilia</li>
				<li style="top: 30%">REM</li>
				<li style="top: 50%">N1</li>
				<li style="top: 70%">N2</li>
				<li style="top: 90%">N3</li>
			</ul>
			<div class="absolute inset-y-0 left-24 right-0 md:left-28">
				<svg class="brand-svg block size-full" viewBox="0 0 800 320" preserveAspectRatio="none">
				<g class="grid-lines">
					<line x1="0" y1="32" x2="800" y2="32" />
					<line x1="0" y1="96" x2="800" y2="96" />
					<line x1="0" y1="160" x2="800" y2="160" />
					<line x1="0" y1="224" x2="800" y2="224" />
					<line x1="0" y1="288" x2="800" y2="288" />
				</g>
				<path
					class="trace"
					d="M0 32 H50 V160 H90 V224 H150 V288 H230 V224 H280 V160 H320 V96 H390 V160 H430 V224 H500 V288 H560 V224 H610 V96 H680 V160 H720 V96 H770 V32 H800"
				/>
			</svg>
			</div>
		</div>

		<div class="grid min-h-screen lg:grid-cols-[1.15fr_1fr]">

			<section class="relative flex flex-col justify-start p-8 pt-12 md:p-12 md:pt-14 lg:justify-center lg:p-16 lg:pb-[42vh]">
				<h1 class="font-display text-6xl leading-[.95] tracking-tight text-white md:text-7xl xl:text-8xl">
					Laboratorio<br />del Sueño
				</h1>
				<p class="mt-6 max-w-sm text-lg leading-relaxed text-gray-400">
					Te damos la bienvenida al registro de pacientes
				</p>
			</section>

			<main class="flex min-h-[32rem] flex-col lg:min-h-screen">
				<div class="flex flex-1 items-center justify-center px-6 pb-52 pt-12 lg:pb-12">
					<div class="login-slot flex w-full max-w-md justify-center">
						<SignIn />
					</div>
				</div>

				<footer class="px-6 pb-7 text-end">
					<h3 class="text-xs text-gray-500">
						&copy; {new Date().getFullYear()} Laboratorio del sueño
					</h3>
				</footer>
			</main>
		</div>
	</div>

	<SignedIn>
		<div
			class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-[#02060f]/97 px-6 backdrop-blur-md"
			role="status"
			aria-live="polite"
		>
			<div class="load w-72 md:w-96" aria-hidden="true">
				<svg class="load-svg block w-full" viewBox="0 0 320 90" preserveAspectRatio="none">
					<g class="grid-lines">
						<line x1="0" y1="10" x2="320" y2="10" />
						<line x1="0" y1="35" x2="320" y2="35" />
						<line x1="0" y1="60" x2="320" y2="60" />
						<line x1="0" y1="85" x2="320" y2="85" />
					</g>
					<path
						class="trace"
						d="M0 10 H24 V60 H48 V85 H86 V60 H108 V35 H140 V60 H162 V85 H196 V60 H222 V35 H252 V10 H278 V35 H296 V10 H320"
					/>
				</svg>
			</div>

			<h2 class="font-display mt-8 text-4xl text-white md:text-5xl">
				Iniciando sesión
			</h2>

			<p class="mt-3 text-sm text-gray-400 motion-safe:animate-pulse">
				Accediendo al sistema…
			</p>
		</div>
	</SignedIn>
</Layout>

<style>
	.bg-glow {
		background:
			radial-gradient(52rem 38rem at 14% 26%, rgb(59 130 246 / .16), transparent 70%),
			radial-gradient(40rem 30rem at 0% 100%, rgb(59 130 246 / .08), transparent 70%);
	}

	.bg-trace {
		-webkit-mask-image: linear-gradient(to right, #000 0%, #000 38%, transparent 90%);
		mask-image: linear-gradient(to right, #000 0%, #000 38%, transparent 90%);
	}
	.bg-trace li {
		position: absolute;
		transform: translateY(-50%);
		white-space: nowrap;
	}

	.grid-lines line {
		stroke: rgb(255 255 255 / .07);
		stroke-width: 1;
		vector-effect: non-scaling-stroke;
	}
	.trace {
		fill: none;
		stroke: rgb(147 197 253 / .8);
		stroke-width: 2;
		stroke-linejoin: miter;
		vector-effect: non-scaling-stroke;
	}

	.brand-svg { animation: reveal 5s .4s cubic-bezier(.4, 0, .2, 1) both; }

	.load-svg { animation: scan 2.6s cubic-bezier(.4, 0, .2, 1) infinite; }

	@keyframes reveal {
		from { clip-path: inset(0 100% 0 0); }
		to   { clip-path: inset(0 0 0 0); }
	}
	@keyframes scan {
		0%   { clip-path: inset(0 100% 0 0); opacity: 1; }
		70%  { clip-path: inset(0 0 0 0);    opacity: 1; }
		90%  { clip-path: inset(0 0 0 0);    opacity: 1; }
		100% { clip-path: inset(0 0 0 0);    opacity: 0; }
	}
	@media (prefers-reduced-motion: reduce) {
		.brand-svg, .load-svg { animation: none; }
	}

	.login-slot :global(.cl-rootBox) {
		width: 100%;
		display: flex;
		justify-content: center;
	}
	.login-slot :global(.cl-cardBox) {
		max-width: 100%;
		border: 1px solid rgb(255 255 255 / .1);
		border-radius: 1rem;
		box-shadow: 0 25px 50px -12px rgb(0 0 0 / .6);
	}
</style>